<UserControl x:Class="ElansAddonHub.Lodge.LodgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub.Lodge"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <UserControl.Resources>
    <!-- small round avatar with role ring, speaking ring and status badge -->
    <DataTemplate x:Key="AvatarSmall">
      <Grid Width="22" Height="22">
        <Ellipse Fill="{Binding Color}" />
        <Ellipse Fill="{Binding IconBrush}" />
        <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="#111315" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse Stroke="{Binding FrameBrush}" StrokeThickness="1.5" Margin="-2" />
        <Ellipse Stroke="{Binding Ring}" StrokeThickness="2" Margin="-4.5" />
        <Border Width="13" Height="13" CornerRadius="6.5" Background="{Binding StatusBrush}" BorderBrush="{StaticResource Surface}" BorderThickness="1.5"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" Visibility="{Binding StatusVisibility}">
          <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource Icons}" FontSize="7" Foreground="#111315" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <!-- appear offline: a grey hollow dot -->
        <Border Width="13" Height="13" CornerRadius="6.5" Background="{StaticResource Surface}" BorderBrush="#8A9199" BorderThickness="2.5"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" Visibility="{Binding InvisibleVisibility}" />
      </Grid>
    </DataTemplate>

    <!-- the hover card of a person: avatar, name, rank / level, place, state, status, voice - a few short lines -->
    <DataTemplate x:Key="MemberCard">
      <StackPanel MinWidth="210" MaxWidth="300">
        <DockPanel>
          <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Margin="12,0,0,0" Background="{Binding FrameBrush}" VerticalAlignment="Center">
            <TextBlock Text="{Binding RoleLabel}" FontSize="9.5" FontWeight="Bold" Foreground="#111315" />
          </Border>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{Binding CardNameText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{Binding ClassBrushOrText}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Text="{Binding CardClassLine}" Visibility="{Binding CardClassVisibility}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding CardStateVisibility}" Margin="0,3,0,0">
          <Image Source="{Binding StateIcon}" Width="13" Height="13" Margin="0,0,5,0" Visibility="{Binding StateIconVisibility}" VerticalAlignment="Center" />
          <TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#E6B85C" Margin="0,0,5,0" VerticalAlignment="Center"
                     Visibility="{Binding AfkVisibility}" />
          <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding CardPlaceLine}" Visibility="{Binding CardPlaceVisibility}" FontSize="12" Foreground="{StaticResource TextDim}"
                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding CardStatusLine}" Visibility="{Binding CardStatusVisibility}" FontSize="11" Foreground="{StaticResource TextDim}"
                   Opacity="0.8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding CardVoiceVisibility}" Margin="0,6,0,0">
          <TextBlock Text="{Binding StateGlyph}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{Binding StateBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CardVoiceLine}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- a person row in the sidebar (voice rooms and online list): name, a dim second line (place / XP / note), small state icons -->
    <DataTemplate x:Key="PersonRow">
      <Border Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" Tag="{Binding}"
              MouseLeftButtonUp="Member_Click" MouseRightButtonUp="Member_Click">
        <Border.ToolTip>
          <ToolTip Style="{StaticResource CardTip}" ContentTemplate="{StaticResource MemberCard}" Content="{Binding}" />
        </Border.ToolTip>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding StateGlyph}" FontFamily="{StaticResource Icons}" FontSize="11"
                     Foreground="{Binding StateBrush}" VerticalAlignment="Center" Visibility="{Binding StateVisibility}" />
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Accent}"
                     VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding PlayingVisibility}" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding GameLine}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ClassBrush}"
                     VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding GameVisibility}" />
          <Image DockPanel.Dock="Right" Source="{Binding StateIcon}" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding StateIconVisibility}" />
          <TextBlock DockPanel.Dock="Right" Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="#E6B85C" Margin="0,0,5,0"
                     VerticalAlignment="Center" Visibility="{Binding AfkVisibility}" />
          <StackPanel Margin="10,0,6,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="12.5" Opacity="{Binding NameOpacity}" Foreground="{Binding ClassBrushOrText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SecondLine}" Visibility="{Binding SecondVisibility}" FontSize="10.5" Foreground="{StaticResource TextDim}"
                       Opacity="{Binding NameOpacity}" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- ===================== join ===================== -->
    <ScrollViewer x:Name="JoinPanel" VerticalScrollBarVisibility="Auto">
      <Border Margin="16,30,12,12" Padding="22" Background="{StaticResource Card}" CornerRadius="12" MaxWidth="460"
              BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="JoinTitle" Text="Join a lodge" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="Chat, voice and files with your friends. Paste the invite link you were sent." FontSize="12"
                     Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,16" />
          <TextBlock Text="INVITE LINK OR ADDRESS" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <TextBox x:Name="UrlBox" Style="{StaticResource Input}" Tag="https://example.com/lodge#invite=..." TextChanged="UrlBox_TextChanged" />
          <StackPanel x:Name="CodeArea">
            <TextBlock x:Name="CodeCaption" Text="INVITE CODE" Style="{StaticResource Caption}" Margin="0,12,0,5" />
            <PasswordBox x:Name="CodeBox" Style="{StaticResource SecretInput}" KeyDown="CodeBox_KeyDown" />
          </StackPanel>
          <TextBlock x:Name="CodeFromLink" Text="Invite code found in the link" FontSize="11.5" Foreground="{StaticResource Accent}"
                     Margin="2,6,0,0" Visibility="Collapsed" />
          <TextBlock Text="NAME  (only used with a shared guest code)" Style="{StaticResource Caption}" Margin="0,12,0,5" />
          <TextBox x:Name="NameBox" Style="{StaticResource Input}" Tag="Your name" />
          <Button x:Name="JoinButton" Style="{StaticResource PrimaryButton}" Content="Join" Margin="0,18,0,0" Click="Join_Click" />
          <Button x:Name="CancelEditButton" Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,8,0,0"
                  Visibility="Collapsed" Click="CancelEdit_Click" />
          <TextBlock x:Name="JoinStatus" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="2,10,0,0" />
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ===================== lodge ===================== -->
    <Grid x:Name="ChatPanel" Visibility="Collapsed" Margin="14,2,12,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== sidebar ===== -->
      <Border x:Name="SidebarBox" Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="14,12,10,6">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,1,7,0" />
              <TextBlock x:Name="LodgeTitle" Text="Lodge" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource TextDim}" Margin="15,1,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,0,4,6">
            <StackPanel>
              <TextBlock Text="TEXT CHANNELS" Style="{StaticResource Caption}" Margin="8,6,0,4" />
              <ItemsControl x:Name="TextList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding RowBrush}" CornerRadius="6" Padding="8,5" Margin="0,1" Cursor="Hand" Tag="{Binding}"
                            MouseLeftButtonUp="Channel_Click" x:Name="row">
                      <DockPanel>
                        <!-- @ badge: someone mentioned me here -->
                        <Border DockPanel.Dock="Right" Background="{StaticResource Danger}" CornerRadius="8" Padding="6,0" MinWidth="18"
                                Visibility="{Binding MentionVisibility}" VerticalAlignment="Center" ToolTip="You were mentioned">
                          <TextBlock Text="{Binding MentionText}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <!-- unread count -->
                        <Border DockPanel.Dock="Right" Background="#33FFFFFF" CornerRadius="8" Padding="6,0" MinWidth="18"
                                Visibility="{Binding UnreadVisibility}" VerticalAlignment="Center" ToolTip="Unread messages">
                          <TextBlock Text="{Binding UnreadText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="#" FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,-2,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LockText}" DockPanel.Dock="Right" FontSize="9.5" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center" Margin="4,0,4,0" Visibility="{Binding LockVisibility}" />
                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontWeight="{Binding NameWeight}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceHi}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="VOICE ROOMS" Style="{StaticResource Caption}" Margin="8,14,0,4" />
              <ItemsControl x:Name="RoomList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Border CornerRadius="6" Padding="8,5" Margin="0,1" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Room_Click"
                              x:Name="row" Background="Transparent" ToolTip="Click to join">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                          <TextBlock DockPanel.Dock="Right" Text="{Binding LockText}" FontSize="9.5" Foreground="{StaticResource TextDim}"
                                     VerticalAlignment="Center" Margin="4,0,6,0" Visibility="{Binding LockVisibility}" />
                          <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource TextDim}"
                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                      <TextBlock Text="Joining voice shows you in the room" FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                 Margin="30,-2,6,3" Visibility="{Binding InvisibleHintVisibility}" />
                      <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource PersonRow}" Margin="18,0,0,2" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceHi}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="OnlineCaption" Text="ONLINE" Style="{StaticResource Caption}" Margin="8,14,0,4" />
              <ItemsControl x:Name="OnlineList" ItemTemplate="{StaticResource PersonRow}" />
            </StackPanel>
          </ScrollViewer>

          <!-- in voice -->
          <Border x:Name="VoiceBar" Grid.Row="2" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,8,8,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="MuteToggle" Style="{StaticResource IconToggle}" Width="30" Height="30" Content="&#xE720;" Click="MuteDeaf_Click" ToolTip="Mute" />
                <ToggleButton x:Name="DeafToggle" Style="{StaticResource IconToggle}" Width="30" Height="30" Content="&#xE7F6;" Margin="4,0,0,0" Click="MuteDeaf_Click" ToolTip="Deafen" />
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE778;" Foreground="{StaticResource Danger}" Margin="2,0,0,0"
                        Click="LeaveVoice_Click" ToolTip="Leave voice" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Voice connected" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="VoiceRoomText" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- me -->
          <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8,6,8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE713;" FontSize="13"
                      Click="Settings_Click" ToolTip="Settings" />
              <Border x:Name="MeRow" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Me_Click" ToolTip="Set your status" CornerRadius="6" Padding="2">
                <DockPanel>
                  <ContentPresenter x:Name="MeAvatar" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Center" />
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MeName" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeStatus" FontSize="10.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ===== chat ===== -->
      <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,11">
            <DockPanel>
              <!-- pinned messages (only when the server supports pins) -->
              <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="Auto" MinWidth="30" Height="26" Padding="9,0"
                      Margin="8,-3,-4,-3" Click="PinButton_Click" ToolTip="Pinned messages" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock x:Name="PinCount" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock x:Name="ChatNote" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Gold}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="260" />
              <TextBlock Text="#" FontSize="17" Foreground="{StaticResource TextDim}" Margin="0,-2,8,0" VerticalAlignment="Center" />
              <TextBlock x:Name="ChannelTitle" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <Grid Grid.Row="1">
          <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" ScrollChanged="MessageScroll_Changed">
            <StackPanel Margin="0,4,0,8">
              <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,30,0,0" />
              <ItemsControl x:Name="Messages">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <!-- "New messages" line, above the first message I haven't read -->
                      <Grid Visibility="{Binding DividerVisibility}" Margin="12,12,12,2">
                        <Border Height="1" Background="{StaticResource Danger}" Opacity="0.55" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right" Background="{StaticResource Danger}" CornerRadius="8" Padding="7,1" Margin="0,0,0,0">
                          <TextBlock Text="NEW" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                        </Border>
                      </Grid>
                      <Border x:Name="row" Background="{Binding RowBackground}" BorderBrush="{Binding MentionBar}" BorderThickness="2,0,0,0"
                              Padding="12,2,12,3" Margin="{Binding RowMargin}" PreviewMouseRightButtonUp="Message_RightClick">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>

                          <!-- the quoted message: a curved connector into the avatar and one dim line -->
                          <Border Grid.Row="0" Grid.Column="0" Visibility="{Binding ReplyVisibility}" Margin="16,9,3,-3"
                                  BorderBrush="{StaticResource TextDim}" Opacity="0.55" BorderThickness="2,2,0,0" CornerRadius="7,0,0,0" />
                          <TextBlock Grid.Row="0" Grid.Column="1" Visibility="{Binding ReplyVisibility}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource TextDim}" Margin="0,2,60,2" Cursor="Hand" Tag="{Binding}"
                                     MouseLeftButtonUp="ReplyQuote_Click" ToolTip="Jump to the original message">
                            <Run Text="{Binding ReplyFrom, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding ReplyColor, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ReplyText, Mode=OneWay}" />
                          </TextBlock>

                          <Grid Grid.Row="1" Width="34" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding AvatarVisibility}">
                            <Ellipse Fill="{Binding Color}" />
                            <TextBlock Text="{Binding Initial}" Foreground="#111315" FontSize="14.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Grid>
                          <StackPanel Grid.Row="1" Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderVisibility}">
                              <TextBlock Text="{Binding From}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Color}" ToolTipOpening="NameTip_Opening">
                                <TextBlock.ToolTip>
                                  <ToolTip Style="{StaticResource CardTip}" ContentTemplate="{StaticResource MemberCard}" Content="{Binding Author}" />
                                </TextBlock.ToolTip>
                              </TextBlock>
                              <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="8,2,0,0" />
                            </StackPanel>
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" FontSize="13" Padding="0" Margin="0,1,0,0" SelectionBrush="{StaticResource Accent}"
                                     Visibility="{Binding TextVisibility}" ContextMenu="{x:Null}" />
                            <TextBlock Text="(edited)" FontSize="10.5" Foreground="{StaticResource TextDim}" Visibility="{Binding EditedVisibility}" />
                            <StackPanel Visibility="{Binding FileVisibility}" Margin="0,5,0,2">
                              <Border Visibility="{Binding File.ImageVisibility}" CornerRadius="8" HorizontalAlignment="Left" Cursor="Hand"
                                      MouseLeftButtonUp="Image_Click" Tag="{Binding File}" ClipToBounds="True">
                                <Image Source="{Binding File.Image}" MaxHeight="240" MaxWidth="360" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                              </Border>
                              <Border Visibility="{Binding File.CardVisibility}" Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="10,8"
                                      HorizontalAlignment="Left" MinWidth="230" MaxWidth="360" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <DockPanel>
                                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE896;" Click="Download_Click"
                                          Tag="{Binding File}" ToolTip="Save to Downloads" />
                                  <TextBlock DockPanel.Dock="Left" Text="&#xE7C3;" FontFamily="{StaticResource Icons}" FontSize="20"
                                             Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding File.Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="{Binding File.SizeText}" FontSize="11" Foreground="{StaticResource TextDim}" />
                                      <TextBlock Text="{Binding File.Status}" FontSize="11" Foreground="{StaticResource Accent}" Margin="8,0,0,0" />
                                    </StackPanel>
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                            </StackPanel>
                            <!-- reactions: pills with counts, mine highlighted, click toggles -->
                            <ItemsControl ItemsSource="{Binding Reactions}" Visibility="{Binding ReactionsVisibility}" Margin="0,4,0,1">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Background="{Binding Fill}" BorderBrush="{Binding Line}" BorderThickness="1" CornerRadius="10" Padding="7,1,8,1"
                                          Margin="0,0,5,3" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Tip}" MouseLeftButtonUp="Reaction_Click">
                                    <StackPanel Orientation="Horizontal">
                                      <Image Source="{Binding Icon}" Width="17" Height="17" VerticalAlignment="Center" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                      <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="12.5" VerticalAlignment="Center" Visibility="{Binding TextVisibility}" />
                                      <TextBlock Text="{Binding Count}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <TextBlock Grid.Row="1" Grid.Column="1" Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{StaticResource Gold}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,2,0" Visibility="{Binding PinnedVisibility}" ToolTip="Pinned" />

                          <!-- hover tools: Reply, React, Pin, More -->
                          <Border x:Name="tools" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,0,0"
                                  Visibility="Collapsed" Background="{StaticResource SurfaceHi}" CornerRadius="9" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35" /></Border.Effect>
                            <StackPanel Orientation="Horizontal">
                              <Button Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="12" Content="&#xE97A;" ToolTip="Reply"
                                      Tag="{Binding}" Click="Reply_Click" />
                              <Button Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="12" Content="&#xE899;" ToolTip="Add reaction"
                                      Tag="{Binding}" Click="React_Click" Visibility="{Binding ReactToolVisibility}" />
                              <Button Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="12" Content="&#xE718;" ToolTip="Pin / unpin"
                                      Tag="{Binding}" Click="PinTool_Click" Visibility="{Binding PinToolVisibility}" />
                              <Button Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="12" Content="&#xE712;" ToolTip="More"
                                      Tag="{Binding}" Click="More_Click" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Border>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="tools" Property="Visibility" Value="Visible" />
                        <Setter TargetName="row" Property="Background" Value="#0DFFFFFF" />
                      </Trigger>
                      <DataTrigger Binding="{Binding ForceTools}" Value="True">
                        <Setter TargetName="tools" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- floating: Jump to first unread / Jump to present -->
          <Button x:Name="JumpButton" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Visibility="Collapsed" Click="Jump_Click" Cursor="Hand"
                  FocusVisualStyle="{x:Null}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="#F01E2226" BorderBrush="{StaticResource AccentDark}" BorderThickness="1" CornerRadius="14" Padding="13,5">
                  <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" /></Border.Effect>
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#F02A3036" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="JumpGlyph" Text="&#xE74B;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock x:Name="JumpText" Text="Jump to present" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- while dragging files over the chat -->
          <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="#D90F1113" CornerRadius="0,0,0,0" Margin="6">
            <Grid>
              <Rectangle Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="5 4" RadiusX="12" RadiusY="12" Opacity="0.8" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="DropGlyph" Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropText" Text="Drop to share" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropSub" Text="Pictures and files go to this channel" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          </Grid>

          <TextBlock x:Name="TypingText" Grid.Row="2" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="16,2,0,2" Height="16" />

          <!-- replying / editing -->
          <Border x:Name="ModeBar" Grid.Row="3" Visibility="Collapsed" Margin="12,0,12,0" Padding="12,6,6,6" Background="{StaticResource SurfaceHi}"
                  CornerRadius="9,9,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE711;"
                      Click="CancelMode_Click" ToolTip="Cancel (Esc)" />
              <TextBlock x:Name="ModeText" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>

          <Border Grid.Row="4" Margin="12,0,12,12" Background="{StaticResource SurfaceHi}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
            <DockPanel>
              <Button x:Name="AttachButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE723;" Click="Attach_Click"
                      ToolTip="Share a file (or drop it here, or paste with Ctrl+V)" />
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE724;" Foreground="{StaticResource Accent}" Click="Send_Click" ToolTip="Send (Enter)" />
              <Grid>
                <TextBlock x:Name="ComposerHint" Foreground="{StaticResource TextDim}" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False" />
                <TextBox x:Name="Composer" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                         FontSize="13" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center" Padding="2,7" SelectionBrush="{StaticResource Accent}"
                         PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- message menu (More button / right click) -->
    <Popup x:Name="MsgMenu" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True" PopupAnimation="Fade">
      <Border x:Name="MsgMenuBox" Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="5" Width="196" Margin="0,0,12,12">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" /></Border.Effect>
        <StackPanel>
          <Button x:Name="MenuReply" Style="{StaticResource MenuRow}" Click="MenuReply_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE97A;" FontFamily="{StaticResource Icons}" FontSize="12.5" Width="24" Foreground="{StaticResource TextDim}" /><TextBlock Text="Reply" /></StackPanel>
          </Button>
          <Button x:Name="MenuReact" Style="{StaticResource MenuRow}" Click="MenuReact_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE899;" FontFamily="{StaticResource Icons}" FontSize="12.5" Width="24" Foreground="{StaticResource TextDim}" /><TextBlock Text="Add reaction" /></StackPanel>
          </Button>
          <Button x:Name="MenuPin" Style="{StaticResource MenuRow}" Click="MenuPin_Click">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="MenuPinGlyph" Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="12.5" Width="24" Foreground="{StaticResource TextDim}" /><TextBlock x:Name="MenuPinText" Text="Pin message" /></StackPanel>
          </Button>
          <Button x:Name="MenuCopy" Style="{StaticResource MenuRow}" Click="MenuCopy_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="12.5" Width="24" Foreground="{StaticResource TextDim}" /><TextBlock Text="Copy text" /></StackPanel>
          </Button>
          <Button x:Name="MenuEdit" Style="{StaticResource MenuRow}" Click="MenuEdit_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="{StaticResource Icons}" FontSize="12.5" Width="24" Foreground="{StaticResource TextDim}" /><TextBlock Text="Edit" /></StackPanel>
          </Button>
          <Button x:Name="MenuDelete" Style="{StaticResource MenuRow}" Click="MenuDelete_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12.5" Width="24" Foreground="{StaticResource Danger}" /><TextBlock Text="Delete" Foreground="{StaticResource Danger}" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- reaction picker: the eight (2.4) or six (2.3) the server allows, 4 per row -->
    <Popup x:Name="ReactPopup" StaysOpen="False" Placement="Left" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-4">
      <Border x:Name="ReactPickerBox" Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="4" Margin="0,0,10,10">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" /></Border.Effect>
        <ItemsControl x:Name="ReactItems">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource IconButton}" Width="40" Height="40" Margin="1" Tag="{Binding Id}" ToolTip="{Binding Name}" Click="ReactPick_Click">
                <Grid>
                  <Image Source="{Binding Icon}" Width="28" Height="28" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="{Binding Id}" FontFamily="Segoe UI Emoji" FontSize="17" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding TextVisibility}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Popup>

    <!-- pinned messages of this channel -->
    <Popup x:Name="PinPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
      <Border x:Name="PinBox" Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="6" Width="340" Margin="0,0,14,14">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" /></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="PinTitle" Text="PINNED MESSAGES" Style="{StaticResource Caption}" Margin="8,5,0,5" />
          <TextBlock x:Name="PinEmpty" Text="Nothing pinned yet. Officers can pin from a message's menu." FontSize="12" Foreground="{StaticResource TextDim}"
                     TextWrapping="Wrap" Margin="8,2,8,8" />
          <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PinList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="pr" Background="Transparent" CornerRadius="8" Padding="8,6,6,6" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="PinRow_Click">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE77A;" ToolTip="Unpin"
                              VerticalAlignment="Top" Tag="{Binding}" Click="PinRemove_Click" Visibility="{Binding UnpinVisibility}" />
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding By}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding Color}" />
                          <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="8,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Shown}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,2,6,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="pr" Property="IsMouseOver" Value="True">
                      <Setter TargetName="pr" Property="Background" Value="{StaticResource Line}" />
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>

    <!-- status picker -->
    <Popup x:Name="StatusPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
      <Border x:Name="StatusBox" Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="6" Width="250">
        <StackPanel>
          <TextBlock Text="SET YOUR STATUS" Style="{StaticResource Caption}" Margin="8,4,0,4" />
          <Button Style="{StaticResource MenuRow}" Tag="online" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#ABD473" Margin="1,0,11,0" VerticalAlignment="Center" /><TextBlock Text="Online" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="away" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" Foreground="#E6B85C" FontSize="13" Width="24" /><TextBlock Text="AFK" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="busy" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE738;" FontFamily="{StaticResource Icons}" Foreground="#E06C6C" FontSize="13" FontWeight="Bold" Width="24" /><TextBlock Text="Busy" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="dungeon" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" Foreground="#B48CE0" FontSize="13" Width="24" /><TextBlock Text="In a dungeon" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="lfg" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" Foreground="#6CB4E0" FontSize="13" Width="24" /><TextBlock Text="Looking for group" /></StackPanel>
          </Button>
          <Border Height="1" Background="{StaticResource Line}" Margin="8,5,8,3" />
          <Button Style="{StaticResource MenuRow}" Tag="invisible" Click="StatusOption_Click" ToolTip="Stay connected, but nobody sees you online">
            <DockPanel>
              <TextBlock x:Name="InvisibleCheck" DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Accent}" FontSize="12"
                         VerticalAlignment="Center" Visibility="Collapsed" />
              <Ellipse Width="12" Height="12" Stroke="#8A9199" StrokeThickness="2.5" Margin="1,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="Appear offline" />
            </DockPanel>
          </Button>
          <TextBox x:Name="NoteBox" Style="{StaticResource Input}" Tag="What are you up to? (optional)" Margin="2,8,2,2" MaxLength="40" KeyDown="NoteBox_KeyDown" />
          <TextBlock Text="Enter saves the note" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="6,3,0,2" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- person: volume, officer tools -->
    <Popup x:Name="MemberPopup" StaysOpen="False" Placement="Right" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="6">
      <Border Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Width="230">
        <StackPanel>
          <TextBlock x:Name="PopName" FontSize="14" FontWeight="SemiBold" />
          <TextBlock x:Name="PopRole" FontSize="11.5" Margin="0,1,0,0" />
          <TextBlock x:Name="PopStatus" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
          <TextBlock x:Name="PopGame" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
          <StackPanel x:Name="PopVolumeArea" Margin="0,12,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" x:Name="PopVolumeText" FontSize="11" Foreground="{StaticResource TextDim}" />
              <TextBlock Text="Volume" FontSize="12" />
            </DockPanel>
            <Slider x:Name="PopVolume" Minimum="0" Maximum="2" Margin="0,6,0,0" ValueChanged="PopVolume_Changed" />
          </StackPanel>
          <StackPanel x:Name="PopModArea" Margin="-8,10,0,0">
            <Button x:Name="PopMute" Style="{StaticResource MenuRow}" Click="PopMute_Click" />
            <Button Style="{StaticResource MenuRow}" Click="PopKick_Click">
              <TextBlock Text="Kick from the lodge" Foreground="{StaticResource Danger}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- in-app picture viewer (covers the whole Lodge) -->
    <local:ImageViewer x:Name="Viewer" Grid.RowSpan="9" Grid.ColumnSpan="9" />
  </Grid>
</UserControl>
