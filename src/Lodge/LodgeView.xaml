<UserControl x:Class="ElansAddonHub.Lodge.LodgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <UserControl.Resources>
    <!-- small round avatar with role ring, speaking ring and status badge -->
    <DataTemplate x:Key="AvatarSmall">
      <Grid Width="22" Height="22">
        <Ellipse Fill="{Binding Color}" />
        <Ellipse Fill="{Binding IconBrush}" />
        <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="#111315" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse Stroke="{Binding FrameBrush}" StrokeThickness="1.5" Margin="-2" />
        <Ellipse Stroke="{Binding Ring}" StrokeThickness="2" Margin="-4.5" />
        <Border Width="13" Height="13" CornerRadius="6.5" Background="{Binding StatusBrush}" BorderBrush="{StaticResource Surface}" BorderThickness="1.5"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" Visibility="{Binding StatusVisibility}">
          <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource Icons}" FontSize="7" Foreground="#111315" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- a person row in the sidebar (voice rooms and online list) -->
    <DataTemplate x:Key="PersonRow">
      <Border Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" ToolTip="{Binding Tip}" Tag="{Binding}"
              MouseLeftButtonUp="Member_Click" MouseRightButtonUp="Member_Click">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding StateGlyph}" FontFamily="{StaticResource Icons}" FontSize="11"
                     Foreground="{Binding StateBrush}" VerticalAlignment="Center" Visibility="{Binding StateVisibility}" />
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Accent}"
                     VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding PlayingVisibility}" ToolTip="In game" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding GameLine}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ClassBrush}"
                     VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding GameVisibility}" />
          <TextBlock Text="{Binding Name}" FontSize="12.5" Margin="10,0,6,0" VerticalAlignment="Center" Opacity="{Binding NameOpacity}"
                     Foreground="{Binding ClassBrushOrText}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- ===================== join ===================== -->
    <ScrollViewer x:Name="JoinPanel" VerticalScrollBarVisibility="Auto">
      <Border Margin="16,30,12,12" Padding="22" Background="{StaticResource Card}" CornerRadius="12" MaxWidth="460"
              BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="JoinTitle" Text="Join a lodge" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="Chat, voice and files with your friends. Paste the invite link you were sent." FontSize="12"
                     Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,16" />
          <TextBlock Text="INVITE LINK OR ADDRESS" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <TextBox x:Name="UrlBox" Style="{StaticResource Input}" Tag="https://example.com/lodge#invite=..." TextChanged="UrlBox_TextChanged" />
          <StackPanel x:Name="CodeArea">
            <TextBlock x:Name="CodeCaption" Text="INVITE CODE" Style="{StaticResource Caption}" Margin="0,12,0,5" />
            <PasswordBox x:Name="CodeBox" Style="{StaticResource SecretInput}" KeyDown="CodeBox_KeyDown" />
          </StackPanel>
          <TextBlock x:Name="CodeFromLink" Text="Invite code found in the link" FontSize="11.5" Foreground="{StaticResource Accent}"
                     Margin="2,6,0,0" Visibility="Collapsed" />
          <TextBlock Text="NAME  (only used with a shared guest code)" Style="{StaticResource Caption}" Margin="0,12,0,5" />
          <TextBox x:Name="NameBox" Style="{StaticResource Input}" Tag="Your name" />
          <Button x:Name="JoinButton" Style="{StaticResource PrimaryButton}" Content="Join" Margin="0,18,0,0" Click="Join_Click" />
          <Button x:Name="CancelEditButton" Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,8,0,0"
                  Visibility="Collapsed" Click="CancelEdit_Click" />
          <TextBlock x:Name="JoinStatus" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="2,10,0,0" />
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ===================== lodge ===================== -->
    <Grid x:Name="ChatPanel" Visibility="Collapsed" Margin="14,2,12,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== sidebar ===== -->
      <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="14,12,10,6">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,1,7,0" />
              <TextBlock x:Name="LodgeTitle" Text="Lodge" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource TextDim}" Margin="15,1,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,0,4,6">
            <StackPanel>
              <TextBlock Text="TEXT CHANNELS" Style="{StaticResource Caption}" Margin="8,6,0,4" />
              <ItemsControl x:Name="TextList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding RowBrush}" CornerRadius="6" Padding="8,5" Margin="0,1" Cursor="Hand" Tag="{Binding}"
                            MouseLeftButtonUp="Channel_Click" x:Name="row">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Danger}" CornerRadius="8" Padding="5,0" MinWidth="16"
                                Visibility="{Binding MentionVisibility}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Mentions}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{StaticResource Text}" VerticalAlignment="Center"
                                 Visibility="{Binding UnreadVisibility}" />
                        <TextBlock Text="#" FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,-2,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LockText}" DockPanel.Dock="Right" FontSize="9.5" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center" Margin="4,0,4,0" Visibility="{Binding LockVisibility}" />
                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontWeight="{Binding NameWeight}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceHi}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="VOICE ROOMS" Style="{StaticResource Caption}" Margin="8,14,0,4" />
              <ItemsControl x:Name="RoomList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Border CornerRadius="6" Padding="8,5" Margin="0,1" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Room_Click"
                              x:Name="row" Background="Transparent" ToolTip="Click to join">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                          <TextBlock DockPanel.Dock="Right" Text="{Binding LockText}" FontSize="9.5" Foreground="{StaticResource TextDim}"
                                     VerticalAlignment="Center" Margin="4,0,6,0" Visibility="{Binding LockVisibility}" />
                          <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource TextDim}"
                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                      <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource PersonRow}" Margin="18,0,0,2" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceHi}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="OnlineCaption" Text="ONLINE" Style="{StaticResource Caption}" Margin="8,14,0,4" />
              <ItemsControl x:Name="OnlineList" ItemTemplate="{StaticResource PersonRow}" />
            </StackPanel>
          </ScrollViewer>

          <!-- in voice -->
          <Border x:Name="VoiceBar" Grid.Row="2" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,8,8,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="MuteToggle" Style="{StaticResource IconToggle}" Width="30" Height="30" Content="&#xE720;" Click="MuteDeaf_Click" ToolTip="Mute" />
                <ToggleButton x:Name="DeafToggle" Style="{StaticResource IconToggle}" Width="30" Height="30" Content="&#xE7F6;" Margin="4,0,0,0" Click="MuteDeaf_Click" ToolTip="Deafen" />
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE778;" Foreground="{StaticResource Danger}" Margin="2,0,0,0"
                        Click="LeaveVoice_Click" ToolTip="Leave voice" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Voice connected" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="VoiceRoomText" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- me -->
          <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8,6,8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE713;" FontSize="13"
                      Click="Settings_Click" ToolTip="Settings" />
              <Border x:Name="MeRow" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Me_Click" ToolTip="Set your status" CornerRadius="6" Padding="2">
                <DockPanel>
                  <ContentPresenter x:Name="MeAvatar" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Center" />
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MeName" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeStatus" FontSize="10.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ===== chat ===== -->
      <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,11">
            <DockPanel>
              <TextBlock x:Name="ChatNote" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Gold}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="260" />
              <TextBlock Text="#" FontSize="17" Foreground="{StaticResource TextDim}" Margin="0,-2,8,0" VerticalAlignment="Center" />
              <TextBlock x:Name="ChannelTitle" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="0,4,0,8">
              <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,30,0,0" />
              <ItemsControl x:Name="Messages">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="row" Background="{Binding RowBackground}" BorderBrush="{Binding MentionBar}" BorderThickness="2,0,0,0"
                            Padding="12,2,12,3" Margin="{Binding RowMargin}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="42" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding AvatarVisibility}">
                          <Ellipse Fill="{Binding Color}" />
                          <TextBlock Text="{Binding Initial}" Foreground="#111315" FontSize="14.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1">
                          <TextBlock Visibility="{Binding ReplyVisibility}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,0,0,1">
                            <Run Text="&#xE97A;" FontFamily="{StaticResource Icons}" FontSize="10" />
                            <Run Text="{Binding ReplyFrom, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding ReplyText, Mode=OneWay}" />
                          </TextBlock>
                          <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderVisibility}">
                            <TextBlock Text="{Binding From}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Color}" />
                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="8,2,0,0" />
                          </StackPanel>
                          <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                   Foreground="{StaticResource Text}" FontSize="13" Padding="0" Margin="0,1,0,0" SelectionBrush="{StaticResource Accent}"
                                   Visibility="{Binding TextVisibility}" />
                          <TextBlock Text="(edited)" FontSize="10.5" Foreground="{StaticResource TextDim}" Visibility="{Binding EditedVisibility}" />
                          <StackPanel Visibility="{Binding FileVisibility}" Margin="0,5,0,2">
                            <Border Visibility="{Binding File.ImageVisibility}" CornerRadius="8" HorizontalAlignment="Left" Cursor="Hand"
                                    MouseLeftButtonUp="Image_Click" Tag="{Binding File}" ClipToBounds="True">
                              <Image Source="{Binding File.Image}" MaxHeight="240" MaxWidth="360" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border Visibility="{Binding File.CardVisibility}" Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="10,8"
                                    HorizontalAlignment="Left" MinWidth="230" MaxWidth="360" BorderBrush="{StaticResource Line}" BorderThickness="1">
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE896;" Click="Download_Click"
                                        Tag="{Binding File}" ToolTip="Save to Downloads" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7C3;" FontFamily="{StaticResource Icons}" FontSize="20"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding File.Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding File.SizeText}" FontSize="11" Foreground="{StaticResource TextDim}" />
                                    <TextBlock Text="{Binding File.Status}" FontSize="11" Foreground="{StaticResource Accent}" Margin="8,0,0,0" />
                                  </StackPanel>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                        <!-- hover tools -->
                        <Border x:Name="tools" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0" Visibility="Collapsed"
                                Background="{StaticResource SurfaceHi}" CornerRadius="7" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
                          <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE97A;" ToolTip="Reply"
                                    Tag="{Binding}" Click="Reply_Click" />
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE70F;" ToolTip="Edit"
                                    Tag="{Binding}" Click="Edit_Click" Visibility="{Binding EditVisibility}" />
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE74D;" ToolTip="Delete"
                                    Foreground="{StaticResource Danger}" Tag="{Binding}" Click="Delete_Click" Visibility="{Binding DeleteVisibility}" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="tools" Property="Visibility" Value="Visible" />
                        <Setter TargetName="row" Property="Background" Value="#0DFFFFFF" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <TextBlock x:Name="TypingText" Grid.Row="2" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="16,2,0,2" Height="16" />

          <!-- replying / editing -->
          <Border x:Name="ModeBar" Grid.Row="3" Visibility="Collapsed" Margin="12,0,12,0" Padding="12,6,6,6" Background="{StaticResource SurfaceHi}"
                  CornerRadius="9,9,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE711;"
                      Click="CancelMode_Click" ToolTip="Cancel (Esc)" />
              <TextBlock x:Name="ModeText" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>

          <Border Grid.Row="4" Margin="12,0,12,12" Background="{StaticResource SurfaceHi}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
            <DockPanel>
              <Button x:Name="AttachButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE723;" Click="Attach_Click"
                      ToolTip="Share a file (or drop it here, or paste with Ctrl+V)" />
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE724;" Foreground="{StaticResource Accent}" Click="Send_Click" ToolTip="Send (Enter)" />
              <Grid>
                <TextBlock x:Name="ComposerHint" Foreground="{StaticResource TextDim}" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False" />
                <TextBox x:Name="Composer" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                         FontSize="13" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center" Padding="2,7" SelectionBrush="{StaticResource Accent}"
                         PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- status picker -->
    <Popup x:Name="StatusPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
      <Border Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="6" Width="250">
        <StackPanel>
          <TextBlock Text="SET YOUR STATUS" Style="{StaticResource Caption}" Margin="8,4,0,4" />
          <Button Style="{StaticResource MenuRow}" Tag="online" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#ABD473" Margin="1,0,11,0" VerticalAlignment="Center" /><TextBlock Text="Online" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="away" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" Foreground="#E6B85C" FontSize="13" Width="24" /><TextBlock Text="AFK" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="busy" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE738;" FontFamily="{StaticResource Icons}" Foreground="#E06C6C" FontSize="13" FontWeight="Bold" Width="24" /><TextBlock Text="Busy" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="dungeon" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" Foreground="#B48CE0" FontSize="13" Width="24" /><TextBlock Text="In a dungeon" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="lfg" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" Foreground="#6CB4E0" FontSize="13" Width="24" /><TextBlock Text="Looking for group" /></StackPanel>
          </Button>
          <TextBox x:Name="NoteBox" Style="{StaticResource Input}" Tag="What are you up to? (optional)" Margin="2,8,2,2" MaxLength="40" KeyDown="NoteBox_KeyDown" />
          <TextBlock Text="Enter saves the note" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="6,3,0,2" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- person: volume, officer tools -->
    <Popup x:Name="MemberPopup" StaysOpen="False" Placement="Right" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="6">
      <Border Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Width="230">
        <StackPanel>
          <TextBlock x:Name="PopName" FontSize="14" FontWeight="SemiBold" />
          <TextBlock x:Name="PopRole" FontSize="11.5" Margin="0,1,0,0" />
          <TextBlock x:Name="PopStatus" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
          <TextBlock x:Name="PopGame" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
          <StackPanel x:Name="PopVolumeArea" Margin="0,12,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" x:Name="PopVolumeText" FontSize="11" Foreground="{StaticResource TextDim}" />
              <TextBlock Text="Volume" FontSize="12" />
            </DockPanel>
            <Slider x:Name="PopVolume" Minimum="0" Maximum="2" Margin="0,6,0,0" ValueChanged="PopVolume_Changed" />
          </StackPanel>
          <StackPanel x:Name="PopModArea" Margin="-8,10,0,0">
            <Button x:Name="PopMute" Style="{StaticResource MenuRow}" Click="PopMute_Click" />
            <Button Style="{StaticResource MenuRow}" Click="PopKick_Click">
              <TextBlock Text="Kick from the lodge" Foreground="{StaticResource Danger}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
