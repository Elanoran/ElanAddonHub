<UserControl x:Class="ElansAddonHub.Lodge.LodgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub.Lodge"
             xmlns:app="clr-namespace:ElansAddonHub"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="View_PreviewKeyDown">
  <!-- The Lodge follows DESIGN.md: a page panel (Brush.Panel, solid) holding the sidebar (calm rows, like the Settings nav) and the chat (a Surface1 card);
       Text.* styles, the 4-pt scale, no outlines (fill, elevation, hairlines), accent only for selection / the one action, status colours only for status. -->
  <UserControl.Resources>
    <!-- small round avatar (personal picture or class colour, class badge in game) with role ring, speaking ring and status dot -->
    <DataTemplate x:Key="AvatarSmall">
      <local:AvatarView Width="24" Height="24" Decor="True" />
    </DataTemplate>
    <DataTemplate x:Key="AvatarMe">
      <local:AvatarView Width="32" Height="32" Decor="True" />
    </DataTemplate>
    <DataTemplate x:Key="AvatarCard">
      <local:AvatarView Width="40" Height="40" />
    </DataTemplate>

    <!-- the hover card of a person: avatar, name, rank / level, place, state, status, voice - a few short lines (the name is the one semibold) -->
    <DataTemplate x:Key="MemberCard">
      <StackPanel MinWidth="216" MaxWidth="304">
        <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,0" Margin="12,0,0,0" Background="{Binding FrameBrush}" VerticalAlignment="Center">
            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.OnAccent}" VerticalAlignment="Center" />
          </Border>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarCard}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Style="{StaticResource Text.RowTitle}" Foreground="{Binding ClassBrushOrText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding CardNameText, Mode=OneWay}" /><Run Text="{Binding LoginText, Mode=OneWay}" FontWeight="Normal" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" /></TextBlock>
        </DockPanel>
        <TextBlock Text="{Binding CardClassLine}" Visibility="{Binding CardClassVisibility}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding CardStateVisibility}" Margin="0,4,0,0">
          <Image Source="{Binding StateIcon}" Width="12" Height="12" Margin="0,0,4,0" Visibility="{Binding StateIconVisibility}" VerticalAlignment="Center" />
          <TextBlock Text="&#xE708;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Warn}" Margin="0,0,4,0" VerticalAlignment="Center"
                     Visibility="{Binding AfkVisibility}" />
          <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding CardPlaceLine}" Visibility="{Binding CardPlaceVisibility}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding CardStatusLine}" Visibility="{Binding CardStatusVisibility}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding CardVoiceVisibility}" Margin="0,8,0,0">
          <TextBlock Text="{Binding StateGlyph}" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{Binding StateBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CardVoiceLine}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- a person row in the sidebar (voice rooms and online list): name, a quiet second line (place / XP / note), small state icons -->
    <DataTemplate x:Key="PersonRow">
      <ContentControl Style="{StaticResource Side.Row}" Tag="{Binding}" MouseLeftButtonUp="Member_Click" MouseRightButtonUp="Member_Click">
        <ContentControl.ToolTip>
          <ToolTip Style="{StaticResource CardTip}" ContentTemplate="{StaticResource MemberCard}" Content="{Binding}" />
        </ContentControl.ToolTip>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding StateGlyph}" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                     Foreground="{Binding StateBrush}" VerticalAlignment="Center" Visibility="{Binding StateVisibility}" />
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Text="&#xE7FC;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                     VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{Binding PlayingVisibility}" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding GameLine}" Style="{StaticResource Text.Caption}" Foreground="{Binding ClassBrush}"
                     VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{Binding GameVisibility}" />
          <Image DockPanel.Dock="Right" Source="{Binding StateIcon}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="{Binding StateIconVisibility}" />
          <TextBlock DockPanel.Dock="Right" Text="&#xE708;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Warn}" Margin="0,0,4,0"
                     VerticalAlignment="Center" Visibility="{Binding AfkVisibility}" />
          <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Body}" Opacity="{Binding NameOpacity}" Foreground="{Binding ClassBrushOrText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SecondLine}" Visibility="{Binding SecondVisibility}" Style="{StaticResource Text.Caption}"
                       Opacity="{Binding NameOpacity}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </ContentControl>
    </DataTemplate>

    <!-- search results: a channel header (quiet caption + count) and its hits: author, time, the snippet with the match picked out (the row's one semibold) -->
    <DataTemplate x:Key="SearchHit">
      <ContentControl Style="{StaticResource Side.Row}" Padding="8,8" Tag="{Binding}" MouseLeftButtonUp="SearchHit_Click" Margin="0,0,0,2">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="{Binding Time}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding FromShown}" Foreground="{Binding FromBrush}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TextBlock Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"><Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding After, Mode=OneWay}" /></TextBlock>
        </StackPanel>
      </ContentControl>
    </DataTemplate>
    <DataTemplate x:Key="SearchGroup">
      <StackPanel Margin="0,8,0,0">
        <DockPanel Margin="8,0,8,4">
          <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Caption}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Hits}" ItemTemplate="{StaticResource SearchHit}" />
      </StackPanel>
    </DataTemplate>

    <!-- an item chip: 24 high pill, icon (or a quiet tile), the name in its quality colour; click = Wowhead Classic -->
    <DataTemplate x:Key="ItemChip">
      <Border x:Name="chip" Style="{StaticResource Chip}" Padding="4,0,8,0" Margin="0,0,4,4" Cursor="Hand"
              Tag="{Binding}" MouseLeftButtonUp="ItemChip_Click">
        <Border.ToolTip><ToolTip Style="{StaticResource GameTip}" Opened="ItemChipTip_Opened" /></Border.ToolTip>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="16" Height="16">
            <Border Visibility="{Binding IconVisibility}" CornerRadius="8" ClipToBounds="True">
              <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <Border Visibility="{Binding TileVisibility}" CornerRadius="8" Background="{StaticResource Brush.Surface3}">
              <TextBlock Text="{Binding TileGlyph}" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" Style="{StaticResource Text.Secondary}" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="264" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="chip" Property="IsMouseOver" Value="True">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.Overlay.Pressed}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- one entry of a sign-up card's role row: who signed up (avatar + name in class colour), or an open place -->
    <DataTemplate x:Key="LfgSlot">
      <Grid Margin="0,0,4,4">
        <Border Visibility="{Binding FilledVisibility}" Style="{StaticResource Chip}" Padding="4,0,8,0">
          <Border.ToolTip>
            <ToolTip Style="{StaticResource CardTip}" ContentTemplate="{StaticResource MemberCard}" Content="{Binding Member}" />
          </Border.ToolTip>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <local:AvatarView Width="16" Height="16" DataContext="{Binding Member}" />
            <TextBlock Text="{Binding Shown}" Foreground="{Binding NameBrush}" Style="{StaticResource Text.Secondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Visibility="{Binding OpenVisibility}" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Brush.Overlay.Hover}" ToolTip="Open place">
          <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LfgRole">
      <Grid Margin="0,0,0,4" Visibility="{Binding RowVisibility}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,4,0,0">
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" />
          <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}"><Run Text="{Binding CountText, Mode=OneWay}" /></TextBlock>
          <TextBlock Text="{Binding MoreText}" Visibility="{Binding MoreVisibility}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}" />
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource LfgSlot}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </DataTemplate>

    <!-- the sign-up card in chat: instance, local time + countdown, the role slots filling up, buttons (the title is the one semibold) -->
    <DataTemplate x:Key="LfgCard">
      <Border Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Card}" Padding="16" Width="440" HorizontalAlignment="Left" Margin="0,8,0,4" Opacity="{Binding CardOpacity}">
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{Binding StatusFill}" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{Binding StatusTip}">
              <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="&#xE902;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding WhenLine}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding Roles}" ItemTemplate="{StaticResource LfgRole}" Margin="0,12,0,0" />
          <Grid Visibility="{Binding MaybeVisibility}" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Maybe" Style="{StaticResource Text.Secondary}" />
            <TextBlock Grid.Column="1" Text="{Binding MaybeNames}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Text="{Binding MyLine}" Visibility="{Binding MyLineVisibility}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
          <WrapPanel Visibility="{Binding ActionsVisibility}" Margin="0,12,0,0">
            <Button Content="Join as Tank" Style="{StaticResource Button.S}" Margin="0,0,8,8" Tag="{Binding}" Click="LfgTank_Click" Visibility="{Binding TankVisibility}" IsEnabled="{Binding TankEnabled}" />
            <Button Content="Join as Healer" Style="{StaticResource Button.S}" Margin="0,0,8,8" Tag="{Binding}" Click="LfgHealer_Click" Visibility="{Binding HealerVisibility}" IsEnabled="{Binding HealerEnabled}" />
            <Button Content="Join as DPS" Style="{StaticResource Button.S}" Margin="0,0,8,8" Tag="{Binding}" Click="LfgDps_Click" Visibility="{Binding DpsVisibility}" IsEnabled="{Binding DpsEnabled}" />
            <Button Content="Maybe" Style="{StaticResource Button.S}" Margin="0,0,8,8" Tag="{Binding}" Click="LfgMaybe_Click" IsEnabled="{Binding MaybeEnabled}" />
            <Button Content="Leave" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,8,8" Tag="{Binding}" Click="LfgLeave_Click" Visibility="{Binding LeaveVisibility}" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding EndVisibility}">
            <Button Content="Close the group" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,8,0" Tag="{Binding}" Click="LfgClose_Click"
                    ToolTip="The group is set: nobody can sign up or leave any more" />
            <Button Content="Cancel it" Style="{StaticResource GhostButton}" Height="28" Tag="{Binding}" Click="LfgCancel_Click" ToolTip="Call it off" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- an event in the strip above the chat: a Surface2 pill (two lines), veil on hover, focus ring from the keyboard -->
    <Style x:Key="Pill.Event" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Brush.Surface2}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Card}" />
              <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Card}" Opacity="0" IsHitTestVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
              <Border x:Name="pr" Background="{StaticResource Brush.Press.Dark.Soft}" CornerRadius="{StaticResource Radius.Card}" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="ring" Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the chat card of a calendar event: a compact Surface2 card that links to the event (server 2.11; older clients see the fallback line) -->
    <DataTemplate x:Key="EventChatCard">
      <Border Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Card}" Padding="16" Width="440" HorizontalAlignment="Left" Margin="0,8,0,4" Opacity="{Binding CardOpacity}">
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{Binding StatusFill}" Visibility="{Binding StatusVisibility}" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="&#xE787;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding CardWhen}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding FillText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding MyLine}" Visibility="{Binding MyLineVisibility}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
          <Button Content="Open in Calendar" Style="{StaticResource Button.S}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="{Binding}" Click="EventOpen_Click" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- a person who is playing WoW (the "In game" group): the character in class colour, "Lv 27 Hunter", the place, a dungeon / raid / group tag -->
    <DataTemplate x:Key="GamePersonRow">
      <ContentControl Style="{StaticResource Side.Row}" Tag="{Binding}" MouseLeftButtonUp="Member_Click" MouseRightButtonUp="Member_Click">
        <ContentControl.ToolTip>
          <ToolTip Style="{StaticResource CardTip}" ContentTemplate="{StaticResource MemberCard}" Content="{Binding}" />
        </ContentControl.ToolTip>
        <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,0" VerticalAlignment="Top" Margin="4,0,0,0"
                  Visibility="{Binding InstanceTagVisibility}" ToolTip="{Binding InstanceTagTip}">
            <TextBlock Text="{Binding InstanceTag}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
          </Border>
          <TextBlock DockPanel.Dock="Right" Text="{Binding StateGlyph}" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                     Foreground="{Binding StateBrush}" VerticalAlignment="Top" Margin="4,2,0,0" Visibility="{Binding StateVisibility}" />
          <Image DockPanel.Dock="Right" Source="{Binding StateIcon}" Width="12" Height="12" Margin="4,2,0,0" VerticalAlignment="Top" Visibility="{Binding StateIconVisibility}" />
          <TextBlock DockPanel.Dock="Right" Text="&#xE708;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Warn}" Margin="4,2,0,0"
                     VerticalAlignment="Top" Visibility="{Binding AfkVisibility}" />
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Top" Margin="0,2,0,0" />
          <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{Binding ClassBrushOrText}" TextTrimming="CharacterEllipsis"><Run Text="{Binding CharName, Mode=OneWay}" /><Run Text="{Binding CharOwnerText, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" /></TextBlock>
            <TextBlock Text="{Binding InGameClassLine}" Visibility="{Binding InGameClassVisibility}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ZoneLine}" Visibility="{Binding ZoneVisibility}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </ContentControl>
    </DataTemplate>

    <!-- one group of the online list: a quiet collapsible header (Text.Caption + count), then its people -->
    <DataTemplate x:Key="MemberGroupTemplate">
      <StackPanel Margin="0,8,0,0">
        <ContentControl Style="{StaticResource Side.Row}" Tag="{Binding}" ToolTip="{Binding Tip}" MouseLeftButtonUp="GroupHeader_Click">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Chevron}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Expanded}" Value="False">
                      <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90" /></Setter.Value></Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Section.People}" />
          </DockPanel>
        </ContentControl>
        <Border app:Motion.Expand="{Binding Expanded}" Visibility="Collapsed" Opacity="{Binding ListOpacity}">
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="ItemTemplate" Value="{StaticResource PersonRow}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding InGame}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource GamePersonRow}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- sidebar section headers (Text channels / Voice rooms): quiet Text.Caption in the section's hue (Brush.Section.Channels / .Voice; DESIGN 4,
         "Section colours"), no bold, no capitals -->
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}" />

    <!-- a popover card (search, menus, status, profile card): Surface3 + hairline + Elevation.2; the 24 px margin holds the shadow, popups give the offset back -->
    <Style x:Key="PopupCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Brush.Surface3}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Margin" Value="24" />
      <Setter Property="Effect" Value="{StaticResource Elevation.2}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <!-- ===================== server update note (owner / officers only, dismissible) ===================== -->
    <Border x:Name="ServerNotice" Grid.Row="0" Visibility="Collapsed" Margin="16,4,12,8" Padding="12,8" Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Card}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE711;" Margin="8,0,0,0" Click="ServerNoticeClose_Click"
                ToolTip="Dismiss (until the next Lodge server version)" AutomationProperties.Name="Dismiss" />
        <Button x:Name="ServerNoticeCopy" DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Copy command" Click="ServerNoticeCopy_Click"
                ToolTip="Copies: sudo lodge-update" />
        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Info}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="ServerNoticeText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
      </DockPanel>
    </Border>
    <!-- ===================== a notice from the Cairn's operator (signed; LodgeSession.CairnNotices.cs), coloured by level ===================== -->
    <Border x:Name="CairnNotice" Grid.Row="0" Visibility="Collapsed" Margin="16,4,12,8" Padding="12,8" Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Card}"
            BorderThickness="1" BorderBrush="{StaticResource Brush.Info}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE711;" Margin="8,0,0,0" Click="CairnNoticeClose_Click"
                ToolTip="Got it" AutomationProperties.Name="Dismiss" />
        <TextBlock x:Name="CairnNoticeIcon" Text="&#xE946;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Info}" VerticalAlignment="Top" Margin="0,2,8,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="CairnNoticeTitle" Style="{StaticResource Text.RowTitle}" Text="From the Cairn &#x2713;"
                     ToolTip="Signed with the Cairn's key - your Lodge passed it on and could not have written it" />
          <TextBlock x:Name="CairnNoticeText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- ===================== "Upgrade this device": a quiet one-time offer to someone still signing in with a permanent code ===================== -->
    <Border x:Name="UpgradeNotice" Grid.Row="0" Visibility="Collapsed" Margin="16,4,12,8" Padding="16,12" Background="{StaticResource Brush.Surface2}" CornerRadius="12">
      <DockPanel>
        <Button x:Name="UpgradeLater" DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Not now" Margin="8,0,0,0" Click="UpgradeLater_Click" />
        <Button x:Name="UpgradeNow" DockPanel.Dock="Right" Style="{StaticResource Button.Primary.S}" Content="Upgrade this device" Margin="8,0,0,0" Click="UpgradeNow_Click" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Give this PC its own sign-in" Style="{StaticResource Text.RowTitle}" />
          <TextBlock x:Name="UpgradeText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Text="Your permanent code is swapped for a key only this PC holds, so a code or link that leaks cannot be reused. You can sign this PC out any time under Settings, Lodge, Your devices." />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- ===================== join ===================== -->
    <ScrollViewer x:Name="JoinPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Border Margin="16,30,12,12" Padding="22" Background="{StaticResource Card}" CornerRadius="12" MaxWidth="460"
              BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="JoinTitle" Text="Join a lodge" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="Chat, voice and files with your friends. Paste the invite link you were sent - it works once, and this PC then gets its own sign-in." FontSize="12"
                     Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,16" />
          <Border x:Name="IncomingBanner" Visibility="Collapsed" Background="{StaticResource Brush.Surface2}" CornerRadius="10" Padding="12" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock x:Name="IncomingTitle" Style="{StaticResource Text.RowTitle}" TextWrapping="Wrap" />
              <TextBlock x:Name="IncomingText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="INVITE LINK OR ADDRESS" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <TextBox x:Name="UrlBox" Style="{StaticResource Input}" Tag="elanshub://lodge/join#example.com/lodge|..." TextChanged="UrlBox_TextChanged" />
          <StackPanel x:Name="CodeArea">
            <TextBlock x:Name="CodeCaption" Text="INVITE CODE" Style="{StaticResource Caption}" Margin="0,12,0,5" />
            <PasswordBox x:Name="CodeBox" Style="{StaticResource SecretInput}" KeyDown="CodeBox_KeyDown" />
          </StackPanel>
          <TextBlock x:Name="CodeFromLink" Text="Invite found in the link" FontSize="12" Foreground="{StaticResource Accent}"
                     Margin="2,6,0,0" Visibility="Collapsed" />
          <TextBlock x:Name="NameCaption" Text="NAME  (only used with a shared guest code)" Style="{StaticResource Caption}" Margin="0,12,0,5" />
          <TextBox x:Name="NameBox" Style="{StaticResource Input}" Tag="Your name" />
          <TextBlock Text="THIS PC  (shown in Your devices, so you can sign it out later)" Style="{StaticResource Caption}" Margin="0,12,0,5" />
          <TextBox x:Name="DeviceBox" Style="{StaticResource Input}" Tag="PC name" MaxLength="32" />
          <Button x:Name="JoinButton" Style="{StaticResource PrimaryButton}" Content="Join" Margin="0,18,0,0" Click="Join_Click" />
          <Button x:Name="CancelEditButton" Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,8,0,0"
                  Visibility="Collapsed" Click="CancelEdit_Click" />
          <Button x:Name="RestoreSavedButton" Style="{StaticResource GhostButton}" Content="Back to my saved sign-in" HorizontalAlignment="Center" Margin="0,8,0,0"
                  Visibility="Collapsed" Click="RestoreSaved_Click" />
          <TextBlock x:Name="JoinStatus" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="2,10,0,0" />
          <Button x:Name="CreateLodgeButton" Style="{StaticResource GhostButton}" Content="Create a lodge" HorizontalAlignment="Center" Margin="0,8,0,0"
                  Click="CreateLodge_Click" ToolTip="Start your own lodge on a server of your own" />
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ===================== lodge: the page panel (DESIGN 4) holds the sidebar and the chat card ===================== -->
    <Border x:Name="ChatPanel" Grid.Row="1" Visibility="Collapsed" Margin="16,4,12,12" Padding="16" Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Card}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{app:SideMenuColumn}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== sidebar: on the faint menu fill (Brush.Section.Panel, like the Settings menu, the Atlas navigation and the Characters list); each section in its hue ===== -->
      <Border x:Name="SidebarBox" Grid.Column="0" Margin="-8,-8,8,-8" Padding="8" Background="{StaticResource Brush.Section.Panel}" CornerRadius="{StaticResource Radius.Control}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="12,0,12,8">
            <Button x:Name="InviteSideButton" DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Invite" Visibility="Collapsed" VerticalAlignment="Top"
                    Click="InviteSide_Click" ToolTip="Invite someone to the lodge" />
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="LodgeTitle" Text="Lodge" Style="{StaticResource Text.Section}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" app:Motion.EdgeFade="True">
            <StackPanel>
              <!-- skeleton rows while the lodge connects (until the welcome frame names the channels) -->
              <StackPanel x:Name="SidebarSkeleton" Margin="0,8,8,0" Visibility="Collapsed">
                <app:Skeleton Height="12" Width="72" CornerRadius="6" HorizontalAlignment="Left" Margin="12,0,0,12" />
                <app:Skeleton Height="12" Width="132" CornerRadius="6" HorizontalAlignment="Left" Margin="12,0,0,16" />
                <app:Skeleton Height="12" Width="96" CornerRadius="6" HorizontalAlignment="Left" Margin="12,0,0,16" />
                <app:Skeleton Height="12" Width="72" CornerRadius="6" HorizontalAlignment="Left" Margin="12,12,0,12" />
                <app:Skeleton Height="12" Width="120" CornerRadius="6" HorizontalAlignment="Left" Margin="12,0,0,0" />
              </StackPanel>
              <!-- the calendar (server 2.11): one quiet row above the channels; the page takes the chat's place -->
              <ContentControl x:Name="CalendarRow" Style="{StaticResource Side.Row}" Padding="12,0" MinHeight="36" Margin="0,8,0,0" Visibility="Collapsed"
                              MouseLeftButtonUp="CalendarRow_Click" ToolTip="Raids and events, with who is coming" AutomationProperties.Name="Calendar">
                <DockPanel>
                  <Border x:Name="CalendarBadge" DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,0" MinWidth="24" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Events today">
                    <TextBlock x:Name="CalendarBadgeText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="&#xE787;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Section.Calendar}" Width="16" VerticalAlignment="Center" />
                  <TextBlock x:Name="CalendarRowText" Text="Calendar" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
              </ContentControl>
              <!-- shared files (server 2.14): a quiet row under the calendar; the page takes the chat's place -->
              <ContentControl x:Name="FilesRow" Style="{StaticResource Side.Row}" Padding="12,0" MinHeight="36" Margin="0,2,0,0" Visibility="Collapsed"
                              MouseLeftButtonUp="FilesRow_Click" ToolTip="Files the lodge shares" AutomationProperties.Name="Files">
                <DockPanel>
                  <Border x:Name="FilesBadge" DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,0" MinWidth="24" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Files that are new or updated">
                    <TextBlock x:Name="FilesBadgeText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Section.Files}" Width="16" VerticalAlignment="Center" />
                  <TextBlock x:Name="FilesRowText" Text="Files" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
              </ContentControl>
              <!-- the ladder (server feature "badges"): a quiet row under Files; the page takes the chat's place -->
              <ContentControl x:Name="LadderRow" Style="{StaticResource Side.Row}" Padding="12,0" MinHeight="36" Margin="0,2,0,0" Visibility="Collapsed"
                              MouseLeftButtonUp="LadderRow_Click" ToolTip="Who shares the most with the lodge, and their badges" AutomationProperties.Name="Ladder">
                <DockPanel>
                  <TextBlock Text="&#xE734;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Section.Ladder}" Width="16" VerticalAlignment="Center" />
                  <TextBlock x:Name="LadderRowText" Text="Ladder" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
              </ContentControl>
              <TextBlock x:Name="TextHeader" Text="Text channels" Style="{StaticResource SectionHeader}" Foreground="{StaticResource Brush.Section.Channels}" Margin="12,8,0,4" />
              <ItemsControl x:Name="TextList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ContentControl Style="{StaticResource Side.Row}" Background="{Binding RowBrush}" BorderBrush="{Binding MarkBrush}" Padding="12,0" MinHeight="36" Margin="0,0,0,2" Tag="{Binding}"
                                    MouseLeftButtonUp="Channel_Click">
                      <DockPanel>
                        <!-- @ badge: someone mentioned me here -->
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource Brush.Accent}" Padding="8,0" MinWidth="24"
                                Visibility="{Binding MentionVisibility}" VerticalAlignment="Center" ToolTip="You were mentioned">
                          <TextBlock Text="{Binding MentionText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- unread count -->
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,0" MinWidth="24"
                                Visibility="{Binding UnreadVisibility}" VerticalAlignment="Center" ToolTip="Unread messages">
                          <TextBlock Text="{Binding UnreadText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="#" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Section.Channels}" Width="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LockText}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" Margin="4,0,4,0" Visibility="{Binding LockVisibility}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{Binding NameBrush}" FontWeight="{Binding NameWeight}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </ContentControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="VoiceHeader" Text="Voice rooms" Style="{StaticResource SectionHeader}" Foreground="{StaticResource Brush.Section.Voice}" Margin="12,16,0,4" />
              <ItemsControl x:Name="RoomList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <ContentControl Style="{StaticResource Side.Row}" Background="{Binding RoomBrush}" BorderBrush="{Binding RoomMarkBrush}" Padding="12,0" MinHeight="36" Margin="0,0,0,2" Tag="{Binding}" MouseLeftButtonUp="Room_Click" ToolTip="Click to join">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" ToolTip="{Binding CountTip}" />
                          <TextBlock DockPanel.Dock="Right" Text="{Binding LockText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}"
                                     VerticalAlignment="Center" Margin="4,0,8,0" Visibility="{Binding LockVisibility}" />
                          <TextBlock Text="&#xE767;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Section.Voice}" Width="16"
                                     Margin="0,0,0,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{Binding NameBrush}" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                      </ContentControl>
                      <TextBlock Text="Joining voice shows you in the room" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                 Margin="32,0,8,4" Visibility="{Binding InvisibleHintVisibility}" />
                      <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource PersonRow}" Margin="16,0,0,4" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl x:Name="GroupList" ItemTemplate="{StaticResource MemberGroupTemplate}" />
            </StackPanel>
          </ScrollViewer>

          <!-- the next event: one calm line, "Molten Core · Sat 20:00 · in 2 d" (server 2.11) -->
          <ContentControl x:Name="NextEventRow" Grid.Row="2" Style="{StaticResource Side.Row}" Padding="12,0" MinHeight="36" Margin="0,8,0,0" Visibility="Collapsed"
                          MouseLeftButtonUp="NextEvent_Click" ToolTip="Open the next event" AutomationProperties.Name="Next event">
            <DockPanel>
              <TextBlock x:Name="NextEventText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4" />
            </DockPanel>
          </ContentControl>

          <!-- in voice -->
          <Border x:Name="VoiceBar" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource Brush.Surface1}" CornerRadius="{StaticResource Radius.Card}" Padding="12,8,8,8" Margin="0,8,0,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="MuteToggle" Style="{StaticResource IconToggle}" Width="32" Height="32" Content="&#xE720;" Click="MuteDeaf_Click" ToolTip="Mute" />
                <ToggleButton x:Name="DeafToggle" Style="{StaticResource IconToggle}" Width="32" Height="32" Content="&#xE7F6;" Margin="4,0,0,0" Click="MuteDeaf_Click" ToolTip="Deafen" />
                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE778;" Margin="4,0,0,0"
                        Click="LeaveVoice_Click" ToolTip="Leave voice" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Voice connected" Style="{StaticResource Text.RowTitle}" Foreground="{StaticResource Brush.Success}" />
                <TextBlock x:Name="VoiceRoomText" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- me -->
          <Border x:Name="MeCard" Grid.Row="4" Background="{StaticResource Brush.Surface1}" CornerRadius="{StaticResource Radius.Card}" Padding="8" Margin="0,8,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE713;"
                      Click="Settings_Click" ToolTip="Settings" />
              <Border x:Name="MeRow" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Me_Click" ToolTip="Set your status" CornerRadius="{StaticResource Radius.Control}" Padding="4">
                <DockPanel>
                  <ContentPresenter x:Name="MeAvatar" ContentTemplate="{StaticResource AvatarMe}" VerticalAlignment="Center" Cursor="Hand" ToolTip="Edit your profile"
                                    PreviewMouseLeftButtonUp="MeAvatar_Click" />
                  <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MeName" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeStatus" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ===== the calendar page: takes the chat's place while it is open ===== -->
      <local:CalendarView x:Name="CalendarPage" Grid.Column="1" Visibility="Collapsed" />
      <local:FilesView x:Name="FilesPage" Grid.Column="1" Visibility="Collapsed" />
      <local:LadderView x:Name="LadderPage" Grid.Column="1" Visibility="Collapsed" />

      <!-- ===== chat: straight on the page panel (no card of its own, like the Atlas' pages) ===== -->
      <Border x:Name="ChatCard" Grid.Column="1" Background="Transparent" CornerRadius="{StaticResource Radius.Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="16,8">
              <DockPanel MinHeight="32">
                <!-- pinned messages (only when the server supports pins) -->
                <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="Auto" MinWidth="32" Height="32" Padding="8,0"
                        Margin="4,0,0,0" Click="PinButton_Click" ToolTip="Pinned messages" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE718;" FontFamily="{StaticResource Font.Icons}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="PinCount" Style="{StaticResource Text.Secondary}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <!-- search (server 2.9) -->
                <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0" Content="&#xE721;"
                        Click="SearchButton_Click" ToolTip="Search messages (Ctrl+F)" Visibility="Collapsed" />
                <TextBlock x:Name="ChatNote" DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,4,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
                <TextBlock x:Name="HeaderHash" Text="#" Style="{StaticResource Text.Section}" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ChannelTitle" Style="{StaticResource Text.Section}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
            <!-- a gentle one-time tip (the display name): inline, calm, dismissible -->
            <Border x:Name="HintBar" Visibility="Collapsed" Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Control}" Margin="16,8,16,0" Padding="12,4,4,4">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE711;" Margin="8,0,0,0" Click="HintClose_Click"
                        ToolTip="Dismiss" AutomationProperties.Name="Dismiss tip" />
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="HintText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <!-- a file changed (shared files, server 2.14): who did what, calm and dismissible; it opens the Files page -->
            <Border x:Name="FilesBar" Visibility="Collapsed" Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Control}" Margin="16,8,16,0" Padding="12,4,4,4"
                    AutomationProperties.Name="Shared files changed">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE711;" Margin="8,0,0,0" Click="FilesBarClose_Click"
                        ToolTip="Dismiss" AutomationProperties.Name="Dismiss file notice" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="28" Content="Open Files" Click="FilesBarOpen_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="FilesBarText" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <!-- upcoming events: a strip of fixed height (64) under the header. It is 0 high and collapsed when there is nothing to show; it grows / shrinks with
                 the Standard motion and the message list is held in place while it does (LodgeView.Calendar.cs). Switch: Settings > Lodge. -->
            <Border x:Name="EventsStrip" Height="0" Visibility="Collapsed" ClipToBounds="True" AutomationProperties.Name="Upcoming events">
              <DockPanel Margin="16,8">
                <Button x:Name="StripAll" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="28" Content="See all" Click="StripAll_Click" Margin="8,0,0,0"
                        VerticalAlignment="Center" ToolTip="Open the Calendar" AutomationProperties.Name="See all events" />
                <ItemsControl x:Name="StripItems" Focusable="False" HorizontalAlignment="Left">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource Pill.Event}" Width="200" Height="48" Margin="0,0,8,0" Tag="{Binding}" Click="StripItem_Click" ToolTip="{Binding StripTip}"
                              AutomationProperties.Name="{Binding Summary}">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StripFill}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Image DockPanel.Dock="Left" Source="{Binding IconImage}" Visibility="{Binding IconVisibility}" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StripStatus}" Foreground="{Binding StripStatusBrush}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding StripWhen}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>
          </StackPanel>

          <Grid Grid.Row="1">
          <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" ScrollChanged="MessageScroll_Changed" PreviewMouseWheel="MessageScroll_Wheel" app:Motion.EdgeFade="True">
            <StackPanel Margin="0,8,0,8">
              <TextBlock x:Name="OlderNote" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,4" Visibility="Collapsed" />
              <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,32,0,0" />
              <!-- skeleton messages while the history is on its way -->
              <StackPanel x:Name="MessagesSkeleton" Margin="16,8,16,0" Visibility="Collapsed">
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <app:Skeleton Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1"><app:Skeleton Height="12" Width="96" CornerRadius="6" HorizontalAlignment="Left" /><app:Skeleton Height="12" Width="360" CornerRadius="6" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <app:Skeleton Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1"><app:Skeleton Height="12" Width="72" CornerRadius="6" HorizontalAlignment="Left" /><app:Skeleton Height="12" Width="280" CornerRadius="6" HorizontalAlignment="Left" Margin="0,8,0,0" /><app:Skeleton Height="12" Width="200" CornerRadius="6" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <app:Skeleton Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1"><app:Skeleton Height="12" Width="112" CornerRadius="6" HorizontalAlignment="Left" /><app:Skeleton Height="12" Width="320" CornerRadius="6" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel>
                </Grid>
              </StackPanel>
              <ItemsControl x:Name="Messages">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <!-- "New messages" line, above the first message I haven't read -->
                      <Grid Visibility="{Binding DividerVisibility}" Margin="16,16,16,4">
                        <Border Height="1" Background="{StaticResource Brush.Accent}" Opacity="0.55" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right" Background="{StaticResource Brush.Surface1}" CornerRadius="{StaticResource Radius.Chip}">
                          <Border Style="{StaticResource Chip}" Background="{StaticResource Brush.Accent.Tint}" Padding="8,0">
                            <TextBlock Text="New" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                          </Border>
                        </Border>
                      </Grid>
                      <Border x:Name="row" Background="{Binding RowBackground}" Padding="16,4" Margin="{Binding RowMargin}" PreviewMouseRightButtonUp="Message_RightClick">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <!-- the 2 px bar of a message that mentions me -->
                          <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Width="2" HorizontalAlignment="Left" Margin="-16,-4,0,-4" Background="{Binding MentionBar}" IsHitTestVisible="False" />

                          <!-- the quoted message: a curved connector into the avatar and one quiet line -->
                          <Border Grid.Row="0" Grid.Column="0" Visibility="{Binding ReplyVisibility}" Margin="16,8,4,-4"
                                  BorderBrush="{StaticResource Brush.Text.Tertiary}" BorderThickness="2,2,0,0" CornerRadius="8,0,0,0" />
                          <TextBlock Grid.Row="0" Grid.Column="1" Visibility="{Binding ReplyVisibility}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                                     Margin="0,4,48,4" Cursor="Hand" Tag="{Binding}"
                                     MouseLeftButtonUp="ReplyQuote_Click" ToolTip="Jump to the original message">
                            <Run Text="{Binding ReplyShown, Mode=OneWay}" Foreground="{Binding ReplyColor, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ReplyText, Mode=OneWay}" />
                          </TextBlock>

                          <local:AvatarView Grid.Row="1" Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding AvatarVisibility}"
                                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="MessageAuthor_Click" />
                          <StackPanel Grid.Row="1" Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderVisibility}">
                              <TextBlock Text="{Binding FromShown}" Style="{StaticResource Text.RowTitle}" Foreground="{Binding Color}" ToolTipOpening="NameTip_Opening"
                                         Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="MessageAuthor_Click">
                                <TextBlock.ToolTip>
                                  <ToolTip Style="{StaticResource CardTip}" ContentTemplate="{StaticResource MemberCard}" Content="{Binding Author}" />
                                </TextBlock.ToolTip>
                              </TextBlock>
                              <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding ShownText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" TextBlock.LineHeight="18" Padding="0" Margin="0,2,0,0" SelectionBrush="{StaticResource Brush.Accent}"
                                     Visibility="{Binding TextVisibility}" ContextMenu="{x:Null}"
                                     Tag="{Binding}" PreviewMouseMove="MessageText_Move" PreviewMouseLeftButtonUp="MessageText_Up" />
                            <TextBlock Text="(edited)" Style="{StaticResource Text.Caption}" Visibility="{Binding EditedVisibility}" />
                            <!-- item links: a chip per [Item], Wowhead item URL or pasted game link -->
                            <ItemsControl ItemsSource="{Binding ItemChips}" Visibility="{Binding ItemChipsVisibility}" Margin="0,4,0,0" ItemTemplate="{StaticResource ItemChip}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!-- "Looking for group" sign-up card (server 2.9) -->
                            <ContentControl Content="{Binding Lfg}" ContentTemplate="{StaticResource LfgCard}" Visibility="{Binding LfgVisibility}" />
                            <ContentControl Content="{Binding Event}" ContentTemplate="{StaticResource EventChatCard}" Visibility="{Binding EventVisibility}" />
                            <StackPanel Visibility="{Binding FileVisibility}" Margin="0,4,0,4">
                              <Border Visibility="{Binding File.ImageVisibility}" CornerRadius="{StaticResource Radius.Card}" HorizontalAlignment="Left" Cursor="Hand"
                                      MouseLeftButtonUp="Image_Click" Tag="{Binding File}" ClipToBounds="True">
                                <Image Source="{Binding File.Image}" MaxHeight="240" MaxWidth="360" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                              </Border>
                              <Border Visibility="{Binding File.CardVisibility}" Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Card}" Padding="12,8"
                                      HorizontalAlignment="Left" MinWidth="232" MaxWidth="360">
                                <DockPanel>
                                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE896;" Click="Download_Click"
                                          Tag="{Binding File}" ToolTip="Save to Downloads" />
                                  <TextBlock DockPanel.Dock="Left" Text="&#xE7C3;" FontFamily="{StaticResource Font.Icons}" FontSize="20"
                                             Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding File.Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="{Binding File.ExtText}" Visibility="{Binding File.ExtVisibility}" Style="{StaticResource Text.Caption}"
                                                 Foreground="{Binding File.ExtBrush}" ToolTip="{Binding File.ExtTip}" Margin="0,0,8,0" />
                                      <TextBlock Text="{Binding File.SizeText}" Style="{StaticResource Text.Caption}" />
                                      <TextBlock Text="{Binding File.Status}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                    </StackPanel>
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                            </StackPanel>
                            <!-- YouTube preview: thumbnail + play button, title and channel; a click plays it in the viewer -->
                            <Border Visibility="{Binding VideoVisibility}" HorizontalAlignment="Left" Width="360" Margin="0,8,0,4" CornerRadius="{StaticResource Radius.Card}"
                                    Background="{StaticResource Brush.Surface2}" Cursor="Hand" Tag="{Binding Video}" ToolTip="{Binding Video.ToolTipText}"
                                    MouseLeftButtonUp="Video_Click">
                              <StackPanel>
                                <Border Height="203" CornerRadius="{Binding Video.ThumbRadius}">
                                  <Border.Background>
                                    <ImageBrush ImageSource="{Binding Video.Thumb}" Stretch="UniformToFill" />
                                  </Border.Background>
                                  <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource Brush.Scrim.Disc}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icons}" FontSize="20" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                                  </Border>
                                </Border>
                                <StackPanel Visibility="{Binding Video.InfoVisibility}" Margin="12,8,12,12">
                                  <TextBlock Text="{Binding Video.Title}" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Video.Channel}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding Video.ChannelVisibility}" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                            <!-- reactions: 24 high pills with counts, mine tinted, click toggles -->
                            <ItemsControl ItemsSource="{Binding Reactions}" Visibility="{Binding ReactionsVisibility}" Margin="0,4,0,0">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Style="{StaticResource Chip}" Background="{Binding Fill}" Padding="8,0"
                                          Margin="0,0,4,4" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Tip}" MouseLeftButtonUp="Reaction_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                      <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                      <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Visibility="{Binding TextVisibility}" />
                                      <TextBlock Text="{Binding Count}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Text.Primary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <TextBlock Grid.Row="1" Grid.Column="1" Text="&#xE718;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" Visibility="{Binding PinnedVisibility}" ToolTip="Pinned" />

                          <!-- hover tools (Reply, React, Pin, More): a small elevated pill -->
                          <Border x:Name="tools" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,0,0"
                                  Visibility="Collapsed" Background="{StaticResource Brush.Surface3}" CornerRadius="14" Padding="2" Effect="{StaticResource Elevation.1}">
                            <StackPanel Orientation="Horizontal">
                              <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE97A;" ToolTip="Reply"
                                      Tag="{Binding}" Click="Reply_Click" />
                              <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE899;" ToolTip="Add reaction"
                                      Tag="{Binding}" Click="React_Click" Visibility="{Binding ReactToolVisibility}" />
                              <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE718;" ToolTip="Pin / unpin"
                                      Tag="{Binding}" Click="PinTool_Click" Visibility="{Binding PinToolVisibility}" />
                              <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE712;" ToolTip="More"
                                      Tag="{Binding}" Click="More_Click" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Border>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="tools" Property="Visibility" Value="Visible" />
                        <Setter TargetName="row" Property="Background" Value="{StaticResource Brush.Overlay.Hover}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding ForceTools}" Value="True">
                        <Setter TargetName="tools" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- floating: Jump to first unread / Jump to present (a small elevated pill) -->
          <Button x:Name="JumpButton" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Visibility="Collapsed" Click="Jump_Click" Cursor="Hand"
                  FocusVisualStyle="{x:Null}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Grid>
                  <Border x:Name="bd" Background="{StaticResource Brush.Surface3}" CornerRadius="14" Padding="12,4" Height="28" Effect="{StaticResource Elevation.1}">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="14" Opacity="0" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="JumpGlyph" Text="&#xE74B;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock x:Name="JumpText" Text="Jump to present" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- while dragging files over the chat -->
          <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" Margin="8">
            <Grid>
              <Rectangle Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" StrokeDashArray="5 4" RadiusX="12" RadiusY="12" Opacity="0.8" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="DropGlyph" Text="&#xE896;" FontFamily="{StaticResource Font.Icons}" FontSize="32" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropText" Text="Drop to share" Style="{StaticResource Text.Section}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropSub" Text="Pictures and files go to this channel" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          </Grid>

          <TextBlock x:Name="TypingText" Grid.Row="2" Style="{StaticResource Text.Caption}" Margin="16,0,16,4" Height="14" />

          <!-- offline: calm, and Send is off while it lasts -->
          <Border x:Name="OfflineBanner" Grid.Row="2" Visibility="Collapsed" Margin="16,0,16,8" Padding="12,8" Background="{StaticResource Brush.Warn.Tint}" CornerRadius="{StaticResource Radius.Control}">
            <TextBlock x:Name="OfflineText" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Warn}" TextTrimming="CharacterEllipsis" />
          </Border>
          <!-- replying / editing -->
          <Border x:Name="ModeBar" Grid.Row="3" Visibility="Collapsed" Margin="16,0,16,8" Padding="12,4,4,4" Background="{StaticResource Brush.Surface2}"
                  CornerRadius="{StaticResource Radius.Control}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE711;"
                      Click="CancelMode_Click" ToolTip="Cancel (Esc)" />
              <TextBlock x:Name="ModeText" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>

          <!-- the composer: a raised Surface2 (radius 12, top highlight, soft shadow); 1 px accent while it has focus -->
          <Border x:Name="ComposerBox" Grid.Row="4" Margin="16,0,16,16" Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Card}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1"
                  Padding="4" Effect="{StaticResource Elevation.1}">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <Button x:Name="AttachButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE710;" Click="Plus_Click"
                      ToolTip="Share a file or post a sign-up card (files can also be dropped here, or pasted with Ctrl+V)" />
              <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE724;" Foreground="{StaticResource Brush.Accent}" Click="Send_Click" ToolTip="Send (Enter)" />
              <Grid>
                <TextBlock x:Name="ComposerHint" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False" />
                <TextBox x:Name="Composer" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Text.Primary}" CaretBrush="{StaticResource Brush.Text.Primary}"
                         FontSize="13" TextWrapping="Wrap" AcceptsReturn="False" MaxLength="2000" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center" Padding="4,8" SelectionBrush="{StaticResource Brush.Accent}"
                         PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged" />
              </Grid>
            </DockPanel>
          </Border>

          <!-- the "Looking for group" form -->
          <Border x:Name="LfgOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" MouseLeftButtonDown="LfgScrim_Down">
            <Border x:Name="LfgBox" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}"
                    Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Elevation.2}"
                    MouseLeftButtonDown="LfgBox_Down">
              <StackPanel>
                <TextBlock Text="Looking for group" Style="{StaticResource Text.Section}" />
                <TextBlock x:Name="LfgWhere" Style="{StaticResource Text.Secondary}" Margin="0,4,0,16" />
                <TextBlock Text="Instance or title" Style="{StaticResource Text.Caption}" />
                <TextBox x:Name="LfgTitle" Style="{StaticResource Input}" MaxLength="60" Margin="0,4,0,0" TextChanged="LfgTitle_Changed" KeyDown="Lfg_KeyDown" />
                <ItemsControl x:Name="LfgSuggest" Margin="0,8,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Tag="{Binding}" Style="{StaticResource Button.S}" Margin="0,0,8,8" Click="LfgSuggest_Click" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="When" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                <Border Style="{StaticResource SegmentHost}" Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LfgNow" Style="{StaticResource Segment}" Content="Now" GroupName="lfgwhen" IsChecked="True" Checked="LfgWhen_Changed" />
                    <RadioButton x:Name="LfgLater" Style="{StaticResource Segment}" Content="At a set time" GroupName="lfgwhen" Checked="LfgWhen_Changed" />
                  </StackPanel>
                </Border>
                <StackPanel x:Name="LfgTimeRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                  <ComboBox x:Name="LfgDay" Style="{StaticResource Dropdown}" Width="152" />
                  <TextBlock Text="at" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,12,0" />
                  <ComboBox x:Name="LfgHour" Style="{StaticResource Dropdown}" Width="64" />
                  <TextBlock Text=":" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,8,0" />
                  <ComboBox x:Name="LfgMinute" Style="{StaticResource Dropdown}" Width="64" />
                </StackPanel>
                <TextBlock Text="Places" Style="{StaticResource Text.Caption}" Margin="0,16,0,0" />
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Tank" Style="{StaticResource Text.Secondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Button Style="{StaticResource IconButton}" Content="&#xE738;" Tag="tank:-1" Click="LfgStep_Click" ToolTip="One less" />
                      <TextBlock x:Name="LfgTankN" Text="1" Style="{StaticResource Text.Body}" Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                      <Button Style="{StaticResource IconButton}" Content="&#xE710;" Tag="tank:1" Click="LfgStep_Click" ToolTip="One more" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Healer" Style="{StaticResource Text.Secondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Button Style="{StaticResource IconButton}" Content="&#xE738;" Tag="healer:-1" Click="LfgStep_Click" ToolTip="One less" />
                      <TextBlock x:Name="LfgHealerN" Text="1" Style="{StaticResource Text.Body}" Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                      <Button Style="{StaticResource IconButton}" Content="&#xE710;" Tag="healer:1" Click="LfgStep_Click" ToolTip="One more" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DPS" Style="{StaticResource Text.Secondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Button Style="{StaticResource IconButton}" Content="&#xE738;" Tag="dps:-1" Click="LfgStep_Click" ToolTip="One less" />
                      <TextBlock x:Name="LfgDpsN" Text="3" Style="{StaticResource Text.Body}" Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                      <Button Style="{StaticResource IconButton}" Content="&#xE710;" Tag="dps:1" Click="LfgStep_Click" ToolTip="One more" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Note (optional)" Style="{StaticResource Text.Caption}" Margin="0,16,0,0" />
                <TextBox x:Name="LfgNote" Style="{StaticResource Input}" MaxLength="200" Margin="0,4,0,0" KeyDown="Lfg_KeyDown" />
                <TextBlock x:Name="LfgError" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                  <Button Content="Cancel" Style="{StaticResource Button.M}" Click="LfgCancelForm_Click" />
                  <Button x:Name="LfgPost" Content="Post it" Style="{StaticResource Button.Primary.M}" Margin="8,0,0,0" Click="LfgPost_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </Border>
    </Grid>
    </Border>

    <!-- search (the magnifier in the channel header): one box, results grouped by channel. Popovers are Surface3 + hairline + Elevation.2,
         with a 24 px transparent margin that holds the shadow (the offsets in code give it back). -->
    <Popup x:Name="SearchPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="None" VerticalOffset="-18" Opened="SearchPopup_Opened">
      <Border x:Name="SearchBoxCard" Style="{StaticResource PopupCard}" Padding="12" Width="400">
        <StackPanel>
          <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Tag="Search messages in the channels you can see" MaxLength="64" KeyDown="SearchBox_KeyDown" />
          <TextBlock x:Name="SearchHint" Style="{StaticResource Text.Caption}" Margin="4,8,0,0" TextWrapping="Wrap" />
          <ScrollViewer x:Name="SearchScroll" MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <ItemsControl x:Name="SearchList" ItemTemplate="{StaticResource SearchGroup}" />
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>

    <!-- the composer's "+" menu -->
    <Popup x:Name="PlusPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True" PopupAnimation="None" VerticalOffset="18">
      <Border Style="{StaticResource PopupCard}" Padding="8" Width="220">
        <StackPanel>
          <Button x:Name="PlusFile" Style="{StaticResource MenuRow}" Click="PlusFile_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE723;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock Text="Share a file" /></StackPanel>
          </Button>
          <Button x:Name="PlusLfg" Style="{StaticResource MenuRow}" Click="PlusLfg_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE902;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock Text="Looking for group" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- message menu (More button / right click) -->
    <Popup x:Name="MsgMenu" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True" PopupAnimation="None" HorizontalOffset="-24" VerticalOffset="-24">
      <Border x:Name="MsgMenuBox" Style="{StaticResource PopupCard}" Padding="8" Width="208">
        <StackPanel>
          <Button x:Name="MenuReply" Style="{StaticResource MenuRow}" Click="MenuReply_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE97A;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock Text="Reply" /></StackPanel>
          </Button>
          <Button x:Name="MenuReact" Style="{StaticResource MenuRow}" Click="MenuReact_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE899;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock Text="Add reaction" /></StackPanel>
          </Button>
          <Button x:Name="MenuPin" Style="{StaticResource MenuRow}" Click="MenuPin_Click">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="MenuPinGlyph" Text="&#xE718;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock x:Name="MenuPinText" Text="Pin message" /></StackPanel>
          </Button>
          <Button x:Name="MenuCopy" Style="{StaticResource MenuRow}" Click="MenuCopy_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock Text="Copy text" /></StackPanel>
          </Button>
          <Button x:Name="MenuEdit" Style="{StaticResource MenuRow}" Click="MenuEdit_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock Text="Edit" /></StackPanel>
          </Button>
          <Button x:Name="MenuDelete" Style="{StaticResource MenuRow}" Click="MenuDelete_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Danger}" /><TextBlock Text="Delete" Foreground="{StaticResource Brush.Danger}" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- reaction picker: the eight (2.4) or six (2.3) the server allows, 4 per row -->
    <Popup x:Name="ReactPopup" StaysOpen="False" Placement="Left" AllowsTransparency="True" PopupAnimation="None" HorizontalOffset="10" VerticalOffset="-24">
      <Border x:Name="ReactPickerBox" Style="{StaticResource PopupCard}" Padding="8">
        <ItemsControl x:Name="ReactItems">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource IconButton}" Width="40" Height="40" Margin="2" Tag="{Binding Id}" ToolTip="{Binding Name}" Click="ReactPick_Click">
                <Grid>
                  <Image Source="{Binding Icon}" Width="28" Height="28" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="{Binding Id}" FontFamily="Segoe UI Emoji" FontSize="15" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding TextVisibility}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Popup>

    <!-- pinned messages of this channel -->
    <Popup x:Name="PinPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="None" VerticalOffset="-18">
      <Border x:Name="PinBox" Style="{StaticResource PopupCard}" Padding="8" Width="344">
        <StackPanel>
          <TextBlock x:Name="PinTitle" Text="Pinned messages" Style="{StaticResource Text.Caption}" Margin="8,4,0,4" />
          <TextBlock x:Name="PinEmpty" Text="Nothing pinned yet. Officers can pin from a message's menu." Style="{StaticResource Text.Secondary}"
                     TextWrapping="Wrap" Margin="8,4,8,8" />
          <ScrollViewer MaxHeight="328" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PinList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ContentControl Style="{StaticResource Side.Row}" Padding="8,8" Tag="{Binding}" MouseLeftButtonUp="PinRow_Click">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE77A;" ToolTip="Unpin"
                              VerticalAlignment="Top" Tag="{Binding}" Click="PinRemove_Click" Visibility="{Binding UnpinVisibility}" />
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding ByShown}" Style="{StaticResource Text.RowTitle}" Foreground="{Binding Color}" />
                          <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Shown}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                      </StackPanel>
                    </DockPanel>
                  </ContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>

    <!-- status picker -->
    <Popup x:Name="StatusPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True" PopupAnimation="None" VerticalOffset="18">
      <Border x:Name="StatusBox" Style="{StaticResource PopupCard}" Padding="8" Width="256">
        <StackPanel>
          <Button Style="{StaticResource MenuRow}" Click="EditProfile_Click" ToolTip="Display name, avatar, about text, characters, privacy">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource Font.Icons}" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="16" Width="28" /><TextBlock Text="Edit profile..." /></StackPanel>
          </Button>
          <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="8,4,8,4" />
          <TextBlock Text="Set your status" Style="{StaticResource Text.Caption}" Margin="8,4,0,4" />
          <Button Style="{StaticResource MenuRow}" Tag="online" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{StaticResource Brush.Accent}" Margin="8,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Online" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="away" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE708;" FontFamily="{StaticResource Font.Icons}" Foreground="{StaticResource Brush.Warn}" FontSize="16" Width="28" /><TextBlock Text="AFK" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="busy" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE738;" FontFamily="{StaticResource Font.Icons}" Foreground="{StaticResource Brush.Danger}" FontSize="16" Width="28" /><TextBlock Text="Busy" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="dungeon" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icons}" Foreground="{StaticResource Brush.Dungeon}" FontSize="16" Width="28" /><TextBlock Text="In a dungeon" /></StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Tag="lfg" Click="StatusOption_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="{StaticResource Font.Icons}" Foreground="{StaticResource Brush.Info}" FontSize="16" Width="28" /><TextBlock Text="Looking for group" /></StackPanel>
          </Button>
          <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="8,4,8,4" />
          <Button Style="{StaticResource MenuRow}" Tag="invisible" Click="StatusOption_Click" ToolTip="Stay connected, but nobody sees you online">
            <DockPanel>
              <TextBlock x:Name="InvisibleCheck" DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" Foreground="{StaticResource Brush.Accent}" FontSize="12"
                         VerticalAlignment="Center" Visibility="Collapsed" />
              <Ellipse Width="12" Height="12" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="2" Margin="8,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Appear offline" />
            </DockPanel>
          </Button>
          <TextBox x:Name="NoteBox" Style="{StaticResource Input}" Tag="What are you up to? (optional)" Margin="0,8,0,0" MaxLength="40" KeyDown="NoteBox_KeyDown" />
          <TextBlock Text="Enter saves the note" Style="{StaticResource Text.Caption}" Margin="8,4,0,0" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- person: the profile card, then what you can do with them (mention, join their room, volume, officer tools) -->
    <Popup x:Name="MemberPopup" StaysOpen="False" Placement="Right" AllowsTransparency="True" PopupAnimation="None" HorizontalOffset="-18" VerticalOffset="-24">
      <Border Style="{StaticResource PopupCard}" BorderThickness="0">
        <StackPanel Width="300">
          <ContentControl x:Name="PopCard" ContentTemplate="{StaticResource ProfileCard}" />
          <StackPanel Margin="16,0,16,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Button x:Name="PopMention" Style="{StaticResource Button.S}" Content="Mention" Click="PopMention_Click" ToolTip="Put @name in your message" />
              <Button x:Name="PopJoin" Style="{StaticResource Button.S}" Content="Join their voice room" Margin="8,0,0,0" Click="PopJoin_Click" />
              <Button x:Name="PopBadges" Style="{StaticResource Button.S}" Content="Badges" Margin="8,0,0,0" Click="PopBadges_Click" ToolTip="Everything this person has earned" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="PopVolumeArea" Margin="0,12,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="PopVolumeText" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="Volume" Style="{StaticResource Text.Secondary}" />
              </DockPanel>
              <Slider x:Name="PopVolume" Minimum="0" Maximum="2" Margin="0,8,0,0" ValueChanged="PopVolume_Changed" />
            </StackPanel>
            <StackPanel x:Name="PopModArea" Margin="-8,8,0,0">
              <Button x:Name="PopMute" Style="{StaticResource MenuRow}" Click="PopMute_Click" />
              <Button Style="{StaticResource MenuRow}" Click="PopKick_Click">
                <TextBlock Text="Kick from the lodge" Foreground="{StaticResource Brush.Danger}" />
              </Button>
            </StackPanel>
            <Button x:Name="PopDeviceLink" Style="{StaticResource MenuRow}" Margin="-8,0,0,0" Click="PopDeviceLink_Click" Visibility="Collapsed"
                    ToolTip="Makes a one-time link that adds another PC for this person (they keep their rank)">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Width="28" Foreground="{StaticResource Brush.Text.Tertiary}" /><TextBlock Text="Send a new device link" /></StackPanel>
            </Button>
            <Button x:Name="PopReset" Style="{StaticResource MenuRow}" Margin="-8,0,0,0" Click="PopReset_Click" ToolTip="Guild Master: put their avatar, accent and display name back to the default">
              <TextBlock Text="Reset profile look to default" Foreground="{StaticResource Brush.Danger}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>


    <!-- in-app picture viewer (covers the whole Lodge) -->
    <local:ImageViewer x:Name="Viewer" Grid.RowSpan="9" Grid.ColumnSpan="9" />
    <local:VideoViewer x:Name="VideoPlayer" Grid.RowSpan="9" Grid.ColumnSpan="9" />
    <local:InviteSheet x:Name="InviteSheetHost" Grid.RowSpan="9" Grid.ColumnSpan="9" />
    <local:CreateLodgeGuide x:Name="CreateGuide" Grid.RowSpan="9" Grid.ColumnSpan="9" />
    <!-- a person's badges (server feature "badges"): the Ladder's "Your badges" and the profile card's Badges button. Everything earned, and for you how to earn the rest. -->
    <Border x:Name="BadgesOverlay" Grid.RowSpan="9" Grid.ColumnSpan="9" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}" MouseLeftButtonDown="BadgesScrim_Down">
      <Border Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}"
              Width="520" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Elevation.2}" MouseLeftButtonDown="BadgesBox_Down">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24,24,0">
            <StackPanel>
              <TextBlock x:Name="BadgesHeading" Style="{StaticResource Text.Section}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="BadgesSub" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,16" />
              <local:BadgesPanel x:Name="BadgesList" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,24">
            <Button Content="Done" Style="{StaticResource Button.M}" Click="BadgesClose_Click" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
