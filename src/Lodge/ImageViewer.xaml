<UserControl x:Class="ElansAddonHub.Lodge.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" Panel.ZIndex="100"
             PreviewKeyDown="OnKeyDown" SizeChanged="OnSizeChanged">
  <UserControl.Resources>
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#E8E8E8" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="12,5">
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#59FFFFFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundGlyph" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Background" Value="#40000000" />
    </Style>
  </UserControl.Resources>

  <!-- backdrop (~85% black); a click on it closes the viewer -->
  <Grid x:Name="Backdrop" Background="#D9000000" MouseLeftButtonDown="Backdrop_Down" MouseWheel="OnWheel">
    <Grid Margin="64,56,64,64" Background="Transparent" IsHitTestVisible="False">
      <Image x:Name="Img" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly"
             RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
        <Image.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            <TranslateTransform x:Name="Move" />
          </TransformGroup>
        </Image.RenderTransform>
      </Image>
    </Grid>
    <!-- hit surface for the picture itself: sits over the whole viewport so pan/double-click work, backdrop clicks close -->
    <Grid x:Name="Hit" Margin="64,56,64,64" Background="Transparent" Cursor="Arrow"
          MouseLeftButtonDown="Hit_Down" MouseMove="Hit_Move" MouseLeftButtonUp="Hit_Up" />
    <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E06C6C" FontSize="14"
               Visibility="Collapsed" IsHitTestVisible="False" />

    <!-- top bar -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0">
      <Button Style="{StaticResource Pill}" Content="Open original" Click="OpenOriginal_Click" ToolTip="Open in the default app (animations play there)" />
      <Button Style="{StaticResource Pill}" Content="Save as..." Click="SaveAs_Click" />
      <Button Style="{StaticResource Pill}" Content="Copy image" Click="Copy_Click" />
      <Button Style="{StaticResource RoundGlyph}" Content="&#xE711;" Width="30" Height="30" FontSize="12" Click="Close_Click" ToolTip="Close (Esc)" Margin="6,0,0,0" />
    </StackPanel>

    <!-- arrows -->
    <Button x:Name="PrevBtn" Style="{StaticResource RoundGlyph}" Content="&#xE76B;" HorizontalAlignment="Left" VerticalAlignment="Center"
            Margin="14,0,0,0" Click="Prev_Click" ToolTip="Previous image (Left)" />
    <Button x:Name="NextBtn" Style="{StaticResource RoundGlyph}" Content="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"
            Margin="0,0,14,0" Click="Next_Click" ToolTip="Next image (Right)" />

    <!-- caption -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" IsHitTestVisible="False">
      <TextBlock x:Name="CapName" Foreground="#F0F0F0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="700" />
      <TextBlock x:Name="CapInfo" Foreground="#A8A8A8" FontSize="11.5" HorizontalAlignment="Center" Margin="0,2,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
