<UserControl x:Class="ElansAddonHub.Lodge.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" Panel.ZIndex="100"
             PreviewKeyDown="OnKeyDown" SizeChanged="OnSizeChanged">
  <UserControl.Resources>
    <!-- a 28 high pill over the picture: Chip veil, text Secondary -> Primary, pressed veil -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Background" Value="{StaticResource Brush.Overlay.Chip}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" Height="28" Padding="12,0">
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Overlay.Pressed}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundGlyph" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      <Setter Property="Background" Value="{StaticResource Brush.Scrim.Glass}" />
    </Style>
  </UserControl.Resources>

  <!-- backdrop (Scrim.Strong, ~85% black); a click on it closes the viewer -->
  <Grid x:Name="Backdrop" Background="{StaticResource Brush.Scrim.Strong}" MouseLeftButtonDown="Backdrop_Down" MouseWheel="OnWheel">
    <Grid x:Name="Stage" Margin="64,56,64,64" Background="Transparent" IsHitTestVisible="False">
      <Image x:Name="Img" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly"
             RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
        <Image.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            <TranslateTransform x:Name="Move" />
          </TransformGroup>
        </Image.RenderTransform>
      </Image>
    </Grid>
    <!-- hit surface for the picture itself: sits over the whole viewport so pan/double-click work, backdrop clicks close -->
    <Grid x:Name="Hit" Margin="64,56,64,64" Background="Transparent" Cursor="Arrow"
          MouseLeftButtonDown="Hit_Down" MouseMove="Hit_Move" MouseLeftButtonUp="Hit_Up" />
    <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.Section}"
               Visibility="Collapsed" IsHitTestVisible="False" />

    <!-- top bar -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
      <Button Style="{StaticResource Pill}" Content="Open original" Click="OpenOriginal_Click" ToolTip="Open in the default app (animations play there)" />
      <Button Style="{StaticResource Pill}" Content="Save as..." Click="SaveAs_Click" />
      <Button Style="{StaticResource Pill}" Content="Copy image" Click="Copy_Click" />
      <Button Style="{StaticResource RoundGlyph}" Content="&#xE711;" Width="32" Height="32" FontSize="12" Click="Close_Click" ToolTip="Close (Esc)" Margin="4,0,0,0" />
    </StackPanel>

    <!-- arrows -->
    <Button x:Name="PrevBtn" Style="{StaticResource RoundGlyph}" Content="&#xE76B;" HorizontalAlignment="Left" VerticalAlignment="Center"
            Margin="16,0,0,0" Click="Prev_Click" ToolTip="Previous image (Left)" />
    <Button x:Name="NextBtn" Style="{StaticResource RoundGlyph}" Content="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"
            Margin="0,0,16,0" Click="Next_Click" ToolTip="Next image (Right)" />

    <!-- caption -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" IsHitTestVisible="False">
      <TextBlock x:Name="CapName" Style="{StaticResource Text.RowTitle}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="704" />
      <TextBlock x:Name="CapInfo" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
