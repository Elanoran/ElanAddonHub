<Window x:Class="ElansAddonHub.Lodge.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ElansAddonHub.Lodge"
        Title="Lodge overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <!-- who's in voice, over the game; the speaking person lights up. Click-through (see code). -->
  <ItemsControl x:Name="People" Margin="6">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Grid x:Name="row" Visibility="{Binding OverlayVisibility}" Margin="0,0,0,6" HorizontalAlignment="Left" Opacity="0.6">
        <Border x:Name="pill" Padding="3,3,11,3" CornerRadius="16" Background="#B3101214" BorderThickness="1.5" BorderBrush="{Binding FrameBrush}">
          <StackPanel Orientation="Horizontal">
            <local:AvatarView Width="26" Height="26" Decor="True" RankRing="False" />
            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"
                       Opacity="{Binding NameOpacity}">
              <TextBlock.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9" Color="Black" />
              </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding StateGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#E06C6C"
                       Margin="7,1,0,0" VerticalAlignment="Center" Visibility="{Binding MutedVisibility}" />
          </StackPanel>
        </Border>
                  <!-- rank frame: a glow for officers and up, an animated shimmer for the guild master -->
                  <Border CornerRadius="16" BorderThickness="1.5" BorderBrush="{Binding FrameBrush}" IsHitTestVisible="False"
                          Visibility="{Binding GlowVisibility}">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="{Binding FrameColor}" />
                    </Border.Effect>
                  </Border>
                  <Border CornerRadius="16" BorderThickness="2" IsHitTestVisible="False" Visibility="{Binding ShimmerVisibility}">
                    <Border.BorderBrush>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                          <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF8000" Offset="0" />
                        <GradientStop Color="#FFD27A" Offset="0.45" />
                        <GradientStop Color="#FF8000" Offset="0.55" />
                        <GradientStop Color="#B85800" Offset="1" />
                      </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(Brush.RelativeTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:3" />
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Border.Triggers>
                  </Border>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Speaking}" Value="True">
            <Setter TargetName="row" Property="Opacity" Value="1" />
            <Setter TargetName="pill" Property="Background" Value="#E6101214" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</Window>
