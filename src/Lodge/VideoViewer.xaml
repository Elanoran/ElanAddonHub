<UserControl x:Class="ElansAddonHub.Lodge.VideoViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" Panel.ZIndex="101"
             PreviewKeyDown="OnKeyDown" SizeChanged="OnSizeChanged">
  <UserControl.Resources>
    <Style x:Key="RoundGlyph" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Background" Value="#40000000" />
    </Style>
  </UserControl.Resources>

  <!-- same scrim as the picture viewer; a click outside the player closes it -->
  <Grid x:Name="Backdrop" Background="#D9000000" MouseLeftButtonDown="Backdrop_Down">
    <!-- the 16:9 stage; the WebView2 is created into it when the viewer opens (and disposed on close) -->
    <Grid x:Name="Stage" Margin="64,56,64,64" Background="Transparent" MouseLeftButtonDown="Stage_Down">
      <Border x:Name="Box" Background="#FF000000" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" Height="360">
        <TextBlock x:Name="Status" Text="Loading the player..." Style="{StaticResource Text.Secondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <StackPanel x:Name="Header" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0">
      <Button Style="{StaticResource RoundGlyph}" Content="&#xE8A7;" Width="30" Height="30" FontSize="12" Click="OpenYt_Click" ToolTip="Open on YouTube" />
      <Button Style="{StaticResource RoundGlyph}" Content="&#xE711;" Width="30" Height="30" FontSize="12" Click="Close_Click" ToolTip="Close (Esc)" Margin="8,0,0,0" />
    </StackPanel>

    <StackPanel x:Name="Caption" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" IsHitTestVisible="False">
      <TextBlock x:Name="CapName" Style="{StaticResource Text.RowTitle}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="700" />
      <TextBlock x:Name="CapInfo" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
