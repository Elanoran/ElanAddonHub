<UserControl x:Class="ElansAddonHub.Lodge.InviteSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub.Lodge"
             PreviewKeyDown="Sheet_KeyDown">
  <!-- The Invite sheet (Lodge sidebar, owners and officers): an overlay card (Surface3, hairline, radius 14, padding 24, Elevation.2) over a Scrim,
       like the Looking-for-group form. It holds the same InviteForm and InviteListView the Guild Master page uses. -->
  <Border x:Name="Overlay" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}" MouseLeftButtonDown="Scrim_Down">
    <Border x:Name="Box" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}"
            Width="460" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Elevation.2}" MouseLeftButtonDown="Box_Down">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE711;" Click="Close_Click" ToolTip="Close (Esc)" AutomationProperties.Name="Close" />
            <TextBlock Text="Invite someone" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="Where" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,16" />
          <local:InviteForm x:Name="Form" ShowServerErrors="True" />
          <TextBlock x:Name="PendingHeader" Text="Open invites" Style="{StaticResource Text.Caption}" Margin="0,24,0,0" />
          <local:InviteListView x:Name="Pending" PendingOnly="True" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Border>
</UserControl>
