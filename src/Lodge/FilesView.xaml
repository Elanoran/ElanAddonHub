<UserControl x:Class="ElansAddonHub.Lodge.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub.Lodge"
             xmlns:app="clr-namespace:ElansAddonHub">
  <UserControl.Resources>
    <DataTemplate x:Key="GroupHead">
      <StackPanel Orientation="Horizontal" Margin="4,12,0,6">
        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.RowTitle}" />
        <TextBlock Text="{Binding ItemCount}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <local:FileColumns x:Key="Cols" />
    <!-- 3.5.6: one item in the Content view (replaces the Tiles cards): a list row with more to read than Details - the picture as a thumbnail,
         name and chips, one meta line (kind, version, size, date, who), the description or the text's first line, the addon's folders and game
         version, what is in WoW, who has it, warnings and the newest version's note; the buttons under it, always shown. Click selects, double-click opens. -->
    <DataTemplate x:Key="SlotContent">
      <Border Background="{Binding RowBackground}" CornerRadius="{StaticResource Radius.Card}" Padding="12" Margin="0,0,0,8"
              Tag="{Binding}" MouseLeftButtonDown="Row_Down" AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Grid.RowSpan="2" Width="96" Height="64" VerticalAlignment="Top" Margin="0,0,14,0">
            <Border Background="{StaticResource Brush.Surface3}" CornerRadius="{StaticResource Radius.Control}" />
            <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource Font.Icons}" FontSize="22" Foreground="{StaticResource Brush.Text.Tertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}" />
            <Border CornerRadius="{StaticResource Radius.Control}" Visibility="{Binding CoverVisibility}">
              <Border.Background><ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" /></Border.Background>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <WrapPanel>
              <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Info}" Visibility="{Binding BadgeVisibility}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding BadgeTip}" AutomationProperties.Name="{Binding Badge}" />
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.RowTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border Style="{StaticResource Chip}" Visibility="{Binding SeeChipVisibility}" ToolTip="{Binding SeeLine}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="{Binding SeeChip}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding ContentMeta}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            <TextBlock Text="{Binding DescShort}" Visibility="{Binding DescVisibility}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Desc}" />
            <TextBlock Text="{Binding TextFirstLine}" Visibility="{Binding TextFirstLineVisibility}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
            <TextBlock Text="{Binding AddonLine}" Visibility="{Binding AddonLineVisibility}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding AddonInfo}" />
            <TextBlock Text="{Binding InstalledLine}" Visibility="{Binding InstalledLineVisibility}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            <TextBlock Text="{Binding HaveLine}" Visibility="{Binding HaveVisibility}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            <TextBlock Text="{Binding AddonWarn}" Visibility="{Binding AddonWarnVisibility}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Warn}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding AddonWarn}" />
            <TextBlock Text="{Binding NoteLine}" Visibility="{Binding NoteLineVisibility}" Style="{StaticResource Text.Caption}" FontStyle="Italic" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding NoteLine}" />
            <StackPanel Visibility="{Binding ProgressVisibility}" Margin="0,8,0,0">
              <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Value="{Binding Progress}" />
              <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
          <!-- the buttons: under the text, or (a wide list) at the top right, beside the name -->
          <WrapPanel x:Name="buttons" Grid.Column="1" Grid.Row="1" Margin="0,10,0,0" IsEnabled="{Binding IdleEnabled}">
            <Button Content="{Binding InstallLabel}" Style="{StaticResource Button.Primary.S}" Tag="{Binding}" Click="Install_Click" Visibility="{Binding InstallVisibility}" Margin="0,0,6,0"
                    ToolTip="{Binding InstallTip}" AutomationProperties.Name="Install in WoW" />
            <Button Content="Copy" Style="{StaticResource Button.Primary.S}" Tag="{Binding}" Click="Copy_Click" Visibility="{Binding CopyVisibility}" Margin="0,0,6,0"
                    ToolTip="{Binding KindChipTip}" AutomationProperties.Name="Copy" />
            <Button Content="Save..." Style="{StaticResource Button.S}" Tag="{Binding}" Click="Save_Click" Visibility="{Binding SaveCardVisibility}" Margin="0,0,6,0"
                    ToolTip="Save the newest version to this PC" AutomationProperties.Name="Save" />
            <Button Content="Details" Style="{StaticResource Button.S}" Tag="{Binding}" Click="Versions_Click" ToolTip="Description, versions and settings" AutomationProperties.Name="Details" />
          </WrapPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ContentWide, Source={StaticResource Cols}}" Value="True">
          <Setter TargetName="buttons" Property="Grid.Column" Value="2" />
          <Setter TargetName="buttons" Property="Grid.Row" Value="0" />
          <Setter TargetName="buttons" Property="Margin" Value="16,0,0,0" />
          <Setter TargetName="buttons" Property="VerticalAlignment" Value="Top" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- one kit (2.36): a named set of files - its addons install and stay updated together -->
    <DataTemplate x:Key="KitCard">
      <Border Width="296" Background="{StaticResource Brush.Surface2}" BorderBrush="{StaticResource Brush.Section.Character}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
              Padding="14" Margin="0,0,12,12" AutomationProperties.Name="{Binding Name}" Tag="kit-card">
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Visibility="{Binding SeeChipVisibility}" VerticalAlignment="Center" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding SeeChip}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Section.Character}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Desc}" Visibility="{Binding DescVisibility}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
          <TextBlock Text="{Binding CountLine}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding FileNames}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileNames}" />
          <TextBlock Text="{Binding StateLine}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <WrapPanel Margin="0,12,0,0">
            <Button Content="{Binding InstallAllLabel}" Style="{StaticResource Button.Primary.S}" Tag="{Binding}" Click="KitInstall_Click" Visibility="{Binding InstallAllVisibility}" Margin="0,0,8,8"
                    ToolTip="Install the kit's addons in WoW Forever (asks once, backs up what you have)" AutomationProperties.Name="Install all" />
            <Button Content="Edit" Style="{StaticResource Button.S}" Tag="{Binding}" Click="KitEdit_Click" Visibility="{Binding ManageVisibility}" Margin="0,0,8,8" AutomationProperties.Name="Edit kit" />
            <Button Content="Delete" Style="{StaticResource GhostButton}" Height="28" Tag="{Binding}" Click="KitDelete_Click" Visibility="{Binding ManageVisibility}" Margin="0,0,8,8"
                    ToolTip="Remove the kit (its files stay)" AutomationProperties.Name="Delete kit" />
            <CheckBox Style="{StaticResource Switch}" Content="Keep all updated" IsChecked="{Binding AutoAll, Mode=OneWay}" Tag="{Binding}" Click="KitAuto_Click" Visibility="{Binding AutoVisibility}" VerticalAlignment="Center" Margin="0,0,8,8"
                      AutomationProperties.Name="Keep all updated" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- one file in the Details view (3.5.2): a row like Explorer's - kind icon, name with its chips, the columns; the buttons show on the
         selected row and under the mouse. Click selects, double-click opens the details. -->
    <DataTemplate x:Key="SlotRow">
      <Border x:Name="row" Background="{Binding RowBackground}" CornerRadius="{StaticResource Radius.Control}" Padding="8,4" Margin="0,0,0,2" MinHeight="40"
              Tag="{Binding}" MouseLeftButtonDown="Row_Down" AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="180" />
            <ColumnDefinition Width="{Binding Kind, Source={StaticResource Cols}}" /><ColumnDefinition Width="{Binding Version, Source={StaticResource Cols}}" />
            <ColumnDefinition Width="{Binding Size, Source={StaticResource Cols}}" /><ColumnDefinition Width="{Binding Updated, Source={StaticResource Cols}}" />
            <ColumnDefinition Width="{Binding By, Source={StaticResource Cols}}" /><ColumnDefinition Width="{Binding InWow, Source={StaticResource Cols}}" /><ColumnDefinition Width="210" />
          </Grid.ColumnDefinitions>
          <DockPanel VerticalAlignment="Center">
            <Grid Width="24" Height="24" Margin="0,0,10,0" DockPanel.Dock="Left">
              <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource Font.Icons}" FontSize="15" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding PlaceholderVisibility}" />
              <Border CornerRadius="4" Visibility="{Binding CoverVisibility}">
                <Border.Background><ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" /></Border.Background>
              </Border>
            </Grid>
            <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource Brush.Info}" Visibility="{Binding BadgeVisibility}" Margin="0,0,8,0" VerticalAlignment="Center"
                     ToolTip="{Binding BadgeTip}" AutomationProperties.Name="{Binding Badge}" />
            <TextBlock DockPanel.Dock="Right" Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center"
                       Margin="6,0,0,0" Visibility="{Binding SeeChipVisibility}" ToolTip="{Binding SeeLine}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Danger}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" />
              <ProgressBar Visibility="{Binding ProgressVisibility}" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Value="{Binding Progress}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding VersionText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,12,0" />
          <TextBlock Grid.Column="4" Text="{Binding UpdatedText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
          <TextBlock Grid.Column="5" Text="{Binding ByText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
          <TextBlock Grid.Column="6" Text="{Binding InWowText}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" ToolTip="{Binding InstalledLine}" />
          <StackPanel x:Name="actions" Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Hidden" IsEnabled="{Binding IdleEnabled}">
            <Button Content="{Binding InstallLabel}" Style="{StaticResource Button.Primary.S}" Tag="{Binding}" Click="Install_Click" Visibility="{Binding InstallVisibility}" Margin="0,0,6,0" AutomationProperties.Name="Install in WoW" />
            <Button Content="Copy" Style="{StaticResource Button.Primary.S}" Tag="{Binding}" Click="Copy_Click" Visibility="{Binding CopyVisibility}" Margin="0,0,6,0" AutomationProperties.Name="Copy" />
            <Button Content="Save..." Style="{StaticResource Button.S}" Tag="{Binding}" Click="Save_Click" Visibility="{Binding SaveCardVisibility}" Margin="0,0,6,0" AutomationProperties.Name="Save" />
            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Tag="{Binding}" Click="Versions_Click" ToolTip="Details" AutomationProperties.Name="Details">
              <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icons}" FontSize="13" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="actions" Property="Visibility" Value="Visible" /></DataTrigger>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="actions" Property="Visibility" Value="Visible" /></Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- one kept version in the details (shown when there are two or more): version, size, who and when, the note; Copy (text) or Save (files), Roll back -->
    <DataTemplate x:Key="VersionRow">
      <Border Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Content="Copy" Style="{StaticResource Button.S}" Tag="{Binding}" Click="VersionCopy_Click" Visibility="{Binding CopyVisibility}" Margin="0,0,8,0" AutomationProperties.Name="Copy this version" />
            <Button Content="Save..." Style="{StaticResource Button.S}" Tag="{Binding}" Click="VersionSave_Click" Visibility="{Binding SaveVisibility}" Margin="0,0,8,0" AutomationProperties.Name="Save this version" />
            <Button Content="Roll back" Style="{StaticResource GhostButton}" Height="28" Tag="{Binding}" Click="VersionRollBack_Click" Visibility="{Binding RollBackVisibility}"
                    ToolTip="Make this the newest version again (newer ones are removed)" AutomationProperties.Name="Roll back to this version" />
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Body}"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Line, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" /></TextBlock>
            <TextBlock Text="{Binding By}" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="Transparent" CornerRadius="{StaticResource Radius.Card}">
    <Grid>
      <Grid x:Name="Main">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- header: title, search, Add (officers and the owner) -->
        <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="16,8">
          <DockPanel MinHeight="32" SizeChanged="Head_SizeChanged">
            <Button x:Name="NewButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary.S}" Content="Add" Click="New_Click" Margin="8,0,0,0"
                    ToolTip="Add an addon, a file, or text to copy (a macro, a WeakAura, a profile) to the lodge's library" AutomationProperties.Name="Add to the library" Visibility="Collapsed" />
            <!-- the view switch, like Explorer's: Details (the list) and Content (taller rows with more to read) -->
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Margin="8,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ViewDetails" Style="{StaticResource Segment}" GroupName="files-view" Checked="View_Checked" ToolTip="Details" AutomationProperties.Name="Details view">
                  <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Font.Icons}" FontSize="13" />
                </RadioButton>
                <RadioButton x:Name="ViewTiles" Style="{StaticResource Segment}" GroupName="files-view" Checked="View_Checked" ToolTip="Content: more about each item" AutomationProperties.Name="Content view">
                  <TextBlock Text="&#xE179;" FontFamily="{StaticResource Font.Icons}" FontSize="13" />
                </RadioButton>
              </StackPanel>
            </Border>
            <!-- 3.5.4: grouped by type (Addons, WeakAuras & profiles, Macros, ...) like Explorer's Group by; remembered -->
            <CheckBox x:Name="GroupBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Group" Margin="12,0,4,0" Click="Group_Click"
                      ToolTip="Show the library in groups: addons, WeakAuras and profiles, macros, talent builds, guides, maps" AutomationProperties.Name="Group by type" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Style="{StaticResource Input}" Width="180" Tag="Search the library" TextChanged="Search_Changed"
                     AutomationProperties.Name="Search the library" Visibility="Collapsed" />
            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Library" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <!-- 3.5.5: kits, chips and the column heads stay on top; the list scrolls on its own and builds only the rows on screen (a Library of
             300 froze the window half a second on open, sort and Group: Tools\selftest.ps1 -Speed) -->
        <Grid Grid.Row="1" Margin="24,16,12,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
              <StackPanel x:Name="KitsSection" Visibility="Collapsed">
                <DockPanel Margin="0,0,12,8">
                  <Button x:Name="NewKitButton" DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="New kit" Click="NewKit_Click" Visibility="Collapsed"
                          ToolTip="Put several files together, like a raid night kit" />
                  <TextBlock Text="Kits" Style="{StaticResource Text.RowTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="KitList" ItemTemplate="{StaticResource KitCard}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="KitsEmpty" Text="No kits yet. A kit puts several addons and files together, so members install them with one click." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Everything shared" Style="{StaticResource Text.RowTitle}" Margin="0,4,0,8" />
              </StackPanel>
              <WrapPanel x:Name="CatChips" Visibility="Collapsed" Margin="0,0,0,12" />
          </StackPanel>
          <!-- Details: the header (click a column to sort) and the rows -->
          <Grid x:Name="DetailsList" Grid.Row="1" Visibility="Collapsed" SizeChanged="DetailsList_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="ColumnHeads" Margin="8,0,20,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="180" />
                  <ColumnDefinition Width="{Binding Kind, Source={StaticResource Cols}}" /><ColumnDefinition Width="{Binding Version, Source={StaticResource Cols}}" />
                  <ColumnDefinition Width="{Binding Size, Source={StaticResource Cols}}" /><ColumnDefinition Width="{Binding Updated, Source={StaticResource Cols}}" />
                  <ColumnDefinition Width="{Binding By, Source={StaticResource Cols}}" /><ColumnDefinition Width="{Binding InWow, Source={StaticResource Cols}}" /><ColumnDefinition x:Name="ActionsCol" Width="210" />
                </Grid.ColumnDefinitions>
              </Grid>
            <ItemsControl x:Name="SlotRows" Grid.Row="1" ItemTemplate="{StaticResource SlotRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="0,0,12,16" app:Motion.EdgeFade="True"><ItemsPresenter /></ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GroupHead}" /></ItemsControl.GroupStyle>
            </ItemsControl>
          </Grid>
          <!-- Content (3.5.6): taller rows with more to read; a list too, so only the rows on screen are built -->
          <ItemsControl x:Name="SlotList" Grid.Row="1" Visibility="Collapsed" SizeChanged="SlotList_SizeChanged" ItemTemplate="{StaticResource SlotContent}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="0,0,12,16" app:Motion.EdgeFade="True"><ItemsPresenter /></ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GroupHead}" /></ItemsControl.GroupStyle>
          </ItemsControl>
          <Grid Grid.Row="1">
              <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,48,0,0" Visibility="Collapsed">
                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Font.Icons}" FontSize="32" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Text="No files shared yet" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
          </Grid>
          <TextBlock x:Name="UsageText" Grid.Row="2" Style="{StaticResource Text.Caption}" Margin="0,8,0,12" />
        </Grid>
      </Grid>

      <!-- ===== details (3.5.8): name and kind with a close button; the main thing with its one main button (a text's preview with Copy, an addon's
           Install, a file's Save); the description; two fact lines; the addon's folders and state; the versions only when there is a choice;
           New version / Edit at the bottom left and Delete in red at the bottom right, for those who may ===== -->
      <Border x:Name="VersionsOverlay" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" MouseLeftButtonDown="Scrim_Down">
        <Border x:Name="DetailsCard" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}"
                MaxWidth="560" MaxHeight="700" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" Effect="{StaticResource Elevation.2}" MouseLeftButtonDown="Box_Down" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Height="200" Visibility="{Binding CoverVisibility}">
                  <Border.Background><ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" /></Border.Background>
                </Border>
                <StackPanel Margin="24,18,16,8">
                  <!-- header -->
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Click="VersionsClose_Click" ToolTip="Close (Esc)" AutomationProperties.Name="Close" VerticalAlignment="Top">
                      <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                    </Button>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,8,0">
                      <TextBlock x:Name="VersionsHeading" Text="{Binding Name}" Style="{StaticResource Text.Section}" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <Border Style="{StaticResource Chip}" Visibility="{Binding KindChipVisibility}" ToolTip="{Binding KindChipTip}" Margin="0,2,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindChip}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                      </Border>
                      <Border Style="{StaticResource Chip}" Visibility="{Binding SeeChipVisibility}" ToolTip="{Binding SeeLine}" Margin="0,2,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                          <TextBlock Text="{Binding SeeChip}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </DockPanel>
                  <StackPanel Margin="0,0,8,0">
                    <!-- a text: its preview with Copy in the corner, and where to paste it -->
                    <StackPanel Visibility="{Binding TextVisibility}" Margin="0,14,0,0">
                      <Grid>
                        <Border Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Control}" MinHeight="56">
                          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock local:MacroSyntax.IsMacro="{Binding IsMacro}" local:MacroSyntax.Code="{Binding TextPreview}" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Text.Primary}" Margin="12,10,84,10" AutomationProperties.Name="Text preview" />
                          </ScrollViewer>
                        </Border>
                        <Button Content="Copy" Style="{StaticResource Button.Primary.S}" Tag="{Binding}" Click="Copy_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                IsEnabled="{Binding IdleEnabled}" ToolTip="Put the text on the clipboard" AutomationProperties.Name="Copy" />
                      </Grid>
                      <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MacroLengthLine}" Visibility="{Binding MacroLengthVisibility}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0"
                                   ToolTip="WoW's macro window takes 255 characters at most" />
                        <TextBlock Text="{Binding PasteHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                      </DockPanel>
                    </StackPanel>
                    <!-- an addon or a file: its main button -->
                    <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding IdleEnabled}" Visibility="{Binding MainButtonsVisibility}">
                      <Button Content="{Binding InstallLabel}" Style="{StaticResource Button.Primary.M}" Tag="{Binding}" Click="Install_Click" Visibility="{Binding InstallVisibility}" Margin="0,0,8,0"
                              ToolTip="{Binding InstallTip}" AutomationProperties.Name="Install in WoW" />
                      <Button Content="Save..." Style="{StaticResource Button.Primary.M}" Tag="{Binding}" Click="Save_Click" Visibility="{Binding SaveCardVisibility}" Margin="0,0,8,0"
                              ToolTip="Save the newest version to this PC" AutomationProperties.Name="Save" />
                      <Button Content="Save..." Style="{StaticResource Button.M}" Tag="{Binding}" Click="Save_Click" Visibility="{Binding InstallVisibility}" Margin="0,0,12,0"
                              ToolTip="Save the addon's zip to this PC" AutomationProperties.Name="Save the zip" />
                      <CheckBox Style="{StaticResource Switch}" Content="Keep it updated" IsChecked="{Binding AutoUpdate, Mode=OneWay}" Tag="{Binding}" Click="Auto_Click" Visibility="{Binding AutoVisibility}" VerticalAlignment="Center"
                                ToolTip="Install new versions in WoW by themselves when someone uploads one (you'll be asked if a version changes the addon's folders)" AutomationProperties.Name="Keep it updated" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Desc}" Visibility="{Binding DescVisibility}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <!-- the facts in two lines -->
                    <TextBlock Text="{Binding FactsLine}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <TextBlock x:Name="DSee" Text="{Binding RanksLine}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <!-- an addon: its folders, what is in WoW, who has it, warnings -->
                    <TextBlock Text="{Binding AddonInfo}" Visibility="{Binding AddonInfoVisibility}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding InstalledLine}" Visibility="{Binding InstalledLineVisibility}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Accent}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding HaveLine}" Visibility="{Binding HaveVisibility}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding AddonWarn}" Visibility="{Binding AddonWarnVisibility}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Warn}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel Visibility="{Binding ProgressVisibility}" Margin="0,12,0,0">
                      <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Value="{Binding Progress}" />
                      <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <!-- the versions, only when there is a choice -->
                    <StackPanel Visibility="{Binding ManyVersionsVisibility}" Margin="0,18,0,0">
                      <TextBlock Text="Versions" Style="{StaticResource Text.RowTitle}" />
                      <TextBlock x:Name="VersionsSub" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,8" />
                      <ItemsControl x:Name="VersionList" ItemTemplate="{StaticResource VersionRow}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionsError" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <!-- managing it: for those who may update it (New version, Edit) or remove it (Delete, kept apart in red) -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="24,10,24,14" Visibility="{Binding ManageBarVisibility}">
              <DockPanel IsEnabled="{Binding IdleEnabled}">
                <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource GhostButton}" Foreground="{StaticResource Brush.Danger}" Height="28" Tag="{Binding}" Click="Delete_Click"
                        Visibility="{Binding ManageVisibility}" ToolTip="Remove it and all its versions from the lodge" AutomationProperties.Name="Delete" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="New version" Style="{StaticResource Button.S}" Tag="{Binding}" Click="Replace_Click" Visibility="{Binding UpdateVisibility}" Margin="0,0,8,0"
                          ToolTip="Upload a new version (the older ones are kept)" AutomationProperties.Name="Replace" />
                  <Button x:Name="EditButton" Content="Edit" Style="{StaticResource Button.S}" Tag="{Binding}" Click="Edit_Click" Visibility="{Binding UpdateVisibility}"
                          ToolTip="Name, description, picture and who can see or update it" AutomationProperties.Name="Edit" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </Border>
      </Border>

      <!-- ===== edit: name, description, picture, the addon mark, the note on the newest version, who can see / update it ===== -->
      <Border x:Name="EditOverlay" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" MouseLeftButtonDown="Scrim_Down">
        <Border Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}"
                MaxWidth="520" MaxHeight="700" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Elevation.2}" MouseLeftButtonDown="Box_Down">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24,24,0">
              <StackPanel>
                <TextBlock x:Name="EHeading" Text="Edit" Style="{StaticResource Text.Section}" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="ENamePanel">
                  <TextBlock Text="Name" Style="{StaticResource Text.Caption}" Margin="0,16,0,0" />
                  <TextBox x:Name="EName" Style="{StaticResource Input}" MaxLength="60" Margin="0,4,0,0" AutomationProperties.Name="Name" />
                </StackPanel>
                <TextBlock Text="Description" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <TextBox x:Name="EDesc" Style="{StaticResource Input}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,4,0,0" Tag="What it is, how to use it" AutomationProperties.Name="Description" />
                <TextBlock Text="Picture" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <DockPanel Margin="0,4,0,0">
                  <Border Width="128" Height="72" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface2}" ClipToBounds="True" DockPanel.Dock="Left">
                    <Grid>
                      <TextBlock x:Name="ENoPicture" Text="No picture" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image x:Name="EPicture" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <WrapPanel>
                      <Button x:Name="EPicPick" Content="Choose picture..." Style="{StaticResource Button.S}" Click="EPicPick_Click" Margin="0,0,8,0" />
                      <Button x:Name="EPicRemove" Content="Remove" Style="{StaticResource GhostButton}" Height="28" Click="EPicRemove_Click" />
                    </WrapPanel>
                    <TextBlock Text="A screenshot or cover: png, jpg, gif or webp, up to 2 MB." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </DockPanel>
                <StackPanel x:Name="ECatPanel" Visibility="Collapsed">
                  <TextBlock Text="What it is" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                  <ComboBox x:Name="ECat" Style="{StaticResource Dropdown}" Margin="0,4,0,0" AutomationProperties.Name="What it is" />
                </StackPanel>
                <CheckBox x:Name="EAddon" Style="{StaticResource Switch}" HorizontalAlignment="Left" Content="This is a WoW addon" Margin="0,12,0,0" ToolTip="Members can install it in WoW Forever from the Library (the newest version must be a zip of addon folders)" />
                <TextBlock x:Name="EAddonWhy" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="48,2,0,0" Visibility="Collapsed" />
                <TextBlock Text="Note on the newest version" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <TextBox x:Name="ENote" Style="{StaticResource Input}" MaxLength="200" Margin="0,4,0,0" Tag="What changed" AutomationProperties.Name="Note on the newest version" />
                <StackPanel x:Name="ERanksPanel">
                  <TextBlock Text="Who can see it" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                  <ComboBox x:Name="ESee" Style="{StaticResource Dropdown}" Margin="0,4,0,0" AutomationProperties.Name="Who can see it" />
                  <TextBlock Text="Who can update it" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                  <ComboBox x:Name="EEdit" Style="{StaticResource Dropdown}" Margin="0,4,0,0" AutomationProperties.Name="Who can update it" />
                  <TextBlock Text="Updating: uploading new versions, rolling back, and changing the description, picture and notes. Officers and the Guild Master can always do everything."
                             Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="EError" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,12" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,24">
              <Button Content="Cancel" Style="{StaticResource Button.M}" Click="ECancel_Click" />
              <Button x:Name="ESave" Content="Save changes" Style="{StaticResource Button.Primary.M}" Margin="8,0,0,0" Click="ESave_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <!-- ===== a kit: name, description, who can see it, its files ===== -->
      <Border x:Name="KitOverlay" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" MouseLeftButtonDown="Scrim_Down">
        <Border Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}"
                MaxWidth="520" MaxHeight="700" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Elevation.2}" MouseLeftButtonDown="Box_Down">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24,24,0">
              <StackPanel>
                <TextBlock x:Name="KHeading" Text="New kit" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Name" Style="{StaticResource Text.Caption}" Margin="0,16,0,0" />
                <TextBox x:Name="KName" Style="{StaticResource Input}" MaxLength="60" Margin="0,4,0,0" Tag="Raid night kit" AutomationProperties.Name="Kit name" />
                <TextBlock Text="Description" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <TextBox x:Name="KDesc" Style="{StaticResource Input}" MaxLength="300" Margin="0,4,0,0" Tag="What it's for (optional)" AutomationProperties.Name="Kit description" />
                <TextBlock Text="Who can see it" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <ComboBox x:Name="KSee" Style="{StaticResource Dropdown}" Margin="0,4,0,0" AutomationProperties.Name="Who can see the kit" />
                <TextBlock Text="In the kit" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <StackPanel x:Name="KSlots" Margin="0,4,0,0" />
                <TextBlock Text="Members only see the files of a kit that they may see themselves." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="KError" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,12" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,24">
              <Button Content="Cancel" Style="{StaticResource Button.M}" Click="KCancel_Click" />
              <Button Content="Save kit" Style="{StaticResource Button.Primary.M}" Margin="8,0,0,0" Click="KSave_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <!-- ===== upload form: a new slot, or a new version of one ===== -->
      <Border x:Name="FormOverlay" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" MouseLeftButtonDown="Scrim_Down">
        <Border Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}"
                Width="480" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Elevation.2}" MouseLeftButtonDown="Box_Down">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24,24,0">
              <StackPanel>
                <TextBlock x:Name="FormHeading" Text="Add to the library" Style="{StaticResource Text.Section}" />
                <TextBlock x:Name="FormSub" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="Name" Style="{StaticResource Text.Caption}" />
                <TextBox x:Name="FName" Style="{StaticResource Input}" MaxLength="60" Margin="0,4,0,0" Tag="What people see in the list" KeyDown="Form_KeyDown" AutomationProperties.Name="Name" />
                <Border x:Name="FModePanel" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FModeFile" Style="{StaticResource Segment}" Content="File" GroupName="files-mode" IsChecked="True" Click="FMode_Click" AutomationProperties.Name="Add a file" />
                    <RadioButton x:Name="FModeText" Style="{StaticResource Segment}" Content="Text (macro, WeakAura, profile...)" GroupName="files-mode" Click="FMode_Click" AutomationProperties.Name="Add text to copy" />
                  </StackPanel>
                </Border>
                <StackPanel x:Name="FFilePanel">
                  <TextBlock Text="File" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                  <DockPanel Margin="0,4,0,0">
                    <Button x:Name="FPick" DockPanel.Dock="Left" Content="Choose file..." Style="{StaticResource Button.M}" Click="FPick_Click" />
                    <TextBlock x:Name="FFile" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0" Text="No file chosen" />
                  </DockPanel>
                </StackPanel>
                <StackPanel x:Name="FTextPanel" Visibility="Collapsed">
                  <TextBlock Text="Text" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                  <TextBox x:Name="FText" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                           FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" Tag="Paste the import string here" AutomationProperties.Name="Text to share" />
                </StackPanel>
                <CheckBox x:Name="FAddon" Style="{StaticResource Switch}" HorizontalAlignment="Left" Content="This is a WoW addon" Margin="0,12,0,0" Visibility="Collapsed" Click="FAddon_Click" AutomationProperties.Name="This is a WoW addon"
                          ToolTip="Members can install it in WoW Forever from the Library, and keep it updated" />
                <TextBlock x:Name="FAddonWhy" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="48,2,0,0" />
                <TextBlock Text="Note" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <TextBox x:Name="FNote" Style="{StaticResource Input}" MaxLength="200" Margin="0,4,0,0" Tag="What changed (optional)" KeyDown="Form_KeyDown" AutomationProperties.Name="Note" />
                <TextBlock x:Name="FError" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,12" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,24">
              <Button Content="Cancel" Style="{StaticResource Button.M}" Click="FCancel_Click" />
              <Button x:Name="FGo" Content="Upload" Style="{StaticResource Button.Primary.M}" Margin="8,0,0,0" Click="FGo_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>
