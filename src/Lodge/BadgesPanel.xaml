<UserControl x:Class="ElansAddonHub.Lodge.BadgesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub.Lodge">
  <UserControl.Resources>
    <!-- one badge: the disc, name + tier, flavour text, how to earn it (earned: the date), and a thin progress line with "3,412 / 10,000 kills recorded" where a number exists -->
    <DataTemplate x:Key="BadgeRow">
      <Border Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Control}" Padding="12" Margin="0,0,0,8" Opacity="{Binding RowOpacity}" AutomationProperties.Name="{Binding Name}">
        <DockPanel>
          <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource BadgeDisc.M}" VerticalAlignment="Top" Margin="0,0,12,0" />
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,0" Margin="8,0,0,0" Background="{Binding TierTint}" VerticalAlignment="Center">
                <TextBlock Text="{Binding TierLabel}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Flavour}" Visibility="{Binding FlavourVisibility}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding How}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding EarnedLine}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,2,0,0" />
            <StackPanel Visibility="{Binding ProgressVisibility}" Margin="0,8,0,0">
              <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
              <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="BadgeGroup">
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BadgeRow}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock x:Name="Summary" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <ItemsControl x:Name="GroupList" ItemTemplate="{StaticResource BadgeGroup}" />
    <TextBlock x:Name="Empty" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
