<UserControl x:Class="ElansAddonHub.Lodge.InviteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The invites made so far (Text.RowTitle + Text.Secondary rows, a state Chip, Button.S Revoke). Shared by Settings > Guild Master (all of them)
       and the Invite sheet (pending ones only). -->
  <StackPanel>
    <TextBlock x:Name="InvitesEmpty" Style="{StaticResource Text.Secondary}" Margin="0,12" Text="No invites yet." />
    <ItemsControl x:Name="InviteRows">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,8" Opacity="{Binding RowOpacity}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Revoke" Visibility="{Binding RevokeVisibility}" Tag="{Binding Id}" Click="RevokeInvite_Click"
                      AutomationProperties.Name="Revoke this invite" />
              <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,8,0" Background="{Binding StateBrush}" VerticalAlignment="Center" Visibility="{Binding StateVisibility}">
                <TextBlock Text="{Binding State}" Style="{StaticResource Text.Caption}" Foreground="{Binding StateText}" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
