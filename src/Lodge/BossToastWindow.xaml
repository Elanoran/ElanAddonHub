<Window x:Class="ElansAddonHub.Lodge.BossToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camp Boss" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="Height" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <!-- The Camp Boss saying a toast over the game (toast style "boss"). She looks like her box in Elan's Toolkit (UI/Talker.lua): a dark
       panel 330 x 76 at the game's scale, her face top left, the title in gold, the line typed below it, a gold bar running down.
       The Viewbox scales that 330 wide design to her width in the game window (BossNotes.Spot). Click-through and never active (see code). -->
  <Viewbox x:Name="Scale" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top">
    <Border x:Name="Box" Width="330" MinHeight="76" Background="#EB0E0F11" BorderBrush="#FF3A3D44" BorderThickness="1">
      <Border.RenderTransform><TranslateTransform x:Name="Drop" /></Border.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Width="64" Height="64" Margin="6,6,6,6" VerticalAlignment="Top" HorizontalAlignment="Left">
          <Image x:Name="Face" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
          <Image x:Name="FaceNext" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="2,8,8,10">
          <DockPanel>
            <TextBlock x:Name="Kicker" DockPanel.Dock="Right" FontSize="10" Foreground="#FF8A8F98" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFD100" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Grid Margin="0,4,0,0">
            <!-- the whole line, invisible, keeps her height steady while the visible copy is typed over it -->
            <TextBlock x:Name="FullText" FontSize="12" TextWrapping="Wrap" Visibility="Hidden" />
            <TextBlock x:Name="Typed" FontSize="12" Foreground="#FFE6E6E6" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
        <Rectangle x:Name="Bar" Grid.ColumnSpan="2" Height="2" Fill="#E6FFD100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,1,1" Width="328" />
      </Grid>
    </Border>
  </Viewbox>
</Window>
