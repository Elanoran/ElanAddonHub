<Window x:Class="ElansAddonHub.Lodge.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ElansAddonHub.Lodge"
        Title="Lodge toasts" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <!-- small dark cards over the game. Click-through and never active (see code). -->
  <ItemsControl x:Name="Cards" Margin="8" MinWidth="300" MaxWidth="340">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Opacity="{Binding Opacity}" Background="#F0141719" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
          <DockPanel>
            <local:AvatarView DockPanel.Dock="Left" Width="32" Height="32" VerticalAlignment="Top" Margin="0,1,12,0" />
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Kicker}" FontSize="9.5" Foreground="#8A9199" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#D8DCE0" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</Window>
