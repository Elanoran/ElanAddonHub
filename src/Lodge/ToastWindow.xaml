<Window x:Class="ElansAddonHub.Lodge.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ElansAddonHub.Lodge"
        Title="Lodge toasts" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <!-- DESIGN 8: a toast is an overlay (elevation 2): Surface3, hairline edge, radius 12, 16,12 padding, avatar + title / body.
       Click-through and never active (see code). The outer margin (ToastWindow.ShadowL/T/R/B) holds the shadow; Place() compensates for it.
       Enter = fade + 8 px slide up, exit = fade + 4 px down: ToastCenter.Tick drives Opacity / Slide through Motion durations. -->
  <ItemsControl x:Name="Cards" Margin="40,32,40,52" MinWidth="320" MaxWidth="360">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Opacity="{Binding Opacity}" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}" Padding="{StaticResource Pad.Row}" Margin="0,0,0,12" Effect="{StaticResource Elevation.2}">
          <Border.RenderTransform><TranslateTransform Y="{Binding Slide}" /></Border.RenderTransform>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <local:AvatarView Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Kicker}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.RowTitle}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Text="{Binding Preview}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" MaxHeight="32" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</Window>
