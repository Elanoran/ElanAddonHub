<UserControl x:Class="ElansAddonHub.RadioBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Center">
  <!-- The Radio Paradise player (2.73, DESIGN "Radio"): one 32 high Surface1 pill right of the title bar's search box: the cover (24, a music note
       when the stream names none), "Artist - Title" (scrolls slowly when it does not fit, pausing at the ends; static when it fits or when Windows
       animations are off), play / pause and a tiny 3-bar equaliser while it plays (decorative, not an analyser). A click on the cover or the title
       opens the pop-out: the larger cover, title, artist, the 8 channels as chips, the volume with mute, the state + Retry, the attribution link to
       radioparadise.com and "Support Radio Paradise". A hit-test island: a press on it never starts the window drag.
       Focus: every control here shows its ring through FocusVisualStyle (like the left rail's Rail.FocusRing), so it appears when you move with the
       keyboard (Tab) and never after a mouse click. -->
  <UserControl.Resources>
    <!-- keyboard-only focus rings, 2 px Brush.Focus, 3 outside the control: a pill / circle, and the radius-8 shape of the links and Retry -->
    <Style x:Key="Radio.FocusPill">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border x:Name="ring" Margin="-3" CornerRadius="99" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" IsHitTestVisible="False" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Radio.FocusRect">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border x:Name="ring" Margin="-3" CornerRadius="11" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" IsHitTestVisible="False" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- round glyph button (IconButton's look, the ring from FocusVisualStyle) -->
    <Style x:Key="Radio.Icon" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Radio.FocusPill}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" />
              <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="14" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="pr" Background="{StaticResource Brush.Overlay.Pressed}" CornerRadius="14" Opacity="0" IsHitTestVisible="False" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the cover + title part of the pill: a 28 high pill with the hover veil -->
    <Style x:Key="Radio.Song" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Radio.FocusPill}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="14" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="pr" Background="{StaticResource Brush.Overlay.Pressed}" CornerRadius="14" Opacity="0" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- text button (GhostButton's look; Retry sets a veil background like Button.S) -->
    <Style x:Key="Radio.Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Radio.FocusRect}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="pr" Background="{StaticResource Brush.Overlay.Pressed}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a channel chip: 24 high, full-round, chip veil; the current channel = Brush.Accent.Tint + Primary text (DESIGN: selection in chips) -->
    <Style x:Key="Radio.Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="GroupName" Value="RadioParadiseChannel" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Radio.FocusPill}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Height="24">
              <Border x:Name="bd" Background="{StaticResource Brush.Overlay.Chip}" CornerRadius="12" />
              <Border x:Name="sel" Background="{StaticResource Brush.Accent.Tint}" CornerRadius="12" Opacity="0" />
              <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                <Setter TargetName="sel" Property="Opacity" Value="1" />
                <Setter TargetName="bd" Property="Opacity" Value="0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the slim slider (DESIGN 8) with the ring from FocusVisualStyle instead of the thumb's keyboard-focus trigger -->
    <Style x:Key="Radio.Slider" TargetType="Slider">
      <Setter Property="Height" Value="24" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Radio.FocusPill}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="{StaticResource Brush.Surface3}" VerticalAlignment="Center" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="24" Height="24" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Ellipse x:Name="knob" Width="16" Height="16" Fill="{StaticResource Brush.Text.Primary}">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4" Color="Black" /></Ellipse.Effect>
                          </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="knob" Property="Fill" Value="{StaticResource Brush.Accent.Hover}" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- the pill: [cover + title] [play / pause] [equaliser] -->
    <Border x:Name="Chip" Height="32" Padding="2" Background="{StaticResource Brush.Surface1}" CornerRadius="16"
            MouseLeftButtonDown="Chip_MouseDown" AutomationProperties.Name="Radio Paradise player">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="SongButton" Style="{StaticResource Radio.Song}" Click="Song_Click"
                ToolTip="Song, channels and volume" AutomationProperties.Name="Song, channels and volume">
          <StackPanel Orientation="Horizontal">
            <Grid Width="24" Height="24">
              <Border CornerRadius="12" Background="{StaticResource Brush.Surface2}">
                <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="CoverArt" CornerRadius="12" Visibility="Collapsed">
                <Border.Background><ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" /></Border.Background>
              </Border>
            </Grid>
            <!-- the title: clipped; it scrolls (TranslateTransform) only when it does not fit -->
            <Canvas x:Name="TitleClip" Height="16" Margin="8,0,4,0" ClipToBounds="True" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="NowText" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="NoWrap">
                <TextBlock.RenderTransform><TranslateTransform x:Name="NowShift" /></TextBlock.RenderTransform>
              </TextBlock>
            </Canvas>
          </StackPanel>
        </Button>
        <Button x:Name="PlayButton" Style="{StaticResource Radio.Icon}" Content="&#xE768;" Click="Play_Click" AutomationProperties.Name="Play" />
        <!-- a tiny equaliser while it plays: three bars that rise and fall (decorative; static with Windows animations off) -->
        <Grid x:Name="Equaliser" Width="12" Height="12" Margin="4,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"
              AutomationProperties.Name="Playing">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" /><ColumnDefinition Width="1.5" /><ColumnDefinition Width="3" /><ColumnDefinition Width="1.5" /><ColumnDefinition Width="3" />
          </Grid.ColumnDefinitions>
          <Rectangle x:Name="Bar1" Grid.Column="0" Fill="{StaticResource Brush.Accent}" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1Scale" ScaleY="0.5" /></Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle x:Name="Bar2" Grid.Column="2" Fill="{StaticResource Brush.Accent}" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2Scale" ScaleY="1" /></Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle x:Name="Bar3" Grid.Column="4" Fill="{StaticResource Brush.Accent}" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3Scale" ScaleY="0.7" /></Rectangle.RenderTransform>
          </Rectangle>
        </Grid>
      </StackPanel>
    </Border>

    <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Chip}" Placement="Bottom" HorizontalOffset="-24" VerticalOffset="-16" StaysOpen="False" AllowsTransparency="True"
           PopupAnimation="None" Opened="Flyout_Opened" Closed="Flyout_Closed">
      <Border x:Name="FlyCard" Width="320" Margin="24" Padding="16" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Elevation.2}">
        <StackPanel>
          <!-- the song: the larger cover (the stream's own picture; a music note when there is none), title, artist -->
          <DockPanel x:Name="SongRow" Margin="0,0,0,16">
            <Grid DockPanel.Dock="Left" Width="96" Height="96" VerticalAlignment="Top">
              <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface2}">
                <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Font.Icons}" FontSize="32" Foreground="{StaticResource Brush.Text.Tertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="FlyCoverArt" CornerRadius="{StaticResource Radius.Control}" Visibility="Collapsed">
                <Border.Background><ImageBrush x:Name="FlyCoverBrush" Stretch="UniformToFill" /></Border.Background>
              </Border>
            </Grid>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FlyTitle" Style="{StaticResource Text.RowTitle}" TextWrapping="Wrap" />
              <TextBlock x:Name="FlyArtist" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <!-- the 8 channels: one click switches (this session; the favourite is in Settings > General) -->
          <WrapPanel x:Name="ChannelChips" Margin="0,0,0,8" AutomationProperties.Name="Radio Paradise channel" />
          <!-- the volume: the speaker mutes, the slider sets it (moving it unmutes) -->
          <DockPanel x:Name="FlyVolumeRow">
            <Button x:Name="MuteButton" DockPanel.Dock="Left" Style="{StaticResource Radio.Icon}" Content="&#xE767;" Margin="-4,0,0,0"
                    Click="Mute_Click" ToolTip="Mute" AutomationProperties.Name="Mute the radio" />
            <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="VolumeSlider" Style="{StaticResource Radio.Slider}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="4,0,0,0" VerticalAlignment="Center"
                    ValueChanged="Volume_Changed" AutomationProperties.Name="Radio volume" />
          </DockPanel>
          <TextBlock x:Name="FlyStatus" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Button x:Name="RetryButton" Style="{StaticResource Radio.Link}" Background="{StaticResource Brush.Overlay.Chip}" Foreground="{StaticResource Brush.Text.Primary}"
                  Height="28" Padding="12,0" Content="Retry" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Retry_Click" Visibility="Collapsed" />
          <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,12,0,8" />
          <!-- attribution: the name of the station and the channel, linked to radioparadise.com (the Outpost browser) -->
          <Button x:Name="RpLink" Style="{StaticResource Radio.Link}" HorizontalAlignment="Left" Margin="-8,0,0,0" Click="RpLink_Click" ToolTip="radioparadise.com">
            <TextBlock x:Name="RpLinkText" Style="{StaticResource Text.RowTitle}" Text="Radio Paradise · Main Mix" />
          </Button>
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Radio Paradise is listener-supported radio. It streams live while you listen; nothing is recorded." />
          <Button x:Name="SupportLink" Style="{StaticResource Radio.Link}" HorizontalAlignment="Left" Margin="-8,4,0,0" Content="Support Radio Paradise" Click="Support_Click"
                  ToolTip="radioparadise.com/donate" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
