<UserControl x:Class="ElansAddonHub.RadioBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Center">
  <!-- The Radio Paradise mini player (2.72, DESIGN "Radio"): a 32 high Surface1 chip right of the title bar's search box. Play / pause, the channel,
       the volume (a speaker that mutes and a small slider) and the song: its cover (24, a music note when there is none) and "Artist - Title"
       (trimmed, the full text in the tooltip). A click on the song opens the flyout: the larger cover, title, artist, album and year, the attribution
       link to radioparadise.com, the state / Retry and "Support Radio Paradise". A hit-test island: a press on it never starts the window drag. -->
  <Grid>
    <Border x:Name="Chip" Height="32" Padding="2,0,2,0" Background="{StaticResource Brush.Surface1}" CornerRadius="{StaticResource Radius.ControlLg}"
            MouseLeftButtonDown="Chip_MouseDown" AutomationProperties.Name="Radio Paradise player">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="16" Content="&#xE768;" Click="Play_Click"
                AutomationProperties.Name="Play" ToolTipService.InitialShowDelay="300" />
        <ComboBox x:Name="ChannelBox" Style="{StaticResource Dropdown}" Width="120" Height="28" MinHeight="28" Margin="2,0,0,0" VerticalAlignment="Center"
                  SelectionChanged="Channel_Changed" AutomationProperties.Name="Radio Paradise channel" ToolTip="Channel (this session; the favourite is in Settings > General)" />
        <StackPanel x:Name="VolumeGroup" Orientation="Horizontal" Margin="4,0,0,0">
          <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="16" Content="&#xE767;" Click="Mute_Click"
                  ToolTip="Mute" AutomationProperties.Name="Mute the radio" />
          <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="0,0,4,0" VerticalAlignment="Center"
                  ValueChanged="Volume_Changed" AutomationProperties.Name="Radio volume" />
        </StackPanel>
        <Button x:Name="SongButton" Style="{StaticResource GhostButton}" Height="28" Padding="2" Margin="4,0,0,0" VerticalAlignment="Center" Click="Song_Click"
                ToolTip="Song details and Radio Paradise" AutomationProperties.Name="Song details and Radio Paradise">
          <StackPanel Orientation="Horizontal">
            <Grid Width="24" Height="24">
              <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface2}">
                <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="CoverArt" CornerRadius="{StaticResource Radius.Control}" Visibility="Collapsed">
                <Border.Background><ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" /></Border.Background>
              </Border>
            </Grid>
            <TextBlock x:Name="NowText" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="8,0,4,0"
                       MaxWidth="200" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Chip}" Placement="Bottom" HorizontalOffset="-24" VerticalOffset="-16" StaysOpen="False" AllowsTransparency="True"
           PopupAnimation="None" Opened="Flyout_Opened">
      <Border x:Name="FlyCard" Width="304" Margin="24" Padding="16" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Elevation.2}">
        <StackPanel>
          <!-- the song: the larger cover (a music note when there is none), title, artist, album · year -->
          <DockPanel x:Name="SongRow" Margin="0,0,0,12">
            <Grid DockPanel.Dock="Left" Width="96" Height="96" VerticalAlignment="Top">
              <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface2}">
                <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Font.Icons}" FontSize="32" Foreground="{StaticResource Brush.Text.Tertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="FlyCoverArt" CornerRadius="{StaticResource Radius.Control}" Visibility="Collapsed">
                <Border.Background><ImageBrush x:Name="FlyCoverBrush" Stretch="UniformToFill" /></Border.Background>
              </Border>
            </Grid>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FlyTitle" Style="{StaticResource Text.RowTitle}" TextWrapping="Wrap" />
              <TextBlock x:Name="FlyArtist" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2,0,0" />
              <TextBlock x:Name="FlyAlbum" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
          <!-- attribution: the name of the station and the channel, linked to radioparadise.com (the Outpost browser) -->
          <Button x:Name="RpLink" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,-4,0,0" Click="RpLink_Click" ToolTip="radioparadise.com">
            <TextBlock x:Name="RpLinkText" Style="{StaticResource Text.RowTitle}" Text="Radio Paradise · Main Mix" />
          </Button>
          <TextBlock x:Name="FlyStatus" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
          <Button x:Name="RetryButton" Style="{StaticResource Button.S}" Content="Retry" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Retry_Click" Visibility="Collapsed" />
          <!-- on a narrow window the channel and the volume move here from the title bar -->
          <ComboBox x:Name="FlyChannelBox" Style="{StaticResource Dropdown}" Margin="0,12,0,0" SelectionChanged="Channel_Changed" Visibility="Collapsed"
                    AutomationProperties.Name="Radio Paradise channel" />
          <DockPanel x:Name="FlyVolumeRow" Margin="0,12,0,0" Visibility="Collapsed">
            <Button x:Name="FlyMuteButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="16" Content="&#xE767;" Margin="-4,0,0,0"
                    Click="Mute_Click" ToolTip="Mute" AutomationProperties.Name="Mute the radio" />
            <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="FlyVolumeSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="4,0,0,0" VerticalAlignment="Center"
                    ValueChanged="Volume_Changed" AutomationProperties.Name="Radio volume" />
          </DockPanel>
          <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,12,0,8" />
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                     Text="Radio Paradise is listener-supported radio. It streams live while you listen; nothing is recorded." />
          <Button x:Name="SupportLink" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,4,0,0" Content="Support Radio Paradise" Click="Support_Click"
                  ToolTip="radioparadise.com/donate" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
