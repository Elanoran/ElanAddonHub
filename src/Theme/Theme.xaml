<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:m="clr-namespace:ElansAddonHub">

  <!-- The rules behind these tokens live in DESIGN.md (repo root). New UI uses the Space.* / Radius.* / Text.* / Brush.* /
       Elevation.* / Motion.* names below; the old short keys (Bg, Surface, Text, TextDim, Accent ...) are aliases kept so older pages keep working. -->

  <!-- palette: dark, quiet, hunter green accent -->
  <Color x:Key="BgColor">#0F1113</Color>
  <Color x:Key="SurfaceColor">#16191C</Color>
  <Color x:Key="SurfaceHiColor">#1E2226</Color>
  <Color x:Key="BorderColor">#262B30</Color>
  <Color x:Key="TextColor">#E8EAED</Color>
  <Color x:Key="TextDimColor">#8A9199</Color>
  <Color x:Key="AccentColor">#ABD473</Color>
  <Color x:Key="AccentHiColor">#BFE38C</Color>
  <Color x:Key="AccentDarkColor">#8DB35A</Color>
  <Color x:Key="GoldColor">#E6B85C</Color>
  <Color x:Key="DangerColor">#E06C6C</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <!-- cards float over the header art: almost opaque -->
  <SolidColorBrush x:Key="Card" Color="#E616191C" />
  <SolidColorBrush x:Key="SurfaceHi" Color="{StaticResource SurfaceHiColor}" />
  <SolidColorBrush x:Key="Line" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHi" Color="{StaticResource AccentHiColor}" />
  <SolidColorBrush x:Key="AccentDark" Color="{StaticResource AccentDarkColor}" />
  <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />

  <!-- Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10 (same code points) -->
  <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <!-- ===================== TOKENS ===================== -->

  <!-- spacing: 4-pt scale. Only these values for margins / padding / gaps. -->
  <sys:Double x:Key="Space.XS">4</sys:Double>
  <sys:Double x:Key="Space.S">8</sys:Double>
  <sys:Double x:Key="Space.M">12</sys:Double>
  <sys:Double x:Key="Space.L">16</sys:Double>
  <sys:Double x:Key="Space.XL">24</sys:Double>
  <sys:Double x:Key="Space.XXL">32</sys:Double>
  <sys:Double x:Key="Space.XXXL">48</sys:Double>
  <Thickness x:Key="Pad.Card">16</Thickness>
  <Thickness x:Key="Pad.Row">16,12</Thickness>
  <Thickness x:Key="Pad.Page">24,8,24,24</Thickness>
  <sys:Double x:Key="Gap.Card">12</sys:Double>
  <sys:Double x:Key="Gap.Section">24</sys:Double>

  <!-- radii -->
  <CornerRadius x:Key="Radius.Window">14</CornerRadius>
  <CornerRadius x:Key="Radius.Card">12</CornerRadius>
  <CornerRadius x:Key="Radius.ControlLg">10</CornerRadius>
  <CornerRadius x:Key="Radius.Control">8</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">12</CornerRadius>
  <sys:Double x:Key="Radius.Pill">12</sys:Double>

  <!-- layers: Background < Surface1 (cards) < Surface2 (inputs, hover rows) < Surface3 (popovers, pressed) -->
  <Color x:Key="Color.Surface3">#262B30</Color>
  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource SurfaceHiColor}" />
  <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" />
  <!-- raised cards float over the header art: almost opaque Surface1 -->
  <SolidColorBrush x:Key="Brush.Card" Color="#F016191C" />
  <!-- the page panel (Bg at 75 %): pages sit on it, never directly on the hero art; cards on it are Surface1, inputs Surface2 -->
  <SolidColorBrush x:Key="Brush.Scrim" Color="#BF0F1113" />

  <!-- text roles. Primary 14.6:1 / Secondary 5.5:1 on Surface1 (AA for body text). Tertiary is 3.8:1: icons, hints, timestamps only. -->
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#6F767E" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#4B5258" />

  <!-- accent: actions and selection only -->
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource AccentHiColor}" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource AccentDarkColor}" />
  <SolidColorBrush x:Key="Brush.Accent.Tint" Color="#29ABD473" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#111315" />

  <!-- status: only ever for state (ok / attention / failed / info) -->
  <Color x:Key="Color.Success">#7CCB8E</Color>
  <Color x:Key="Color.Info">#6CA8E0</Color>
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource GoldColor}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
  <SolidColorBrush x:Key="Brush.Success.Tint" Color="#267CCB8E" />
  <SolidColorBrush x:Key="Brush.Warn.Tint" Color="#26E6B85C" />
  <SolidColorBrush x:Key="Brush.Danger.Tint" Color="#29E06C6C" />
  <SolidColorBrush x:Key="Brush.Info.Tint" Color="#266CA8E0" />

  <!-- overlays: white veils on any surface (hover 6 %, pressed 10 %, chips 8 %); hairline dividers 7 % -->
  <SolidColorBrush x:Key="Brush.Overlay.Chip" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Brush.Overlay.Hover" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Brush.Overlay.Pressed" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Brush.Divider" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource AccentColor}" />
  <!-- 1 px top highlight that fades down the edge: the "light from above" of a raised surface (instead of an outline) -->
  <LinearGradientBrush x:Key="Brush.Edge" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1AFFFFFF" Offset="0" />
    <GradientStop Color="#0AFFFFFF" Offset="0.35" />
    <GradientStop Color="#05FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- elevation: 0 flat (fill only) / 1 raised card / 2 overlay (dialogs, popovers). Fill + top highlight + soft shadow, no outline. -->
  <DropShadowEffect x:Key="Elevation.1" x:Shared="False" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.30" Color="Black" />
  <DropShadowEffect x:Key="Elevation.2" x:Shared="False" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.50" Color="Black" />

  <!-- motion: fast 120 (hover tints), standard 180 (expand, page, dialog), emphasized 240 (large moves). Ease-out in, ease-in out.
       App.OnStartup zeroes the durations when Windows animations are off. -->
  <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
  <Duration x:Key="Motion.Standard">0:0:0.18</Duration>
  <Duration x:Key="Motion.Emphasized">0:0:0.24</Duration>
  <CubicEase x:Key="Motion.EaseOut" EasingMode="EaseOut" />
  <CubicEase x:Key="Motion.EaseIn" EasingMode="EaseIn" />

  <!-- reusable hover storyboards: every control template that has a white veil named "hv" starts these -->
  <Storyboard x:Key="Motion.HoverIn">
    <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
  </Storyboard>
  <Storyboard x:Key="Motion.HoverOut">
    <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
  </Storyboard>

  <!-- type ramp: Title 22 / Section 15 (semibold) / Body 13 / Secondary 12 / Caption 11 / Mono 12. At most ONE semibold element per row. -->
  <Style x:Key="Text.Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style x:Key="Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style x:Key="Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>
  <!-- title of a list row (third-party addon, setting): Body size, the row's one semibold -->
  <Style x:Key="Text.RowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style x:Key="Text.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <!-- the little chevron of an expandable row: rotates (Motion.Turn) instead of swapping glyphs -->
  <Style x:Key="Text.Chevron" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Text" Value="&#xE70D;" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- chips: a small rounded label with a tinted fill, never an outline. Colour them with Brush.*.Tint + the matching Brush.* text. -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
    <Setter Property="Background" Value="{StaticResource Brush.Overlay.Chip}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <!-- the raised card: Surface1 fill + top highlight + soft shadow. Hover (Motion.Track -> Motion.IsHot) tints it and lifts it 1 px.
       Use as <ContentControl Style="{StaticResource Card.Raised}">...content...</ContentControl>, gap below = Gap.Card. -->
  <Style x:Key="Card.Raised" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="m:Motion.Track" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform x:Name="lift" /></Grid.RenderTransform>
            <Border x:Name="surface" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
              <Border.Effect><DropShadowEffect x:Name="shadow" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.30" Color="Black" /></Border.Effect>
            </Border>
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Card}" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="m:Motion.IsHot" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="-1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.42" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Standard}" EasingFunction="{StaticResource Motion.EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.30" Duration="{StaticResource Motion.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===================== Buttons =====================
       Primary (accent fill: THE action of a view, at most one per view) / Secondary (quiet fill) / Ghost (text only) / Danger (destructive confirm).
       Sizes: Button.S 28, Button.M 32, Button.L 36 (Primary and Danger default to 36). Radius 10, focus ring = 2 px accent, 2 px outside. -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.ControlLg}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.ControlLg}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="pr" Background="#1F000000" CornerRadius="{StaticResource Radius.ControlLg}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ring" Margin="-4" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface2}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the status pill on a card: it is also the card's one action button (DataContext = a PillBase card). Full-round, 24 high, regular weight
       (the card's title is the row's one semibold). -->
  <Style x:Key="StatusPill" TargetType="Button">
    <Setter Property="Background" Value="{Binding PillBg}" />
    <Setter Property="Foreground" Value="{Binding PillFg}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="{Binding PillCursor}" />
    <Setter Property="Focusable" Value="{Binding PillClickable}" />
    <Setter Property="ToolTip" Value="{Binding PillTip}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
    <Setter Property="AutomationProperties.Name" Value="{Binding PillText}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Chip}" Padding="12,3" MinHeight="24">
              <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="spinRot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Border.Triggers>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center"
                           Visibility="{Binding PillSpinVisibility}" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform><RotateTransform x:Name="spinRot" /></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="{Binding PillText}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Chip}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="pr" Background="#1F000000" CornerRadius="{StaticResource Radius.Chip}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ring" Margin="-4" CornerRadius="17" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="Focusable" Value="True" />
              </MultiTrigger.Conditions>
              <MultiTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True" />
                <Condition Property="Focusable" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="pr" Property="Opacity" Value="1" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- red confirm button for destructive dialogs (Delete, Kick, Remove) -->
  <Style x:Key="DangerButton" TargetType="Button">
    <Setter Property="Foreground" Value="#1A0B0B" />
    <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.ControlLg}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.ControlLg}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="pr" Background="#1F000000" CornerRadius="{StaticResource Radius.ControlLg}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ring" Margin="-4" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- small text button (links, "Change", "Check now"): no fill until hovered -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="pr" Background="#14000000" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ring" Margin="-3" CornerRadius="11" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- title bar buttons -->
  <Style x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource Icons}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHi}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Danger}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- toggle switch (DESIGN 8): 40 x 24, track Surface3 -> accent, 18 px thumb that slides 180 ms, hover veil, keyboard focus ring. Use on a CheckBox, no content. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" Width="40" Height="24" SnapsToDevicePixels="True">
            <Border x:Name="track" CornerRadius="12" Background="{StaticResource Brush.Surface3}" />
            <Border x:Name="on" CornerRadius="12" Background="{StaticResource Brush.Accent}" Opacity="0" />
            <Border x:Name="hv" CornerRadius="12" Background="{StaticResource Brush.Overlay.Hover}" Opacity="0" IsHitTestVisible="False" />
            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Left" Margin="3,0,0,0">
              <Ellipse.RenderTransform><TranslateTransform x:Name="tx" /></Ellipse.RenderTransform>
              <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="Black" /></Ellipse.Effect>
            </Ellipse>
            <Border x:Name="ring" Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="16" Duration="{StaticResource Motion.Standard}" EasingFunction="{StaticResource Motion.EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource Motion.Standard}" EasingFunction="{StaticResource Motion.EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- thin progress line -->
  <Style x:Key="ThinProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{StaticResource SurfaceHi}" CornerRadius="1.5" />
            <Border x:Name="PART_Indicator" Background="{StaticResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- slim modern scrollbar: transparent track, rounded thumb that widens + brightens on hover -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- stretch: with Center alignment and no content the border collapsed to 0 px and the bar was invisible -->
          <Border x:Name="th" Background="#FFFFFF" CornerRadius="3" Opacity="0.28" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="th" Property="Opacity" Value="0.55" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="th" Property="Background" Value="{StaticResource AccentDark}" />
              <Setter TargetName="th" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb x:Name="thumb" Width="5" MinHeight="24" Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="thumb" Property="Width" Value="7" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="thumb" Property="Width" Value="Auto" />
              <Setter TargetName="thumb" Property="MinHeight" Value="0" />
              <Setter TargetName="thumb" Property="MinWidth" Value="24" />
              <Setter TargetName="thumb" Property="Height" Value="5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ScrollViewer: content + slim bars, no corner box, no arrow buttons -->
  <Style TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.ColumnSpan="1" Margin="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                       Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- tooltip: overlay level (Surface3 + hairline), 12 px text -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Brush.Surface3}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- a compact card instead of a text tooltip (people in the Lodge) -->
  <Style x:Key="CardTip" TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.ControlLg}" Padding="12,10">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Lodge controls ===================== -->

  <!-- text input with placeholder (Tag) -->
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{StaticResource Brush.Surface2}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
            <Grid>
              <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="11,0,0,0"
                         VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" />
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="ph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecretInput" TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{StaticResource Brush.Surface2}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- quiet button (Join voice, Change...): a white veil on whatever it sits on, no outline -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Overlay.Chip}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="pr" Background="#14000000" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ring" Margin="-4" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- explicit sizes (28 / 32 / 36): <Button Style="{StaticResource Button.M}" ...> -->
  <Style x:Key="Button.S" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="Button.M" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="32" /></Style>
  <Style x:Key="Button.L" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="16,0" /></Style>
  <Style x:Key="Button.Primary.S" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="Button.Primary.M" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="14,0" /></Style>
  <Style x:Key="Button.Primary.L" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Height" Value="36" /></Style>
  <Style x:Key="Button.Danger.M" TargetType="Button" BasedOn="{StaticResource DangerButton}"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="14,0" /></Style>

  <!-- a row in a small popup menu (status picker) -->
  <Style x:Key="MenuRow" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="8,7">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Line}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- round icon button (DESIGN 8): glyph Secondary -> Primary on hover, white veil fades in (120 ms), pressed veil, keyboard focus ring. Default 34; set Width/Height for 24-32.
       Set Foreground locally only for a status glyph (e.g. Danger on a delete button). -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17" />
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="17" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="pr" Background="{StaticResource Brush.Overlay.Pressed}" CornerRadius="17" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="ring" Margin="-3" CornerRadius="20" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- round icon toggle (mute / deafen): red when on -->
  <Style x:Key="IconToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Icons}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="{StaticResource SurfaceHi}" CornerRadius="17" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Danger}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Danger}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- navigation rail: a 44 px rounded-square icon. Rest = quiet icon, hover = white veil, selected = accent tint + accent icon + a pill on the window edge
       (accent = selection). Icons are 20 px. -->
  <Style x:Key="RailButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="52" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="pill" Width="3" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="0,3,3,0"
                    Background="{StaticResource Brush.Accent}" Opacity="0" />
            <Border x:Name="box" Width="44" Height="44" CornerRadius="12" Background="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Border x:Name="hv" Width="44" Height="44" CornerRadius="12" Background="{StaticResource Brush.Overlay.Hover}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="ring" Width="52" Height="52" CornerRadius="16" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource Brush.Accent.Tint}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="pill" Property="Opacity" Value="1" />
              <Setter TargetName="pill" Property="Height" Value="24" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- tabs in the header: Addons / Lodge -->
  <Style x:Key="Tab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,18,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Background="Transparent">
            <ContentPresenter Margin="0,0,0,5" />
            <Border x:Name="bar" Height="2" CornerRadius="1" Background="{StaticResource Accent}" Visibility="Hidden" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bar" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- segmented choice (DESIGN 8): put RadioButtons with Style=Segment inside a Border Style=SegmentHost. 32 high host (Surface2, radius 10, padding 2),
       28 high segments (radius 8); the chosen one is a Surface3 tile that fades in (120 ms), text Secondary -> Primary. Keyboard focus ring. -->
  <Style x:Key="SegmentHost" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface2}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.ControlLg}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Height="28" Background="Transparent">
            <Border x:Name="sel" Background="{StaticResource Brush.Surface3}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" />
            <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
            <Border x:Name="ring" Margin="-2" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" /></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" /></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- slim slider (DESIGN 8): 4 px track Surface3, accent fill, 16 px light thumb with a soft shadow, 24 px hit area, focus ring on the thumb -->
  <Style TargetType="Slider">
    <Setter Property="Height" Value="24" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{StaticResource Brush.Surface3}" VerticalAlignment="Center" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" Background="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="24" Height="24">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Ellipse x:Name="knob" Width="16" Height="16" Fill="{StaticResource Brush.Text.Primary}">
                          <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4" Color="Black" /></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="ring" Width="24" Height="24" StrokeThickness="2" Stroke="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                          <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="knob" Property="Fill" Value="{StaticResource Brush.Accent.Hover}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- dropdown / ComboBox (DESIGN 8): like an input (32 high, Surface2, radius 8, no border), chevron Tertiary, hover veil, accent 1 px while open,
       focus ring from the keyboard. The list is an overlay surface (Surface3, hairline, elevation 2, radius 10). -->
  <Style x:Key="Dropdown" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="tb" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border x:Name="bd" Background="{StaticResource Brush.Surface2}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" />
                    <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
                    <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Foreground="{StaticResource Brush.Text.Tertiary}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="chev" Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                      <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                      <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Border x:Name="ring" Margin="-4" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" HorizontalOffset="-16" VerticalOffset="-12" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Margin="16,16,16,20" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.ControlLg}"
                      Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.5" Color="Black" /></Border.Effect>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="8,6" MinHeight="28">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Overlay.Chip}" /></Trigger>
                  <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Overlay.Pressed}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- settings group (DESIGN 8): a raised card that does not lift on hover; rows inside are Setting.Row, separated by hairlines. The first row's hairline is
       clipped away by the wrapper pattern:  <ContentControl Style=Card.Group><Border Padding="16,0" ClipToBounds="True"><StackPanel Margin="0,-1,0,0"> rows -->
  <Style x:Key="Card.Group" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,0,0,24" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Elevation.1}" />
            <ContentPresenter />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- one settings row (DESIGN 8): Header = label (Body), Tag = helper text (Secondary, optional), Content = the control, right-aligned and centred.
       Hairline above it (Divider); 12 px above and below. -->
  <Style x:Key="Setting.Row" TargetType="HeaderedContentControl">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0" MaxWidth="480">
                <ContentPresenter ContentSource="Header">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="hint" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Tag" Value=""><Setter TargetName="hint" Property="Visibility" Value="Collapsed" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
