<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Addon card icons: one family (rounded tile, vertical gradient, top highlight, inner shadow, cream silhouette). 128x128 design grid. -->

  <!-- ===================== Hunter Helper: wolf head + arrow, green ===================== -->
  <DrawingImage x:Key="Icon.Hunter">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,128,128" /></GeometryDrawing.Geometry></GeometryDrawing>
        <!-- tile -->
        <GeometryDrawing>
          <GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#7FAA45" Offset="0" /><GradientStop Color="#35551E" Offset="1" /></LinearGradientBrush></GeometryDrawing.Brush>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,128,128" RadiusX="28" RadiusY="28" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush><RadialGradientBrush Center="0.3,0.1" GradientOrigin="0.3,0.1" RadiusX="0.8" RadiusY="0.6"><GradientStop Color="#30FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></RadialGradientBrush></GeometryDrawing.Brush>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,128,128" RadiusX="28" RadiusY="28" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Thickness="3"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.45" /><GradientStop Color="#70000000" Offset="1" /></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="1.5,1.5,125,125" RadiusX="26.5" RadiusY="26.5" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Thickness="2"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#99FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="0.4" /></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="4,4,120,120" RadiusX="24" RadiusY="24" /></GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- arrow behind the head (accent), diagonal bottom-left to top-right -->
        <GeometryDrawing Brush="#F6B93B" Geometry="M18,112 L106,24" >
          <GeometryDrawing.Pen><Pen Brush="#F6B93B" Thickness="5" StartLineCap="Round" EndLineCap="Flat" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#F6B93B" Geometry="M116,12 L96,20 L108,32 Z" />
        <GeometryDrawing Brush="#F6B93B" Geometry="M14,116 L14,100 L22,108 Z M14,116 L30,116 L22,108 Z M22,108 L28,102 L26,96 Z" />

        <!-- wolf head -->
        <GeometryDrawing Brush="#F5ECD2" Geometry="M64,38 L51,35 L33,15 L28,50 L18,66 L32,70 L26,87 L43,85 L55,98 L64,104 L73,98 L85,85 L102,87 L96,70 L110,66 L100,50 L95,15 L77,35 Z">
          <GeometryDrawing.Pen><Pen Brush="#B8AB82" Thickness="2.5" LineJoin="Round" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- inner ears -->
        <GeometryDrawing Brush="#35551E" Geometry="M34,26 L46,38 L33,46 Z M94,26 L82,38 L95,46 Z" />
        <!-- forehead mark -->
        <GeometryDrawing Brush="#C9BC93" Geometry="M64,42 L72,56 L64,52 L56,56 Z" />
        <!-- eyes -->
        <GeometryDrawing Brush="#243A14" Geometry="M38,57 L56,62 L53,68 L41,65 Z M90,57 L72,62 L75,68 L87,65 Z" />
        <!-- muzzle + nose -->
        <GeometryDrawing Brush="#E3D6B0" Geometry="M52,80 L64,76 L76,80 L70,98 L64,102 L58,98 Z" />
        <GeometryDrawing Brush="#243A14" Geometry="M56,80 L72,80 L64,90 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

