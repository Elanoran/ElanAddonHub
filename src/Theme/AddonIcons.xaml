        <GeometryDrawing Brush="#7A4710" Geometry="M38,34 L90,34 L90,61 C90,81 78,95 64,105 C50,95 38,81 38,61 Z" />
        <!-- sun mark (accent) -->
        <GeometryDrawing Brush="#FFE08A"><GeometryDrawing.Geometry><EllipseGeometry Center="64,58" RadiusX="11" RadiusY="11" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FFE08A" Geometry="M67.2,43.0 L64.0,35.0 L60.8,43.0 Z M76.9,49.7 L80.3,41.7 L72.3,45.1 Z M79.0,61.2 L87.0,58.0 L79.0,54.8 Z M72.3,70.9 L80.3,74.3 L76.9,66.3 Z M60.8,73.0 L64.0,81.0 L67.2,73.0 Z M51.1,66.3 L47.7,74.3 L55.7,70.9 Z M49.0,54.8 L41.0,58.0 L49.0,61.2 Z M55.7,45.1 L47.7,41.7 L51.1,49.7 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

