  <!-- Addon card icons, WoW ability-icon look: beveled bronze frame, painted dusk background, rim-lit subject, vignette + gloss. 128x128 design grid. Original art. -->

  <!-- ===== shared pieces ===== -->
  <DrawingGroup x:Key="Draw.Frame">
    <GeometryDrawing>
      <GeometryDrawing.Brush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#F7DE8E" Offset="0" /><GradientStop Color="#B98A2E" Offset="0.3" /><GradientStop Color="#6E4813" Offset="0.62" /><GradientStop Color="#C79A3A" Offset="0.85" /><GradientStop Color="#5A3A10" Offset="1" />
        </LinearGradientBrush>
      </GeometryDrawing.Brush>
      <GeometryDrawing.Pen><Pen Brush="#1E1206" Thickness="1.6" /></GeometryDrawing.Pen>
      <GeometryDrawing.Geometry><RectangleGeometry Rect="0.8,0.8,126.4,126.4" RadiusX="15" RadiusY="15" /></GeometryDrawing.Geometry>
    </GeometryDrawing>
    <!-- bevel: light top-left, shadow bottom-right -->
    <GeometryDrawing>
      <GeometryDrawing.Pen>
        <Pen Thickness="2.4"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#E6FFF1B8" Offset="0" /><GradientStop Color="#00FFF1B8" Offset="0.45" /><GradientStop Color="#00000000" Offset="0.55" /><GradientStop Color="#99000000" Offset="1" />
        </LinearGradientBrush></Pen.Brush></Pen>
      </GeometryDrawing.Pen>
      <GeometryDrawing.Geometry><RectangleGeometry Rect="3,3,122,122" RadiusX="13" RadiusY="13" /></GeometryDrawing.Geometry>
    </GeometryDrawing>
    <!-- groove between frame and art -->
    <GeometryDrawing>
      <GeometryDrawing.Pen><Pen Brush="#25140A" Thickness="2.2" /></GeometryDrawing.Pen>
      <GeometryDrawing.Geometry><RectangleGeometry Rect="6.4,6.4,115.2,115.2" RadiusX="10" RadiusY="10" /></GeometryDrawing.Geometry>
    </GeometryDrawing>
    <GeometryDrawing>
      <GeometryDrawing.Pen>
        <Pen Thickness="1"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#99FFE9A0" Offset="1" />
        </LinearGradientBrush></Pen.Brush></Pen>
      </GeometryDrawing.Pen>
      <GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,112,112" RadiusX="9" RadiusY="9" /></GeometryDrawing.Geometry>
    </GeometryDrawing>
  </DrawingGroup>

