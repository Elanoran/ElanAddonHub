<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ElansAddonHub.Lodge"
                    xmlns:app="clr-namespace:ElansAddonHub">
  <!-- The profile card (a ProfileCardVM): banner in the accent colour, big avatar with class badge, name + rank, about, play times,
       now playing, characters (main marked). Used by the popout and by the live preview of the profile editor. Text.* styles, 4-pt scale;
       the name is the one semibold (character names in the list are the class colour, regular). Sits inside a Surface3 popover (radius 12). -->
  <DataTemplate x:Key="ProfileCard">
    <StackPanel Width="300">
      <Grid Height="88">
        <Border Height="56" VerticalAlignment="Top" Background="{Binding Banner}" CornerRadius="12,12,0,0" />
        <Border Height="56" VerticalAlignment="Top" CornerRadius="12,12,0,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.5" /><GradientStop Color="#40000000" Offset="1" /></LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,0" Width="76" Height="76" CornerRadius="38" Background="{StaticResource Brush.Surface3}" Padding="4">
          <local:AvatarView DataContext="{Binding Member}" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,8">
          <Ellipse Width="8" Height="8" Fill="{Binding OnlineBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="{Binding OnlineText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <StackPanel Margin="16,8,16,16">
        <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,0" Margin="8,0,0,0" Background="{Binding FrameBrush}" VerticalAlignment="Center">
            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.OnAccent}" VerticalAlignment="Center" />
          </Border>
          <TextBlock Style="{StaticResource Text.Section}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding LoginText, Mode=OneWay}" FontWeight="Normal" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" /></TextBlock>
        </DockPanel>
        <TextBlock Text="{Binding Member.CardClassLine}" Visibility="{Binding Member.CardClassVisibility}" Style="{StaticResource Text.Secondary}"
                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

        <!-- while the server is asked for the rest -->
        <StackPanel Visibility="{Binding LoadingVisibility}" Margin="0,12,0,0">
          <app:Skeleton Height="12" CornerRadius="6" />
          <app:Skeleton Height="12" Width="168" CornerRadius="6" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding NoteText}" Visibility="{Binding NoteShownVisibility}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <TextBlock Text="{Binding About}" Visibility="{Binding AboutVisibility}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding PlayTimesVisibility}" Margin="0,8,0,0">
          <TextBlock Text="&#xE823;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="{Binding PlayTimes}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" MaxWidth="248" />
        </StackPanel>

        <!-- now playing (from presence, only when they share it) -->
        <StackPanel Visibility="{Binding NowVisibility}" Margin="0,16,0,0">
          <TextBlock Text="Now playing" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBlock Text="{Binding NowClassLine}" Style="{StaticResource Text.Body}" Foreground="{Binding Member.ClassBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding NowLine}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>

        <!-- characters -->
        <StackPanel Visibility="{Binding CharsVisibility}" Margin="0,16,0,0">
          <TextBlock Text="Characters" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding Chars}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2" Opacity="{Binding HiddenOpacity}">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Line}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="152" />
                  <TextBlock Text="&#x2605;" Width="16" Style="{StaticResource Text.Caption}" Visibility="{Binding StarVisibility}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{Binding ClassBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
