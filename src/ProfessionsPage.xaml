<UserControl x:Class="ElansAddonHub.ProfessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub">
  <!-- page panel (DESIGN 4): the page sits on a scrim, not on the hero art -->
  <Border x:Name="Panel" Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" Margin="16,4,12,12" Padding="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- title -->
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock x:Name="TitleBlock" Text="Professions" Style="{StaticResource Text.Title}" />
        <TextBlock x:Name="Summary" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- what to look at -->
      <Border x:Name="TabStrip" Grid.Row="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabRecipes" Style="{StaticResource Segment}" Content="Recipes" GroupName="prof-view" IsChecked="True" Tag="recipes" Checked="Tab_Checked" AutomationProperties.Name="Recipes" />
          <RadioButton x:Name="TabGuide" Style="{StaticResource Segment}" Content="Leveling guide" GroupName="prof-view" Tag="guide" Checked="Tab_Checked" AutomationProperties.Name="Leveling guide" />
          <RadioButton x:Name="TabCraft" Style="{StaticResource Segment}" Content="Craft now" GroupName="prof-view" Tag="craft" Checked="Tab_Checked" AutomationProperties.Name="Craft now" />
          <RadioButton x:Name="TabCamp" Style="{StaticResource Segment}" Content="Camping" GroupName="prof-view" Tag="camp" Checked="Tab_Checked" AutomationProperties.Name="Camping" />
        </StackPanel>
      </Border>

      <!-- pickers: profession, character, search -->
      <WrapPanel x:Name="Pickers" Grid.Row="2" Margin="0,0,0,12">
        <ComboBox x:Name="ProfPicker" Style="{StaticResource Dropdown}" Width="200" Margin="0,0,8,8" SelectionChanged="Prof_Changed" AutomationProperties.Name="Profession" />
        <ComboBox x:Name="CharPicker" Style="{StaticResource Dropdown}" Width="240" Margin="0,0,8,8" SelectionChanged="Char_Changed" AutomationProperties.Name="Character" />
        <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="200" Margin="0,0,8,8" Tag="Search recipes" TextChanged="Search_Changed" AutomationProperties.Name="Search recipes" />
        <Border x:Name="FilterHost" Style="{StaticResource SegmentHost}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" Content="All" GroupName="prof-filter" IsChecked="True" Tag="all" Checked="Filter_Checked" AutomationProperties.Name="All recipes" />
            <RadioButton x:Name="FilterNow" Style="{StaticResource Segment}" Content="Can make now" GroupName="prof-filter" Tag="now" Checked="Filter_Checked" AutomationProperties.Name="Can learn now" />
            <RadioButton x:Name="FilterLater" Style="{StaticResource Segment}" Content="Later" GroupName="prof-filter" Tag="later" Checked="Filter_Checked" AutomationProperties.Name="Learnable later" />
          </StackPanel>
        </Border>
        <Border x:Name="KnownHost" Style="{StaticResource SegmentHost}" Margin="0,0,8,8" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="KnownAll" Style="{StaticResource Segment}" Content="Any" GroupName="prof-known" IsChecked="True" Tag="all" Checked="Known_Checked" AutomationProperties.Name="Learned or not" />
            <RadioButton x:Name="KnownYes" Style="{StaticResource Segment}" Content="Learned" GroupName="prof-known" Tag="learned" Checked="Known_Checked" AutomationProperties.Name="Learned recipes" />
            <RadioButton x:Name="KnownNo" Style="{StaticResource Segment}" Content="Not learned" GroupName="prof-known" Tag="notlearned" Checked="Known_Checked" AutomationProperties.Name="Recipes not learned" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <!-- the content of the chosen tab -->
      <ScrollViewer x:Name="BodyScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel x:Name="Body" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
