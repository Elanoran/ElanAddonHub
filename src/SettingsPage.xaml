<UserControl x:Class="ElansAddonHub.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub.Lodge"
             xmlns:app="clr-namespace:ElansAddonHub">
  <!-- Settings (DESIGN.md): nav card on the left, page title + sections on the right. Each section = Text.Section header (+ Secondary note), then a
       Card.Rows card of Setting.Row rows (hairlines between rows only) or a Card.Group card with a 16 px padded body. Sections are 24 apart. -->
  <UserControl.Resources>
    <!-- section list on the left: 36 high pill, the icon in the category's section hue (BorderBrush = Brush.Section.<Name>), hover veil, selected = the
         section's tint (Background = Brush.Section.<Name>.Tint) + a 4 px bar in its hue + Primary text (DESIGN 4, "Section colours") -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Background" Value="{StaticResource Brush.Section.Neutral.Tint}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Section.Neutral}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="GroupName" Value="nav" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Height="36" Background="Transparent">
              <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" />
              <Border x:Name="hv" Background="{StaticResource Brush.Overlay.Hover}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="ind" Width="4" Height="16" CornerRadius="2" Background="{TemplateBinding BorderBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
              <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{TemplateBinding BorderBrush}" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                <Ellipse x:Name="dot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource Brush.Warn}" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
              <Border x:Name="ring" Margin="-2" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="&#xEA18;"><Setter TargetName="dot" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" /></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" /></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="ind" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- section header + optional note, helper text under a control -->
    <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}"><Setter Property="Margin" Value="4,0,0,8" /></Style>
    <Style x:Key="HeadTight" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}"><Setter Property="Margin" Value="4,0,0,2" /></Style>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="4,0,0,8" />
      </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}"><Setter Property="Margin" Value="4,0,0,16" /></Style>

    <!-- a card with rows: hairlines between rows, none above the first (it is clipped) -->
    <Style x:Key="Card.Rows" TargetType="ContentControl">
      <Setter Property="Margin" Value="0,0,0,24" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Edge}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Effect="{StaticResource Elevation.1}" />
              <Border Padding="16,0" ClipToBounds="True"><ContentPresenter Margin="0,-1,0,0" /></Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      <Setter Property="TextDecorations" Value="{x:Null}" />
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="TextDecorations" Value="Underline" /></Trigger></Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,8,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{app:SideMenuColumn}" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- sections -->
    <Border x:Name="NavBox" Background="{StaticResource Brush.Section.Panel}" CornerRadius="{StaticResource Radius.Card}">
      <StackPanel Margin="8">
        <TextBlock Text="Settings" Style="{StaticResource Text.Caption}" Margin="12,8,0,8" />
        <RadioButton x:Name="NavGeneral" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.General}" Background="{StaticResource Brush.Section.General.Tint}" Tag="&#xE713;" Content="General" Checked="Nav_Checked" IsChecked="True" />
        <RadioButton x:Name="NavAddons" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.Addons}" Background="{StaticResource Brush.Section.Addons.Tint}" Tag="&#xEA86;" Content="Addons" Checked="Nav_Checked" />
        <RadioButton x:Name="NavLodge" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.Lodge}" Background="{StaticResource Brush.Section.Lodge.Tint}" Tag="&#xE716;" Content="Lodge" Checked="Nav_Checked" />
        <RadioButton x:Name="NavProfile" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.Profile}" Background="{StaticResource Brush.Section.Profile.Tint}" Tag="&#xE77B;" Content="Profile" Checked="Nav_Checked" />
        <RadioButton x:Name="NavPrivacy" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.Privacy}" Background="{StaticResource Brush.Section.Privacy.Tint}" Tag="&#xE72E;" Content="Privacy" Checked="Nav_Checked" />
        <RadioButton x:Name="NavVoice" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.Voice}" Background="{StaticResource Brush.Section.Voice.Tint}" Tag="&#xE720;" Content="Voice" Checked="Nav_Checked" />
        <RadioButton x:Name="NavOverlay" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.Overlay}" Background="{StaticResource Brush.Section.Overlay.Tint}" Tag="&#xE81E;" Content="In-game overlay" Checked="Nav_Checked" />
        <RadioButton x:Name="NavGm" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.GuildMaster}" Background="{StaticResource Brush.Section.GuildMaster.Tint}" Tag="&#xEA18;" Content="Guild Master" Checked="Nav_Checked" Visibility="Collapsed" />
        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" BorderBrush="{StaticResource Brush.Section.About}" Background="{StaticResource Brush.Section.About.Tint}" Tag="&#xE946;" Content="About" Checked="Nav_Checked" />
      </StackPanel>
    </Border>

    <!-- the page panel: pages sit on a scrim, never directly on the hero art -->
    <Border Grid.Column="2" Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Card}" Padding="24,24,8,16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <!-- Profile: sticky footer with the buttons and the inline status (DataContext = ProfileEditVM). An overlay: Surface3 + hairline + elevation 2. -->
      <Border x:Name="ProfileBar" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Card}" Padding="16,12" Margin="0,12,16,0" MaxWidth="680" Effect="{StaticResource Elevation.2}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary.M}" Content="Save profile" MinWidth="112"
                  IsEnabled="{Binding CanSave}" Click="ProfileSave_Click" ToolTip="Save your profile (everyone in the lodge sees it)" />
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.M}" Content="Discard changes" Margin="0,0,8,0"
                  Visibility="{Binding DiscardVisibility}" Click="ProfileDiscard_Click" ToolTip="Throw away your edits and reload your saved profile" />
          <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" app:Motion.EdgeFade="True">
        <Grid x:Name="SecHost" Margin="0,0,16,8" MaxWidth="680" HorizontalAlignment="Stretch">

          <!-- ========== General ========== -->
          <StackPanel x:Name="SecGeneral">
            <TextBlock Text="General" Style="{StaticResource PageTitle}" />
            <TextBlock Text="World of Warcraft folder" Style="{StaticResource HeadTight}" />
            <TextBlock Text="The main folder (with _retail_, _classic_beta_ ...). Each addon knows which client it belongs to." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Group}">
              <DockPanel Margin="16,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.M}" Content="Change" Margin="12,0,0,0" Click="ChangeFolder_Click" />
                <TextBlock x:Name="FolderText" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </ContentControl>
            <TextBlock Text="Game data" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl x:Name="ItemDataRow" Style="{StaticResource Setting.Row}" Header="Read item data from my WoW installation" Tag="Item names, levels, stats and prices come from your own game files, read-only, on this PC. Nothing is uploaded and nothing is written to the WoW folder.">
                <CheckBox x:Name="ItemDataBox" Style="{StaticResource Switch}" Click="General_Click" AutomationProperties.Name="Read item data from my WoW installation" />
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="WorldMapCacheRow" Style="{StaticResource Setting.Row}" Header="World map pictures and terrain" Tag="The Atlas world map is made from your game files the first time you open a continent (the 3D terrain and zone borders the first time you ask for them) and kept here until the game updates.">
                <Button x:Name="ClearWorldMapButton" Style="{StaticResource Button.M}" Content="Clear world map cache" Click="ClearWorldMap_Click" AutomationProperties.Name="Clear world map cache" />
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="WorldMapViewRow" Style="{StaticResource Setting.Row}" Header="World map view" Tag="Automatic: the 3D view when you pick it and your graphics can draw it; after a 3D problem the flat map is used and remembered, and the map offers to try 3D again. Flat only: the 3D view is never started.">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WorldMapAuto" Style="{StaticResource Segment}" Content="Automatic" GroupName="wm-view" Click="WorldMapView_Click" AutomationProperties.Name="World map view automatic" />
                    <RadioButton x:Name="WorldMapFlatOnly" Style="{StaticResource Segment}" Content="Flat only" GroupName="wm-view" Click="WorldMapView_Click" AutomationProperties.Name="World map view flat only" />
                  </StackPanel>
                </Border>
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="LivePosRow" Style="{StaticResource Setting.Row}" Header="Show my live position on the world map" Tag="Needs the matching option in Elan's Hub in game. The trail keeps the last 10 minutes and is never saved (only the simplified line of a flight is kept, for Learned flight routes).">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="LivePosHowToButton" Style="{StaticResource GhostButton}" Content="How to turn it on" Height="28" Padding="8,0" Margin="0,0,8,0" Click="LivePosHowTo_Click" AutomationProperties.Name="How to turn on live position" />
                  <CheckBox x:Name="LivePosBox" Style="{StaticResource Switch}" Click="LivePos_Click" VerticalAlignment="Center" AutomationProperties.Name="Show my live position on the world map" />
                </StackPanel>
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="LodgePosRow" Style="{StaticResource Setting.Row}" Header="Share my map position with the Lodge" Tag="Off by default. Everyone or officers only see your dot on their world map; never guests, and Appear offline hides it. Needs your zone shared.">
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource SegmentHost}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="LodgePosEveryone" Style="{StaticResource Segment}" Content="Everyone" GroupName="lodge-pos" Click="LodgePosScope_Click" AutomationProperties.Name="Share my map position with everyone in the Lodge" />
                      <RadioButton x:Name="LodgePosOfficers" Style="{StaticResource Segment}" Content="Officers" GroupName="lodge-pos" Click="LodgePosScope_Click" AutomationProperties.Name="Share my map position with officers only" />
                    </StackPanel>
                  </Border>
                  <CheckBox x:Name="LodgePosBox" Style="{StaticResource Switch}" Click="LodgePos_Click" VerticalAlignment="Center" AutomationProperties.Name="Share my map position with the Lodge" />
                </StackPanel>
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="LearnedFlightsRow" Style="{StaticResource Setting.Row}" Header="Learned flight routes">
                <Button x:Name="ClearLearnedFlightsButton" Style="{StaticResource Button.M}" Content="Clear learned routes" Click="ClearLearnedFlights_Click" AutomationProperties.Name="Clear learned flight routes" />
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="WorldMap3dRow" Style="{StaticResource Setting.Row}" Header="World map 3D detail" Tag="How much terrain and texture detail the 3D view draws. Low is easiest on the graphics card.">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Detail3dLow" Style="{StaticResource Segment}" Content="Low" GroupName="wm3d-detail" Click="WorldMap3d_Click" AutomationProperties.Name="3D detail low" />
                    <RadioButton x:Name="Detail3dMedium" Style="{StaticResource Segment}" Content="Medium" GroupName="wm3d-detail" Click="WorldMap3d_Click" AutomationProperties.Name="3D detail medium" />
                    <RadioButton x:Name="Detail3dHigh" Style="{StaticResource Segment}" Content="High" GroupName="wm3d-detail" Click="WorldMap3d_Click" AutomationProperties.Name="3D detail high" />
                  </StackPanel>
                </Border>
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="WorldMapBuildingsRow" Style="{StaticResource Setting.Row}" Header="World map 3D buildings" Tag="Building shapes for the 3D world map.">
                <StackPanel x:Name="WorldMapBuildingsButtons" Orientation="Vertical" HorizontalAlignment="Right" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="World map 3D height" Tag="How tall the land is in the 3D view: 1x is true to the game (the middle), lower flattens it, higher makes the mountains taller.">
                <StackPanel Orientation="Horizontal">
                  <Slider x:Name="Exag3dSlider" Minimum="0.5" Maximum="1.5" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" ValueChanged="Exag3d_Changed" AutomationProperties.Name="3D height exaggeration" />
                  <TextBlock x:Name="Exag3dText" Style="{StaticResource Text.Secondary}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Startup" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Run in background" Tag="Closing the window keeps the Outpost in the tray: updates are checked and you stay online in the lodge.">
                <CheckBox x:Name="BackgroundBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Start with Windows" Tag="Starts quietly in the tray when you log in.">
                <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Open elanshub:// links with the Outpost" Tag="Clicking an invite link in Discord, a browser or an email opens the Outpost with the join filled in. Nothing is joined until you press Join.">
                <CheckBox x:Name="LinkBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Realm status" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl x:Name="RealmStatusRow" Style="{StaticResource Setting.Row}" Header="Show realm status at the top" Tag="Small dots for the WoW Forever realms, green when up and red when down. They come from your Lodge, only appear while you are connected to a Lodge that offers realm status, and nothing is sent from your PC.">
                <CheckBox x:Name="RealmStatusBox" Style="{StaticResource Switch}" Click="General_Click" AutomationProperties.Name="Show realm status at the top" />
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="RealmsBackRow" Style="{StaticResource Setting.Row}" Header="Tell me when the realms come back up" Tag="A quiet note over the game, once, when a realm that was down is up again. Follows the in-game notifications switch; never a pop-up window.">
                <CheckBox x:Name="RealmsBackBox" Style="{StaticResource Switch}" Click="General_Click" AutomationProperties.Name="Tell me when the realms come back up" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <DockPanel Margin="0,0,0,0">
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" VerticalAlignment="Bottom" Margin="0,0,4,8"><Hyperlink NavigateUri="https://radioparadise.com/donate" RequestNavigate="Link_Navigate">Support Radio Paradise</Hyperlink></TextBlock>
              <TextBlock Text="Radio Paradise" Style="{StaticResource Head}" />
            </DockPanel>
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Radio player in the title bar" Tag="Listener-supported radio from radioparadise.com, next to the search box. Nothing plays or connects until you press Play, and Pause closes the stream.">
                <CheckBox x:Name="RadioBox" Style="{StaticResource Switch}" Click="Radio_Click" AutomationProperties.Name="Radio player in the title bar" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Favourite channel" Tag="The player starts on this channel. Picking another one in the player is just for that session.">
                <ComboBox x:Name="RadioFavBox" Style="{StaticResource Dropdown}" Width="180" SelectionChanged="RadioFav_Changed" AutomationProperties.Name="Favourite channel" />
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="RadioQualityRow" Style="{StaticResource Setting.Row}" Header="Sound quality" Tag="Data per hour of listening: Standard about 90 MB, High about 145 MB, Lossless up to about 0.5 GB. The lossless streams send no song titles or covers. You can also switch it in the player's pop-out.">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioQualityStd" Style="{StaticResource Segment}" Content="Standard" GroupName="rq" Checked="RadioQuality_Changed" ToolTip="MP3 192 kbit/s (Serenity: AAC 64 kbit/s, the only lossy stream it has)" AutomationProperties.Name="Sound quality standard" />
                    <RadioButton x:Name="RadioQualityHigh" Style="{StaticResource Segment}" Content="High" GroupName="rq" Checked="RadioQuality_Changed" ToolTip="AAC 320 kbit/s (Serenity: AAC 64 kbit/s)" AutomationProperties.Name="Sound quality high" />
                    <RadioButton x:Name="RadioQualityLossless" Style="{StaticResource Segment}" Content="Lossless" GroupName="rq" Checked="RadioQuality_Changed" ToolTip="FLAC, about 1 Mbit/s. Radio 2050 has no lossless stream: it plays High." AutomationProperties.Name="Sound quality lossless" />
                  </StackPanel>
                </Border>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show album covers (from the stream)" Tag="The stream names the cover of the song that is playing; the Outpost fetches that picture from img.radioparadise.com once per song, only while you listen, and keeps it on your PC. Off: a music note instead, and no pictures are fetched.">
                <CheckBox x:Name="RadioCoversBox" Style="{StaticResource Switch}" Click="RadioCovers_Click" AutomationProperties.Name="Show album covers (from the stream)" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Music while people talk" Tag="In a Lodge voice room the music fades to this part of its volume while anyone talks, you included, and comes back when they stop. 0 % is silent.">
                <StackPanel Orientation="Horizontal">
                  <Slider x:Name="RadioDuckSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" ValueChanged="RadioDuck_Changed" AutomationProperties.Name="Music while people talk" />
                  <TextBlock x:Name="RadioDuckText" Style="{StaticResource Text.Secondary}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
              </HeaderedContentControl>
            </StackPanel></ContentControl>
          </StackPanel>

          <!-- ========== Addons ========== -->
          <StackPanel x:Name="SecAddons" Visibility="Collapsed">
            <TextBlock Text="Addons" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Update channel" Style="{StaticResource Head}" />
            <Border Style="{StaticResource SegmentHost}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ChannelStable" Style="{StaticResource Segment}" Content="Stable" GroupName="channel" Checked="Channel_Changed" />
                <RadioButton x:Name="ChannelTest" Style="{StaticResource Segment}" Content="Test (get new builds first)" GroupName="channel" Checked="Channel_Changed" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ChannelHint" Style="{StaticResource Note}" Margin="4,8,0,24" />
            <TextBlock Text="Updates" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Update addons automatically" Tag="Install new addon versions as soon as they're out (the Outpost itself always asks).">
                <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Check CurseForge for updates automatically" Tag="For addons the CurseForge app manages: about once a day and when WoW starts, the Outpost lets CurseForge refresh (it is started minimized and closed again; skipped if it is already running).">
                <CheckBox x:Name="CfAutoBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Appearance" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show splash screen" Tag="A short campfire animation while the Outpost starts. Never shown when it starts quietly in the tray.">
                <CheckBox x:Name="SplashBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Card artwork: painted pictures" Tag="Off = the clean vector icons (default). On = the original painted pictures on the addon cards.">
                <CheckBox x:Name="PaintedBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="CurseForge" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Group}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
              <DockPanel Margin="16,12">
                <Button x:Name="CfRecheck" DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Re-check" Margin="12,0,0,0" Click="CfRecheck_Click" />
                <Ellipse x:Name="CfDot" DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="CfStatusText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Update CurseForge addons directly (recommended)" Tag="The Outpost downloads the update CurseForge lists from CurseForge's own download server, checks its size and checksum, keeps a backup and swaps the folders - no 'Select game instance' window. Addons whose author only allows updates through CurseForge, or that need another addon first, still go through the CurseForge app. Off = always ask the CurseForge app.">
                <CheckBox x:Name="CfDirectBox" Style="{StaticResource Switch}" Click="General_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Let CurseForge install author-restricted addons by itself (no 'Select game instance' window)" Tag="For addons the Outpost can't update itself: when CurseForge's own auto-update is on for the addon, CurseForge installs the update (started minimized and closed again if it isn't running) instead of being sent its install link. Off = always send the install link.">
                <CheckBox x:Name="CfLetBox" Style="{StaticResource Switch}" Click="General_Click" AutomationProperties.Name="Let CurseForge install author-restricted addons by itself" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Button.M}" Content="Check for updates now" Click="CheckNow_Click" />
              <Button Style="{StaticResource Button.M}" Content="Open backups folder" Margin="8,0,0,0" Click="Backups_Click" />
            </StackPanel>
            <TextBlock x:Name="CheckText" Style="{StaticResource Text.Secondary}" Margin="4,8,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <!-- ========== Lodge ========== -->
          <StackPanel x:Name="SecLodge" Visibility="Collapsed">
            <TextBlock Text="Lodge" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Connection" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Group}">
              <StackPanel Margin="16">
                <TextBlock x:Name="LodgeAddress" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LodgeWho" Style="{StaticResource Text.Secondary}" Margin="0,2,0,12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource Button.M}" Content="Edit connection" Click="EditConnection_Click" />
                </StackPanel>
              </StackPanel>
            </ContentControl>
            <TextBlock Text="Your devices" Style="{StaticResource HeadTight}" />
            <TextBlock x:Name="DevicesNote" Style="{StaticResource Note}" Text="Each PC you sign in from has its own key. Sign one out here and it is disconnected at once." />
            <ContentControl Style="{StaticResource Card.Rows}" Margin="0,0,0,12">
              <StackPanel>
                <!-- Lodge 2.31.2: a device someone else added to this account (device.added) -->
                <ItemsControl x:Name="DeviceNoticeRows" Visibility="Collapsed">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="0,10">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Dismiss" Tag="{Binding Id}" Click="DismissNotice_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Dismiss this notice" ToolTip="It was me or someone I trust - keep the device" />
                          <Button DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Remove" Tag="{Binding Id}" Click="RemoveNoticed_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Remove this device" ToolTip="Sign this device out of your account at once" />
                          <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Warn}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="MyDevicesEmpty" Style="{StaticResource Text.Secondary}" Margin="0,12" TextWrapping="Wrap" Text="Nothing to show yet." />
                <ItemsControl x:Name="MyDeviceRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Sign out" Tag="{Binding Id}" Click="RevokeDevice_Click"
                                  AutomationProperties.Name="Sign out this device" />
                          <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,8,0" Visibility="{Binding CurrentVisibility}" VerticalAlignment="Center">
                            <TextBlock Text="This PC" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="UpgradeDeviceButton" Style="{StaticResource Button.M}" Content="Upgrade this device" HorizontalAlignment="Left" Margin="0,4,0,12" Visibility="Collapsed"
                        Click="UpgradeDevice_Click" ToolTip="Swap the saved permanent code for a key only this PC holds" />
              </StackPanel>
            </ContentControl>
            <TextBlock Text="Calendar" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show upcoming events above the chat" Tag="The next one to three events of the week as small cards under the channel name. Nothing shows when there are none.">
                <CheckBox x:Name="EventsStripBox" Style="{StaticResource Switch}" Click="Lodge_Click" AutomationProperties.Name="Show upcoming events above the chat" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show in-game WoW events" Tag="Holidays, raid resets and your own in-game calendar events, read from Elan's Hub in your game. They stay on this PC, are never sent to the Lodge, and update after a /reload or logout.">
                <CheckBox x:Name="WowEventsBox" Style="{StaticResource Switch}" Click="Lodge_Click" AutomationProperties.Name="Show in-game WoW events" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Flight times" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Share flight times with the lodge" Tag="Your learned flight-path times are shared, and so are the flight routes your flights learned (the simplified line between two flight masters, where WoW Forever flies differently from the game files); you get everyone's. Nothing else. With this off nothing is uploaded, but you still receive everyone's.">
                <CheckBox x:Name="FlightShareBox" Style="{StaticResource Switch}" Click="Lodge_Click" AutomationProperties.Name="Share flight times with the lodge" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Atlas" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Share my Atlas observations with this Lodge" Tag="What Elan's Toolkit saw in game (drops, vendors, finds, spawn points) is pooled with the lodge; you get everyone's totals. No character names. Guests never share. With this off nothing is uploaded, but you still receive the lodge's Atlas.">
                <CheckBox x:Name="AtlasShareBox" Style="{StaticResource Switch}" Click="Lodge_Click" AutomationProperties.Name="Share my Atlas observations with this Lodge" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Armory" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Share my characters with the Lodge" Tag="Off until you turn it on. Then only the characters you tick below are shared: what they wear (with enchants), their stats, talents, professions (with the recipes they have learned, on a Lodge with server 2.19 or newer) and hunter pets, so friends can look at them on the Characters page. Never your bags, bank, gold or mail. Unticking a character, or turning this off, removes it from the Lodge again.">
                <CheckBox x:Name="ArmoryShareBox" Style="{StaticResource Switch}" Click="Armory_Click" AutomationProperties.Name="Share my characters with the Lodge" />
              </HeaderedContentControl>
              <StackPanel x:Name="ArmoryCharsPanel" Visibility="Collapsed">
                <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Also share their reputations" Tag="Off until you turn it on. Then the characters you tick below also tell the Lodge their standing with each faction (Hated to Exalted, and how far along), so friends see it on the Atlas faction pages. Only the faction, the standing and the progress - nothing else. Needs Elan's Hub 1.16.0 and a Lodge that supports it. Turning it off removes them from the Lodge again.">
                  <CheckBox x:Name="ArmoryRepsBox" Style="{StaticResource Switch}" Click="ArmoryReps_Click" AutomationProperties.Name="Also share their reputations" />
                </HeaderedContentControl>
                <StackPanel x:Name="ArmoryCharsHost" />
                <TextBlock x:Name="ArmoryCharsNote" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="16,8,16,12" />
              </StackPanel>
            </StackPanel></ContentControl>
            <TextBlock Text="Classic data" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Get Classic data from my Lodge automatically" Tag="When your Lodge hosts the Classic data (the public cMaNGOS classic-db, with its licence and credit), this PC fetches it from the Lodge by itself, so you don't have to download it. It stays labelled Classic baseline. With this off, the Atlas page still offers the download.">
                <CheckBox x:Name="ClassicAutoBox" Style="{StaticResource Switch}" Click="ClassicAuto_Click" AutomationProperties.Name="Get Classic data from my Lodge automatically" />
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="ClassicLodgeRow" Style="{StaticResource Setting.Row}" Header="Classic data for the Lodge" Tag="Host the Classic data you have on this PC, unchanged, so every member gets it automatically. Only officers and the owner can." Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ClassicShareButton" Style="{StaticResource Button.M}" Content="Share my Classic data with the Lodge" Click="ClassicShare_Click" Visibility="Collapsed" />
                  <Button x:Name="ClassicUnshareButton" Style="{StaticResource Button.M}" Content="Stop hosting" Margin="8,0,0,0" Click="ClassicUnshare_Click" Visibility="Collapsed" />
                </StackPanel>
              </HeaderedContentControl>
              <TextBlock x:Name="ClassicStatus" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="16,8,16,12" />
            </StackPanel></ContentControl>
            <StackPanel x:Name="LadderSettings" Visibility="Collapsed">
            <TextBlock Text="Ladder" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Hide me from the ladder" Tag="You still earn badges and they still show on your profile; your name just is not listed on the Lodge's ladder. Off by default.">
                <CheckBox x:Name="HideLadderBox" Style="{StaticResource Switch}" Click="HideLadder_Click" AutomationProperties.Name="Hide me from the ladder" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            </StackPanel>
            <TextBlock Text="Presence" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Connect when the Outpost starts" Tag="Friends see you online while the Outpost runs.">
                <CheckBox x:Name="AutoConnectBox" Style="{StaticResource Switch}" Click="Lodge_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="What I share, my status and Appear offline" Tag="Those switches live in one place: Privacy.">
                <Button Style="{StaticResource Button.M}" Content="Open Privacy" Click="OpenPrivacy_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>

            <!-- Danger zone: two different things. Sign out = forget this PC only. Leave = leave the lodge for good. -->
            <TextBlock Text="Danger zone" Style="{StaticResource Head}" />
            <TextBlock Style="{StaticResource Note}" Text="Signing out only forgets this PC. Leaving removes you from the lodge itself." />
            <ContentControl Style="{StaticResource Card.Rows}" Margin="0,0,0,12"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Sign out this PC" Tag="Forgets the sign-in on this PC only. You, your other devices and your messages stay; a new invite link brings this PC back.">
                <Button x:Name="SignOutPcButton" Style="{StaticResource Button.M}" Content="Sign out this PC" Click="SignOutPc_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Leave the lodge" Tag="Removes you from the lodge for good: your name, all your devices and your open invite links. Your messages stay, with your name on them.">
                <Button x:Name="LeaveLodgeButton" Style="{StaticResource Button.Danger.M}" Content="Leave the lodge" Click="LeaveLodge_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <Border x:Name="TransferPanel" Visibility="Collapsed" Background="{StaticResource Brush.Surface2}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="TransferTitle" Text="Transfer ownership first" Style="{StaticResource Text.RowTitle}" />
                <TextBlock x:Name="TransferText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="You are the last Guild Master, and a lodge always needs one. Pick someone to take over; afterwards you can leave, or stay." />
                <DockPanel x:Name="TransferRow" Margin="0,12,0,0">
                  <Button x:Name="TransferButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary.M}" Content="Transfer ownership" Margin="8,0,0,0" Click="Transfer_Click" />
                  <ComboBox x:Name="TransferPick" Style="{StaticResource Dropdown}" />
                </DockPanel>
                <TextBlock x:Name="TransferEmpty" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"
                           Text="There is nobody else in the lodge to take over. Invite someone first (Guild Master, Invite someone)." />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========== Profile ========== -->
          <StackPanel x:Name="SecProfile" Visibility="Collapsed">
            <TextBlock Text="Profile" Style="{StaticResource PageTitle}" />

            <!-- not connected / old server -->
            <ContentControl x:Name="ProfileEmpty" Style="{StaticResource Card.Group}" Visibility="Collapsed">
              <StackPanel Margin="16">
                <TextBlock x:Name="ProfileEmptyTitle" Style="{StaticResource Text.Section}" TextWrapping="Wrap" />
                <TextBlock x:Name="ProfileEmptyText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Button x:Name="ProfileEmptyButton" Style="{StaticResource Button.M}" Content="Go to the Lodge tab" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ProfileGoLodge_Click" />
              </StackPanel>
            </ContentControl>

            <!-- the form (DataContext = ProfileEditVM) -->
            <StackPanel x:Name="ProfileForm">
              <TextBlock Text="Your display name, avatar, a few words about you and your characters. Only what you choose here is shared." Style="{StaticResource Note}" Margin="4,0,0,16" />
              <TextBlock Text="You joined as a guest: your profile is kept only until you leave the lodge." Visibility="{Binding GuestVisibility}" Style="{StaticResource Text.Secondary}"
                         Foreground="{StaticResource Brush.Warn}" TextWrapping="Wrap" Margin="4,0,0,16" />

              <!-- live preview -->
              <ContentControl Style="{StaticResource Card.Group}" HorizontalAlignment="Center" Margin="0,0,0,8">
                <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ProfileCard}" />
              </ContentControl>
              <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" />

              <StackPanel Visibility="{Binding DisplayVisibility}">
                <TextBlock Text="Display name" Style="{StaticResource Head}" />
                <ContentControl Style="{StaticResource Card.Group}" Margin="0,0,0,24">
                  <StackPanel Margin="16">
                    <TextBox x:Name="DisplayBox" Style="{StaticResource Input}" Height="32" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" IsEnabled="{Binding DisplayEnabled}"
                             Tag="Shown instead of your login name" />
                    <TextBlock Text="{Binding DisplayHint}" Foreground="{Binding DisplayHintBrush}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </ContentControl>
              </StackPanel>

              <TextBlock Text="Avatar" Style="{StaticResource Head}" />
              <ContentControl Style="{StaticResource Card.Group}">
                <ItemsControl ItemsSource="{Binding Avatars}" Margin="12">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="ring" Width="64" Height="64" CornerRadius="32" BorderThickness="3" BorderBrush="{Binding RingBrush}" Margin="4" Cursor="Hand"
                              Background="Transparent" Tag="{Binding}" ToolTip="{Binding Name}" MouseLeftButtonUp="Avatar_Click">
                        <Grid Margin="2">
                          <Image Source="{Binding Image}" Visibility="{Binding ImageVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                          <local:AvatarView DataContext="{Binding DefaultLook}" Visibility="{Binding DataContext.DefaultVisibility, RelativeSource={RelativeSource AncestorType=Grid}}" />
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <Trigger SourceName="ring" Property="IsMouseOver" Value="True">
                          <Setter TargetName="ring" Property="Background" Value="{StaticResource Brush.Overlay.Hover}" />
                        </Trigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ContentControl>

              <TextBlock Text="Accent colour" Style="{StaticResource Head}" />
              <ContentControl Style="{StaticResource Card.Group}">
                <ItemsControl ItemsSource="{Binding Swatches}" Margin="16,12">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="{Binding RingBrush}" Margin="0,0,8,0" Cursor="Hand" Background="Transparent"
                              Tag="{Binding}" ToolTip="{Binding Name}" MouseLeftButtonUp="Swatch_Click">
                        <Grid>
                          <Ellipse Margin="4" Fill="{Binding Fill}" />
                          <Ellipse Margin="4" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeDashArray="2 2" Visibility="{Binding NoneVisibility}" />
                          <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding NoneVisibility}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ContentControl>

              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AboutCounter}" Foreground="{Binding AboutCounterBrush}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="0,0,4,8" />
                <TextBlock Text="About you" Style="{StaticResource Head}" />
              </DockPanel>
              <ContentControl Style="{StaticResource Card.Group}">
                <TextBox x:Name="AboutBox" Style="{StaticResource Input}" Margin="16" Text="{Binding About, UpdateSourceTrigger=PropertyChanged}" MaxLength="140" TextWrapping="Wrap"
                         AcceptsReturn="False" Height="64" VerticalContentAlignment="Top" Tag="A few words - what you like to do, who you play with" />
              </ContentControl>

              <TextBlock Text="When you play" Style="{StaticResource Head}" />
              <ContentControl Style="{StaticResource Card.Group}">
                <TextBox Style="{StaticResource Input}" Margin="16" Height="32" Text="{Binding PlayTimes, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Tag="e.g. evenings CET, weekends" />
              </ContentControl>

              <TextBlock Text="Characters" Style="{StaticResource Head}" />
              <ContentControl Style="{StaticResource Card.Group}">
                <StackPanel Margin="16,12">
                  <TextBlock Text="Characters appear here after you have played them with the Outpost running - it reads your character from WoW." Visibility="{Binding NoCharsVisibility}"
                             Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                  <StackPanel Visibility="{Binding CharsVisibility}">
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="Main character" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Width="120" />
                      <ComboBox x:Name="MainBox" Style="{StaticResource Dropdown}" ItemsSource="{Binding MainChoices}" SelectedItem="{Binding MainChoice, Mode=TwoWay}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Chars}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,4" Opacity="{Binding HiddenOpacity}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Hidden, Mode=TwoWay}" Tag="{Binding}" Click="Hide_Click" ToolTip="Hide this character from others" />
                            <TextBlock DockPanel.Dock="Right" Text="Hide" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="&#x2605;" Width="16" FontSize="12" Foreground="{StaticResource Brush.Warn}" Visibility="{Binding StarVisibility}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.RowTitle}" Foreground="{Binding ClassBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ContentControl>

              <TextBlock Text="Privacy" Style="{StaticResource HeadTight}" />
              <TextBlock Text="Your avatar and name are always visible. While you appear offline, your profile details are hidden from people who can not see you." Style="{StaticResource Note}" />
              <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
                <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show my characters">
                  <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Segment}" Content="All" GroupName="pe-show" IsChecked="{Binding ShowAll, Mode=TwoWay}" />
                      <RadioButton Style="{StaticResource Segment}" Content="Main only" GroupName="pe-show" IsChecked="{Binding ShowMain, Mode=TwoWay}" />
                      <RadioButton Style="{StaticResource Segment}" Content="None" GroupName="pe-show" IsChecked="{Binding ShowNone, Mode=TwoWay}" />
                    </StackPanel>
                  </Border>
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Who can see my profile">
                  <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Segment}" Content="Everyone" GroupName="pe-vis" IsChecked="{Binding VisEveryone, Mode=TwoWay}" />
                      <RadioButton Style="{StaticResource Segment}" Content="Officers only" GroupName="pe-vis" IsChecked="{Binding VisOfficers, Mode=TwoWay}" />
                    </StackPanel>
                  </Border>
                </HeaderedContentControl>
              </StackPanel></ContentControl>

              <TextBlock x:Name="BadgesHead" Text="Badges" Style="{StaticResource Head}" Visibility="Collapsed" />
              <ContentControl x:Name="BadgesCard" Style="{StaticResource Card.Rows}" Visibility="Collapsed"><StackPanel>
                <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Your badges" Tag="Earned just by taking part, never asked of you. Everything you have earned, and how to earn the rest.">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="BadgesDot" Width="8" Height="8" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="New badges since you last looked" />
                    <Button x:Name="BadgesToggle" Style="{StaticResource Button.M}" Content="Show my badges" Click="BadgesToggle_Click" AutomationProperties.Name="Show my badges" />
                  </StackPanel>
                </HeaderedContentControl>
                <StackPanel x:Name="BadgesBody" Margin="16,0,16,16" Visibility="Collapsed">
                  <local:BadgesPanel x:Name="BadgesPanelHost" />
                </StackPanel>
              </StackPanel></ContentControl>
            </StackPanel>
          </StackPanel>

          <!-- ========== Privacy ========== -->
          <StackPanel x:Name="SecPrivacy" Visibility="Collapsed">
            <TextBlock Text="Privacy" Style="{StaticResource PageTitle}" />
            <TextBlock Text="What the Outpost shares, with whom, and where you can switch it off. Every sharing switch lives here, and only here; the Lodge page links to this one." Style="{StaticResource Note}" Margin="4,0,0,4" />
            <TextBlock x:Name="PrivacyLodgeLine" Style="{StaticResource Text.Secondary}" Margin="4,0,0,16" TextWrapping="Wrap" />
            <TextBlock Text="Shared with your lodge" Style="{StaticResource HeadTight}" />
            <TextBlock Text="Only the people on the Lodge server you joined see this, and only while you are connected." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl x:Name="PvShareGameRow" Style="{StaticResource Setting.Row}" Header="What I'm playing" Tag="Your character's name, race, class and level, and that WoW is running.">
                <CheckBox x:Name="PvShareGame" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="My zone" Tag="The zone or dungeon you are in. Off = no zone or instance name is sent.">
                <CheckBox x:Name="PvShareZone" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="My XP" Tag="Your XP percentage and whether you are rested.">
                <CheckBox x:Name="PvShareXp" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Automatic status" Tag="In combat shows as Busy, the game's AFK flag as AFK. A status you chose yourself is never changed.">
                <CheckBox x:Name="PvAutoStatus" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="AFK after 10 idle minutes" Tag="Based on mouse and keyboard, also while you are in WoW.">
                <CheckBox x:Name="PvAutoAway" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Appear offline right now" Tag="Hides you from members who may not see invisible people. Your messages in channels stay visible.">
                <CheckBox x:Name="PvInvisible" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Remember Appear offline" Tag="Off = you are visible again every time the Outpost starts.">
                <CheckBox x:Name="PvRememberInvis" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Typing" Tag="People in the same channel see &quot;... is typing&quot; while you type there. This is always on.">
                <Border Style="{StaticResource Chip}" VerticalAlignment="Center"><TextBlock Text="Always on" Style="{StaticResource Text.Secondary}" /></Border>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Profile" Tag="Display name, avatar, about text, characters - only what you fill in, and you choose who may see it (everyone or officers only).">
                <Button Style="{StaticResource Button.M}" Content="Edit profile" Click="PrivacyProfile_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl x:Name="PvCairnRow" Style="{StaticResource Setting.Row}" Header="The Cairn's shared data" Tag="The Cairn's shared data is for those who share: with &quot;Share my Atlas observations with this Lodge&quot; on (Settings &gt; Lodge), your Lodge also gives you the Cairn's numbers from other Lodges - drop rates, vendor items, spawn points, gathering nodes and flight times, ids and counts only. They show as &quot;Cairn&quot; in the Atlas, below your own Lodge's. It comes only from your Lodge, never from the internet. With sharing off nothing comes and the copy on this PC is deleted; guests and players without a Lodge get none.">
                <Button Style="{StaticResource Button.M}" Content="Sharing settings" Click="PrivacyAtlasShare_Click" AutomationProperties.Name="Open the Atlas sharing switch in Settings, Lodge" />
              </HeaderedContentControl>
              <TextBlock x:Name="PvCairnStatus" Style="{StaticResource Note}" Margin="16,0,16,12" TextWrapping="Wrap" />
            </StackPanel></ContentControl>
            <TextBlock Text="Fetched from other sites" Style="{StaticResource HeadTight}" />
            <TextBlock Text="Only what you switch on. Off = the Outpost never contacts these sites by itself." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show video previews" Tag="A YouTube link in the Lodge chat shows its thumbnail, title and channel, and plays in a window here. To do that the Outpost asks youtube.com and i.ytimg.com (YouTube sees your IP address). Off = links stay plain text, nothing is fetched, and a click opens the link in your browser.">
                <CheckBox x:Name="PvVideo" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Outpost browser" Style="{StaticResource HeadTight}" />
            <TextBlock Text="The Browser page in the left rail. Permission requests (camera, location, notifications...) are always refused, and no password is ever saved." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Search engine" Tag="Used when you type words instead of an address.">
                <ComboBox x:Name="PvBrSearch" Style="{StaticResource Dropdown}" Width="180" SelectionChanged="BrowserSearch_Changed" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Private browsing" Tag="On = cookies, history and cache are forgotten when the Outpost closes. Off = logins are kept on this PC (in the Outpost's data folder) so sites remember you. Changing this closes the open tabs.">
                <CheckBox x:Name="PvBrPrivate" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Block ads and trackers" Tag="A small built-in list of well-known ad and tracking hosts is refused. Tracking prevention is always on Strict.">
                <CheckBox x:Name="PvBrAds" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Open links from chat in the Outpost browser" Tag="Off = a link in the Lodge chat opens in your default browser. YouTube links keep their own player.">
                <CheckBox x:Name="PvBrChat" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Stays on your PC" Style="{StaticResource HeadTight}" />
            <TextBlock Text="Read and used here only. Nothing below is uploaded." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Detect my character live" Tag="Looks at a tiny strip of pixels in the top-left corner of the WoW window (no memory reading, nothing sent to the game). The pixels never leave your PC; the result only feeds the sharing switches above.">
                <CheckBox x:Name="PvPixel" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Inventory" Tag="Read from Elan's Bags' saved data on your disk. Never uploaded. Item tooltips from it show only in your own game.">
                <Border Style="{StaticResource Chip}" VerticalAlignment="Center"><TextBlock Text="Local only" Style="{StaticResource Text.Secondary}" /></Border>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Addon health reports" Tag="Read from your saved variables. Nothing is sent. &quot;Copy report&quot; only fills your clipboard (names replaced by char1, char2 ...) - you decide where to paste it.">
                <Border Style="{StaticResource Chip}" VerticalAlignment="Center"><TextBlock Text="Local only" Style="{StaticResource Text.Secondary}" /></Border>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="CurseForge" Tag="The Outpost only reads CurseForge's local files to show its addons. Optionally it lets CurseForge refresh its own update info about once a day and when WoW starts.">
                <CheckBox x:Name="PvCfAuto" Style="{StaticResource Switch}" Click="Privacy_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Update checks" Tag="Asking github.com for the Outpost's own releases, and for addons you linked: api.github.com or WoWInterface's public file list (api.mmoui.com). Plain public requests, no account or login; those sites see your IP address and the name &quot;ElansAddonHub/version&quot;, like any download.">
                <Border Style="{StaticResource Chip}" VerticalAlignment="Center"><TextBlock Text="Public requests" Style="{StaticResource Text.Secondary}" /></Border>
              </HeaderedContentControl>
            </StackPanel></ContentControl>
          </StackPanel>

          <!-- ========== Voice ========== -->
          <StackPanel x:Name="SecVoice" Visibility="Collapsed">
            <TextBlock Text="Voice" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,16">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeVa" Style="{StaticResource Segment}" Content="Voice activation" GroupName="mode" Checked="Voice_Changed" />
                <RadioButton x:Name="ModePtt" Style="{StaticResource Segment}" Content="Push to talk" GroupName="mode" Checked="Voice_Changed" />
              </StackPanel>
            </Border>
            <ContentControl x:Name="VaPanel" Style="{StaticResource Card.Group}">
              <StackPanel Margin="16,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" x:Name="ThresholdText" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                  <TextBlock Text="Sensitivity" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,4,0,0">
                  <Slider x:Name="ThresholdSlider" Minimum="-70" Maximum="-10" ValueChanged="Threshold_Changed" />
                  <Border x:Name="LevelBar" Height="4" CornerRadius="2" Background="{StaticResource Brush.Warn}" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="LevelHint" Text="Join a voice room to see your mic level: the gold bar should pass the dot when you speak." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </ContentControl>
            <ContentControl x:Name="PttPanel" Style="{StaticResource Card.Rows}" Visibility="Collapsed"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Push-to-talk key" Tag="Any key or mouse button - works while WoW has focus.">
                <Button x:Name="PttKeyButton" Style="{StaticResource Button.M}" Click="PttKey_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Audio" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Microphone">
                <ComboBox x:Name="InputBox" Style="{StaticResource Dropdown}" Width="260" SelectionChanged="Device_Changed" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Speakers">
                <ComboBox x:Name="OutputBox" Style="{StaticResource Dropdown}" Width="260" SelectionChanged="Device_Changed" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Volume" Tag="Per-person volume: click someone in a voice room.">
                <StackPanel Orientation="Horizontal">
                  <Slider x:Name="VolumeSlider" Minimum="0" Maximum="2" Width="180" VerticalAlignment="Center" ValueChanged="Volume_Changed" />
                  <TextBlock x:Name="VolumeText" Style="{StaticResource Text.Secondary}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Voice changer" Tag="Sound like an orc, a gnome or a murloc: everyone in your voice room hears it.">
                <ComboBox x:Name="PresetBox" Style="{StaticResource Dropdown}" Width="260" SelectionChanged="Preset_Changed" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Noise suppression" Tag="Takes out fans, hiss and hum from your microphone. Works before the voice changer.">
                <CheckBox x:Name="NoiseBox" Style="{StaticResource Switch}" Click="Voice_Changed" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Automatic volume" Tag="Lifts a quiet microphone and keeps a loud one from clipping.">
                <CheckBox x:Name="AgcBox" Style="{StaticResource Switch}" Click="Voice_Changed" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Voice quality" Tag="High uses about 50 % more data while you talk.">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="QualityStd" Style="{StaticResource Segment}" Content="Standard" GroupName="vq" Checked="Voice_Changed" />
                    <RadioButton x:Name="QualityHigh" Style="{StaticResource Segment}" Content="High (48 kbps)" GroupName="vq" Checked="Voice_Changed" />
                  </StackPanel>
                </Border>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Test my mic" Tag="Hear yourself as the others will, with noise suppression, volume and the voice changer. Use headphones, or it will feed back.">
                <CheckBox x:Name="MonitorBox" Style="{StaticResource Switch}" Click="Monitor_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Sounds" Tag="A soft chime when people join or leave your room, and when you're mentioned.">
                <CheckBox x:Name="SoundsBox" Style="{StaticResource Switch}" Click="Voice_Changed" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Connection quality" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Group}">
              <TextBlock x:Name="QualityText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="16,12" Text="Join a voice room to see how the connection to each speaker is doing." />
            </ContentControl>
          </StackPanel>

          <!-- ========== Overlay ========== -->
          <StackPanel x:Name="SecOverlay" Visibility="Collapsed">
            <TextBlock Text="In-game overlay" Style="{StaticResource PageTitle}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show who's talking over WoW" Tag="The people in your voice room, on top of the game. Whoever speaks lights up. Needs WoW in Windowed (Fullscreen) mode - nothing is injected into the game.">
                <CheckBox x:Name="OverlayBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Position" Style="{StaticResource HeadTight}" />
            <TextBlock Text="While you're in a voice room, the overlay shows here as a preview so you can place it." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Side">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OverlayLeft" Style="{StaticResource Segment}" Content="Left" GroupName="side" Checked="Overlay_Click" />
                    <RadioButton x:Name="OverlayRightBox" Style="{StaticResource Segment}" Content="Right" GroupName="side" Checked="Overlay_Click" />
                  </StackPanel>
                </Border>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Height on the screen">
                <Slider x:Name="OverlayTopSlider" Minimum="0" Maximum="1" Width="200" ValueChanged="OverlayTop_Changed" ToolTip="Height on the screen" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Also when WoW isn't in front" Tag="Keep it on screen on the desktop too.">
                <CheckBox x:Name="OverlayAlwaysBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
            </StackPanel></ContentControl>
            <TextBlock Text="Toasts and notifications" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Rows}"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Notify me about" Tag="Chat notifications: the toasts below, and a small note from the tray while you're elsewhere. Nothing = neither. Write @Name to mention someone; @everyone and @here only work from officers up.">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NotifyAll" Style="{StaticResource Segment}" Content="All messages" GroupName="notify" Checked="Notify_Changed" />
                    <RadioButton x:Name="NotifyMentions" Style="{StaticResource Segment}" Content="Only @mentions" GroupName="notify" Checked="Notify_Changed" />
                    <RadioButton x:Name="NotifyNone" Style="{StaticResource Segment}" Content="Nothing" GroupName="notify" Checked="Notify_Changed" />
                  </StackPanel>
                </Border>
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Show toasts over WoW" Tag="Small cards for mentions and replies. None while you're in combat - they wait and arrive as one summary after the fight, and none for the channel you're looking at in the Hub.">
                <CheckBox x:Name="ToastsBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="When I'm @mentioned">
                <CheckBox x:Name="ToastMentionBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="When someone replies to me">
                <CheckBox x:Name="ToastReplyBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Reactions to my messages" Tag="Off by default.">
                <CheckBox x:Name="ToastReactBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="New pinned messages" Tag="In channels you can see. Off by default.">
                <CheckBox x:Name="ToastPinBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Outpost update ready">
                <CheckBox x:Name="ToastUpdateBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="New addon errors" Tag="&quot;Elan's Bags: 2 new errors&quot; when Addon health finds new errors after a /reload. Held during combat.">
                <CheckBox x:Name="ToastHealthBox" Style="{StaticResource Switch}" Click="Overlay_Click" />
              </HeaderedContentControl>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Corner">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ToastTL" Style="{StaticResource Segment}" Content="Top left" GroupName="tcorner" Checked="Overlay_Click" />
                    <RadioButton x:Name="ToastTR" Style="{StaticResource Segment}" Content="Top right" GroupName="tcorner" Checked="Overlay_Click" />
                    <RadioButton x:Name="ToastBL" Style="{StaticResource Segment}" Content="Bottom left" GroupName="tcorner" Checked="Overlay_Click" />
                    <RadioButton x:Name="ToastBR" Style="{StaticResource Segment}" Content="Bottom right" GroupName="tcorner" Checked="Overlay_Click" />
                  </StackPanel>
                </Border>
              </HeaderedContentControl>
            </StackPanel></ContentControl>
          </StackPanel>

          <!-- ========== Guild Master ========== -->
          <StackPanel x:Name="SecGm" Visibility="Collapsed">
            <TextBlock Text="Guild Master" Style="{StaticResource PageTitle}" />

            <TextBlock Text="Invite someone" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Group}" Margin="0,0,0,12">
              <StackPanel Margin="16,12">
                <local:InviteForm x:Name="GmInvite" AllowAdvanced="True" />
              </StackPanel>
            </ContentControl>
            <TextBlock x:Name="GmStatus" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="4,0,0,12" />

            <TextBlock Text="Invites" Style="{StaticResource HeadTight}" Margin="4,12,0,2" />
            <TextBlock Text="Links made so far. Revoke a pending one to cancel it." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}" Margin="0,0,0,12">
              <local:InviteListView x:Name="GmInvites" />
            </ContentControl>

            <TextBlock Text="Devices" Style="{StaticResource HeadTight}" Margin="4,12,0,2" />
            <TextBlock Text="Every signed-in device. Signing one out disconnects it at once; they can join again with a new invite." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="AllDevicesEmpty" Style="{StaticResource Text.Secondary}" Margin="0,12" Text="No devices yet." />
                <ItemsControl x:Name="AllDeviceRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Sign out" Tag="{Binding Id}" Click="RevokeDevice_Click" />
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding GmTitle}" Style="{StaticResource Text.RowTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ContentControl>

            <!-- 2.90: the Cairn (Lodge feature "cairnjoin"): the Guild Master's switch, officers see the status (SettingsPage.CairnJoin.cs) -->
            <StackPanel x:Name="CairnJoinSection" Visibility="Collapsed">
              <Border x:Name="CairnJoinCard" Background="{StaticResource Brush.Info.Tint}" CornerRadius="{StaticResource Radius.Card}" Padding="16,12" Margin="0,12,0,12" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Your Lodge can join the Cairn" Style="{StaticResource Text.RowTitle}" />
                  <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,8"
                             Text="The Cairn pools what many Lodges have seen - drop rates, vendor prices, spawn points, gathering nodes, flight times - and gives it back to the Lodges that take part. Your members who share would see it in their Atlas. Nothing is shared until you switch it on." />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CairnCardLater" Style="{StaticResource Button.M}" Content="Not now" Margin="0,0,8,0" Click="CairnCardLater_Click" />
                    <Button x:Name="CairnCardOn" Style="{StaticResource Button.Primary.M}" Content="Turn on" Click="CairnCardOn_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="The Cairn" Style="{StaticResource Head}" Margin="4,12,0,8" />
              <ContentControl Style="{StaticResource Card.Rows}" Margin="0,0,0,12"><StackPanel>
                <HeaderedContentControl x:Name="CairnJoinRow" Style="{StaticResource Setting.Row}" Header="Join the Cairn"
                    Tag="Your Lodge sends the Cairn the pooled totals of the members who share with it: ids and counts only (what dropped and how often, vendor prices, spawn points, gathering nodes, flight times), never names, characters or messages. Give to get: in return your Lodge receives the Cairn's numbers from other Lodges and hands them to members who share. Joining sends the Cairn your Lodge's name and its public address, and the Cairn checks that address. Each member's own sharing switch (Settings &gt; Lodge) stays as it is.">
                  <CheckBox x:Name="CairnJoinBox" Style="{StaticResource Switch}" Click="CairnJoin_Click" AutomationProperties.Name="Join the Cairn" />
                </HeaderedContentControl>
                <StackPanel x:Name="CairnJoinForm" Margin="16,0,16,12" Visibility="Collapsed">
                  <TextBlock Text="Your Lodge's public address" Style="{StaticResource Text.Caption}" />
                  <TextBox x:Name="CairnUrlBox" Style="{StaticResource Input}" Height="36" Margin="0,4,0,0" MaxLength="200" Tag="https://example.org/lodge"
                           AutomationProperties.Name="Your Lodge's public address" />
                  <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" Text="The address members connect to. The Cairn calls it once to check that it is really your Lodge." />
                  <StackPanel x:Name="CairnCodeArea" Visibility="Collapsed">
                    <TextBlock Text="Invite code" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                    <TextBox x:Name="CairnCodeBox" Style="{StaticResource Input}" Height="36" Margin="0,4,0,0" MaxLength="32" Tag="CAIRN-XXXX-XXXX"
                             AutomationProperties.Name="Invite code" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" Text="During the beta, Lodges join with an invite code from the Cairn's operator. It works once." />
                  </StackPanel>
                  <Button x:Name="CairnJoinSave" Style="{StaticResource Button.Primary.M}" Content="Ask to join" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CairnJoinSave_Click" />
                </StackPanel>
                <TextBlock x:Name="CairnJoinStatusText" Style="{StaticResource Note}" Margin="16,0,16,12" TextWrapping="Wrap" />
              </StackPanel></ContentControl>
            </StackPanel>

            <StackPanel x:Name="GmOwnerOnly">
            <TextBlock Text="Your lodge" Style="{StaticResource Head}" Margin="4,12,0,8" />
            <ContentControl Style="{StaticResource Card.Group}" Margin="0,0,0,12">
              <StackPanel Margin="16,12">
                <TextBlock Text="Name" Style="{StaticResource Text.Caption}" />
                <TextBox x:Name="LodgeNameBox" Style="{StaticResource Input}" Height="36" Margin="0,4,0,0" MaxLength="40" Tag="For example: The Silver Lodge" />
                <TextBlock Text="Welcome text" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <TextBox x:Name="LodgeWelcomeBox" Style="{StaticResource Input}" Height="72" Margin="0,4,0,0" MaxLength="280" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Tag="A short hello for new people (optional)" />
                <TextBlock x:Name="LodgeInfoHint" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Shown on the invite page and when someone joins. It is public: nobody has to be signed in to read it, so keep secrets out of it." />
                <Button x:Name="LodgeInfoSave" Style="{StaticResource Button.Primary.M}" Content="Save" HorizontalAlignment="Right" Margin="0,12,0,0" Click="LodgeInfoSave_Click" />
              </StackPanel>
            </ContentControl>
            <TextBlock x:Name="BadgesLodgeHead" Text="Badges and ladder" Style="{StaticResource Head}" Margin="4,12,0,8" />
            <ContentControl x:Name="BadgesLodgeCard" Style="{StaticResource Card.Rows}" Margin="0,0,0,12"><StackPanel>
              <HeaderedContentControl Style="{StaticResource Setting.Row}" Header="Badges and the ladder" Tag="Fun milestones for what members share with the lodge, and a monthly ladder. Worked out from the lodge's own records (nothing new is collected). Members can hide themselves from the ladder. Switching it off hides everything; badges already earned are kept.">
                <CheckBox x:Name="BadgesLodgeBox" Style="{StaticResource Switch}" Click="BadgesLodge_Click" AutomationProperties.Name="Badges and the ladder" />
              </HeaderedContentControl>
              <TextBlock x:Name="BadgesLodgeNote" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="16,0,16,12" Visibility="Collapsed" />
            </StackPanel></ContentControl>
            <TextBlock Text="Members" Style="{StaticResource Head}" Margin="4,12,0,8" />
            <ContentControl Style="{StaticResource Card.Rows}">
              <ItemsControl x:Name="MemberRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;"
                                Foreground="{StaticResource Brush.Danger}" Tag="{Binding Name}" Click="RemoveMember_Click" ToolTip="Remove (their code stops working)" />
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource Dropdown}" Width="140" Margin="8,0,8,0" ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding RoleItem, Mode=OneWay}" Tag="{Binding Name}" SelectionChanged="MemberRole_Changed" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Retire code" Visibility="{Binding RetireVisibility}" Tag="{Binding Name}"
                                Click="RetireCode_Click" ToolTip="Their old permanent code stops working. Their devices keep working." />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.S}" Content="Revert Atlas" Visibility="{Binding RevertVisibility}" Tag="{Binding Name}" Margin="0,0,8,0"
                                Click="RevertAtlas_Click" ToolTip="Take everything this member shared with the Atlas back out (for bad or wrong data). They stay a member and can share again." />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DevicesText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding OnlineText}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.RowTitle}" Foreground="{Binding RoleBrush}" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ContentControl>

            <TextBlock Text="Channels" Style="{StaticResource HeadTight}" />
            <TextBlock Text="Ranks decide who sees a channel. Changes reach everyone right away." Style="{StaticResource Note}" />
            <ContentControl Style="{StaticResource Card.Rows}" Margin="0,0,0,12">
              <ItemsControl x:Name="ChannelRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;"
                                Foreground="{StaticResource Brush.Danger}" Tag="{Binding Id}" Click="RemoveChannel_Click" ToolTip="Remove channel" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Info}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ContentControl>
            <ContentControl Style="{StaticResource Card.Group}">
              <DockPanel Margin="16,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.M}" Content="Add" Margin="8,0,0,0" Click="AddChannel_Click" />
                <TextBox x:Name="NewMax" DockPanel.Dock="Right" Style="{StaticResource Input}" Height="32" Width="56" Tag="max" Margin="8,0,0,0" ToolTip="Voice rooms: how many people (empty = no limit)" />
                <ComboBox x:Name="NewMinRole" DockPanel.Dock="Right" Style="{StaticResource Dropdown}" Width="132" Margin="8,0,0,0" ToolTip="Lowest rank that can see it" />
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Margin="8,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NewText" Style="{StaticResource Segment}" Content="#" GroupName="newtype" IsChecked="True" ToolTip="Text channel" />
                    <RadioButton x:Name="NewVoice" Style="{StaticResource Segment}" GroupName="newtype" ToolTip="Voice room">
                      <TextBlock Text="&#xE767;" FontFamily="{StaticResource Font.Icons}" />
                    </RadioButton>
                  </StackPanel>
                </Border>
                <TextBox x:Name="NewChannelName" Style="{StaticResource Input}" Height="32" Tag="New channel name" MaxLength="24" />
              </DockPanel>
            </ContentControl>
            </StackPanel>
          </StackPanel>

          <!-- ========== About ========== -->
          <StackPanel x:Name="SecAbout" Visibility="Collapsed">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <!-- tabs (EntityTab, like an Atlas page): About | What's new. Left / Right move between them. -->
            <Grid Margin="0,0,0,16">
              <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Brush.Divider}" />
              <StackPanel x:Name="AboutTabs" Orientation="Horizontal" Margin="4,0,0,0" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                <RadioButton x:Name="AboutTabAbout" Style="{StaticResource EntityTab}" GroupName="abouttab" Content="About" IsChecked="True" Checked="AboutTab_Checked" />
                <RadioButton x:Name="AboutTabNews" Style="{StaticResource EntityTab}" GroupName="abouttab" Checked="AboutTab_Checked" ToolTip="The changes in each version">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="What's new" />
                    <Ellipse x:Name="AboutNewsDot" Width="8" Height="8" Fill="{StaticResource Brush.Accent}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Grid>

            <!-- About: the campfire (centred), the buttons, credits, the trademark line -->
            <StackPanel x:Name="AboutPaneAbout">
            <Viewbox x:Name="AboutVideo" Stretch="Uniform" MaxWidth="480" HorizontalAlignment="Center"><Border x:Name="AboutHost" Width="480" Height="300" /></Viewbox>
            <Button x:Name="ReplayLink" Style="{StaticResource GhostButton}" Content="Replay" HorizontalAlignment="Center" Margin="0,4,0,16" Click="Replay_Click" />
            <TextBlock x:Name="AboutVersion" Visibility="Collapsed" />
            <WrapPanel x:Name="AboutButtons" HorizontalAlignment="Center" Margin="0,0,0,16">
              <Button Style="{StaticResource Button.M}" Content="View log" Margin="4,0,4,8" Click="ViewLog_Click" ToolTip="The Outpost's own log, with errors and warnings picked out (personal details hidden)" />
              <Button Style="{StaticResource Button.M}" Content="What's new" Margin="4,0,4,8" Click="WhatsNew_Click" ToolTip="The changes in each version" />
              <Button Style="{StaticResource Button.M}" Content="GitHub page" Margin="4,0,4,8" Click="GitHub_Click" />
              <Button x:Name="WelcomeButton" Style="{StaticResource Button.M}" Content="Show welcome guide" Margin="4,0,4,8" Click="Welcome_Click" ToolTip="The short first-run tour" />
            </WrapPanel>
            <TextBlock Text="Credits" Style="{StaticResource Head}" />
            <ContentControl Style="{StaticResource Card.Group}" Margin="0,0,0,16">
              <StackPanel Margin="16,12">
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Pet data" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://www.wow-petopia.com/forever/" RequestNavigate="Link_Navigate">Petopia Forever</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="NPC data" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://github.com/Questie/Questie" RequestNavigate="Link_Navigate">Questie / QuestieDB</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Hunter and paladin spells" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://wowforevertools.com" RequestNavigate="Link_Navigate">WoW Forever Tools</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Talent builds" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://talentsforever.com" RequestNavigate="Link_Navigate">talentsforever.com (CC BY 4.0)</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Minimap math" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://github.com/Nevcairiel/HereBeDragons" RequestNavigate="Link_Navigate">HereBeDragons</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Addon suggestions" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://www.wowinterface.com" RequestNavigate="Link_Navigate">WoWInterface (public file list)</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Voice" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://github.com/naudio/NAudio" RequestNavigate="Link_Navigate">NAudio</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://github.com/lostromb/concentus" RequestNavigate="Link_Navigate">Concentus (Opus)</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="World map" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://leafletjs.com" RequestNavigate="Link_Navigate">Leaflet 1.9.4</Hyperlink> (BSD-2-Clause, kept inside the Outpost; the map never loads anything from the internet)</TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="World map 3D" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://threejs.org" RequestNavigate="Link_Navigate">three.js r149</Hyperlink> (MIT, kept inside the Outpost, no internet needed)</TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Single exe" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://github.com/Fody/Costura" RequestNavigate="Link_Navigate">Costura</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Icons" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"><Hyperlink NavigateUri="https://github.com/primer/octicons" RequestNavigate="Link_Navigate">Octicons (GitHub mark)</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Music" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap"><Hyperlink NavigateUri="https://radioparadise.com" RequestNavigate="Link_Navigate">Radio Paradise</Hyperlink> - listener-supported radio, no ads. <Hyperlink NavigateUri="https://radioparadise.com/donate" RequestNavigate="Link_Navigate">Support Radio Paradise</Hyperlink></TextBlock></Grid>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Splash and artwork" Style="{StaticResource Text.Secondary}" /><TextBlock Grid.Column="1" Style="{StaticResource Text.Body}">Original, made for this project</TextBlock></Grid>
              </StackPanel>
            </ContentControl>
            <!-- how we look at it: fair play, and no responsibility (the same words as the README's "How we look at it") -->
            <TextBlock Text="How we look at it" Style="{StaticResource Head}" />
            <ContentControl x:Name="AboutFairPlay" Style="{StaticResource Card.Group}" Margin="0,0,0,16">
              <StackPanel Margin="16,12">
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,8" Text="Elan's Outpost and its addons are made with care, and we try hard to play fair: the addons only use the game's normal addon interface, the Outpost only reads your game files and never touches the game while it runs, and nothing ever plays the game for you. We believe that keeps everything well within the rules - but we can't promise it, because only Blizzard decides what is allowed, and the rules can change." />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,4" Text="So please use it at your own risk. It is a free fan project, given as it is, and we can't take responsibility for lost settings, a broken interface, action taken on an account or anything else that happens while you use it. If your addon settings matter to you, keep a copy of your WTF folder now and then - and if something feels wrong, tell us. We'd much rather fix it." />
              </StackPanel>
            </ContentControl>
            <!-- one line when the page is wide enough, wrapping (centred) when it is not -->
            <TextBlock x:Name="AboutDisclaimer" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="4,0,4,0"
                       Text="World of Warcraft is a trademark of Blizzard Entertainment. Elan's Outpost is a fan project and not affiliated with Blizzard." />
            </StackPanel>

            <!-- What's new: the version history (the Outpost's CHANGELOG.md inside the exe; the addons' notes from the update manifest) -->
            <StackPanel x:Name="AboutPaneNews" Visibility="Collapsed">
              <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="All releases on GitHub" VerticalAlignment="Center" Click="Releases_Click" />
                <Border x:Name="NewsPickHost" Style="{StaticResource SegmentHost}"><StackPanel x:Name="NewsPick" Orientation="Horizontal" /></Border>
              </DockPanel>
              <Border x:Name="NewsBanner" Background="{StaticResource Brush.Info.Tint}" CornerRadius="{StaticResource Radius.Card}" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock x:Name="NewsBannerText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
              </Border>
              <StackPanel x:Name="NewsList" />
              <Button x:Name="NewsMore" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="NewsMore_Click" Visibility="Collapsed" />
              <TextBlock x:Name="NewsEmpty" Style="{StaticResource Note}" Visibility="Collapsed" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
    </Border>
  </Grid>
</UserControl>
