<UserControl x:Class="ElansAddonHub.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub.Lodge">
  <UserControl.Resources>
    <!-- section list on the left -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="GroupName" Value="nav" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,8" Margin="0,1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                <Ellipse x:Name="dot" Grid.Column="2" Width="8" Height="8" Fill="#FF8000" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="&#xEA18;">
                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHi}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}" />
                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHi}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="RowBox" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,13" />
    </Style>
    <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="14,2,12,10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- sections -->
    <Border Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,8,0" Padding="8">
      <StackPanel>
        <TextBlock Text="SETTINGS" Style="{StaticResource Caption}" Margin="10,6,0,6" />
        <RadioButton x:Name="NavGeneral" Style="{StaticResource Nav}" Tag="&#xE713;" Content="General" Checked="Nav_Checked" IsChecked="True" />
        <RadioButton x:Name="NavAddons" Style="{StaticResource Nav}" Tag="&#xEA86;" Content="Addons" Checked="Nav_Checked" />
        <RadioButton x:Name="NavLodge" Style="{StaticResource Nav}" Tag="&#xE716;" Content="Lodge" Checked="Nav_Checked" />
        <RadioButton x:Name="NavVoice" Style="{StaticResource Nav}" Tag="&#xE720;" Content="Voice" Checked="Nav_Checked" />
        <RadioButton x:Name="NavOverlay" Style="{StaticResource Nav}" Tag="&#xE81E;" Content="In-game overlay" Checked="Nav_Checked" />
        <RadioButton x:Name="NavNotify" Style="{StaticResource Nav}" Tag="&#xEA8F;" Content="Notifications" Checked="Nav_Checked" />
        <RadioButton x:Name="NavGm" Style="{StaticResource Nav}" Tag="&#xEA18;" Content="Guild Master" Checked="Nav_Checked" Visibility="Collapsed" />
        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE946;" Content="About" Checked="Nav_Checked" />
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <Grid Margin="24,20,24,20" MaxWidth="720" HorizontalAlignment="Stretch">

          <!-- ========== General ========== -->
          <StackPanel x:Name="SecGeneral">
            <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="WORLD OF WARCRAFT FOLDER" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Change" Margin="8,0,0,0" Click="ChangeFolder_Click" />
              <Border Background="{StaticResource SurfaceHi}" CornerRadius="8" Padding="10,8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <TextBlock x:Name="FolderText" FontSize="12.5" TextTrimming="CharacterEllipsis" />
              </Border>
            </DockPanel>
            <TextBlock Text="The main folder (with _retail_, _classic_beta_ ...). Each addon knows which client it belongs to." Style="{StaticResource RowHint}" Margin="0,0,0,10" />
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Run in background" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Closing the window keeps the hub in the tray: updates are checked and you stay online in the lodge." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="BackgroundBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="General_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Starts quietly in the tray when you log in." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="StartupBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="General_Click"  />
            </Grid></Border>
          </StackPanel>

          <!-- ========== Addons ========== -->
          <StackPanel x:Name="SecAddons" Visibility="Collapsed">
            <TextBlock Text="Addons" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Update addons automatically" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Install new addon versions as soon as they're out (the hub itself always asks)." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="AutoUpdateBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="General_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Check CurseForge for updates automatically" Style="{StaticResource RowTitle}" />
                <TextBlock Text="For addons the CurseForge app manages: about once a day and when WoW starts, the hub lets CurseForge refresh (it is started minimized and closed again; skipped if it is already running)." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="CfAutoBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="General_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Card artwork: painted pictures" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Off = the clean vector icons (default). On = the original painted pictures on the addon cards." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="PaintedBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="General_Click"  />
            </Grid></Border>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Style="{StaticResource SecondaryButton}" Content="Check for updates now" Click="CheckNow_Click" />
              <Button Style="{StaticResource SecondaryButton}" Content="Open backups folder" Margin="8,0,0,0" Click="Backups_Click" />
            </StackPanel>
            <TextBlock x:Name="CheckText" Style="{StaticResource RowHint}" Margin="2,8,0,0" />
          </StackPanel>

          <!-- ========== Lodge ========== -->
          <StackPanel x:Name="SecLodge" Visibility="Collapsed">
            <TextBlock Text="Lodge" Style="{StaticResource SectionTitle}" />
            <Border Background="{StaticResource SurfaceHi}" CornerRadius="10" Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock x:Name="LodgeAddress" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LodgeWho" Style="{StaticResource RowHint}" Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource SecondaryButton}" Content="Edit connection" Click="EditConnection_Click" />
                  <Button Style="{StaticResource SecondaryButton}" Content="Leave this lodge" Foreground="{StaticResource Danger}" Margin="8,0,0,0"
                          Click="SignOut_Click" ToolTip="Disconnect and forget the address and code" />
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- profile: avatar, about text, characters, privacy -->
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <local:AvatarView x:Name="ProfileAvatar" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Profile" Style="{StaticResource RowTitle}" />
                <TextBlock x:Name="ProfileHint" Text="Pick an avatar, add a few words about you, choose which characters you show." Style="{StaticResource RowHint}" /></StackPanel>
              <Button Grid.Column="2" x:Name="EditProfileButton" Style="{StaticResource SecondaryButton}" Content="Edit profile" VerticalAlignment="Center" Click="EditProfile_Click" />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Connect when the hub starts" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Friends see you online while the hub runs." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="AutoConnectBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Show what I'm playing" Style="{StaticResource RowTitle}" />
                <TextBlock x:Name="ShareGameHint" Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="ShareGameBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Detect my character live" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}" Text="Reads the tiny status strip the Elan's Hub addon draws in the top-left corner of the game (only that corner of the screen, nothing is sent to or read from WoW). Off = the Hub learns your character only on /reload or logout." /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="PixelBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="AFK automatically" Style="{StaticResource RowTitle}" />
                <TextBlock Text="After 10 minutes without mouse or keyboard (also in WoW), back to Online when you return." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="AutoAwayBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Share my zone" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Friends see where you are (zone or dungeon). Off = no zone or instance name is sent." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="ShareZoneBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Share my XP" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Friends see your XP percentage and whether you're rested. Off = neither is sent." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="ShareXpBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Set my Lodge status automatically" Style="{StaticResource RowTitle}" />
                <TextBlock Text="In combat shows as Busy (In combat) and goes back a few seconds after the fight; the game's AFK flag shows as AFK. A status you chose yourself is never changed." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="AutoStatusBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Remember Appear offline" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Keep &quot;Appear offline&quot; (pick it by clicking your name in the Lodge) after the hub restarts. Off = you're visible again at every start." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="RememberInvisibleBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lodge_Click"  />
            </Grid></Border>
          </StackPanel>

          <!-- ========== Voice ========== -->
          <StackPanel x:Name="SecVoice" Visibility="Collapsed">
            <TextBlock Text="Voice" Style="{StaticResource SectionTitle}" />
            <Border Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeVa" Style="{StaticResource Segment}" Content="Voice activation" GroupName="mode" Checked="Voice_Changed" />
                <RadioButton x:Name="ModePtt" Style="{StaticResource Segment}" Content="Push to talk" GroupName="mode" Checked="Voice_Changed" />
              </StackPanel>
            </Border>
            <StackPanel x:Name="VaPanel" Margin="0,0,0,4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="ThresholdText" FontSize="11.5" Foreground="{StaticResource TextDim}" />
                <TextBlock Text="Sensitivity" Style="{StaticResource RowTitle}" />
              </DockPanel>
              <Grid Margin="0,6,0,0">
                <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceHi}" VerticalAlignment="Center" />
                <Border x:Name="LevelBar" Height="4" CornerRadius="2" Background="{StaticResource Gold}" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                <Slider x:Name="ThresholdSlider" Minimum="-70" Maximum="-10" ValueChanged="Threshold_Changed" />
              </Grid>
              <TextBlock x:Name="LevelHint" Text="Join a voice room to see your mic level: the gold bar should pass the dot when you speak." Style="{StaticResource RowHint}" Margin="0,4,0,0" />
            </StackPanel>
            <Border x:Name="PttPanel" Style="{StaticResource RowBox}" Visibility="Collapsed"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Push-to-talk key" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Any key or mouse button - works while WoW has focus." Style="{StaticResource RowHint}" /></StackPanel>
              <Button x:Name="PttKeyButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="PttKey_Click" />
            </Grid></Border>
            <TextBlock Text="DEVICES" Style="{StaticResource Group}" />
            <TextBlock Text="MICROPHONE" Style="{StaticResource RowHint}" Margin="0,0,0,4" />
            <ComboBox x:Name="InputBox" Style="{StaticResource Dropdown}" SelectionChanged="Device_Changed" Margin="0,0,0,12" />
            <TextBlock Text="SPEAKERS" Style="{StaticResource RowHint}" Margin="0,0,0,4" />
            <ComboBox x:Name="OutputBox" Style="{StaticResource Dropdown}" SelectionChanged="Device_Changed" Margin="0,0,0,14" />
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" x:Name="VolumeText" FontSize="11.5" Foreground="{StaticResource TextDim}" />
              <TextBlock Text="Volume" Style="{StaticResource RowTitle}" />
            </DockPanel>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="2" Margin="0,6,0,8" ValueChanged="Volume_Changed" />
            <TextBlock Text="Per-person volume: click someone in a voice room." Style="{StaticResource RowHint}" Margin="0,0,0,4" />
            <Border Style="{StaticResource RowBox}" Margin="0,8,0,0"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Sounds" Style="{StaticResource RowTitle}" />
                <TextBlock Text="A soft chime when people join or leave your room, and when you're mentioned." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="SoundsBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Voice_Changed"  />
            </Grid></Border>
          </StackPanel>

          <!-- ========== Overlay ========== -->
          <StackPanel x:Name="SecOverlay" Visibility="Collapsed">
            <TextBlock Text="In-game overlay" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Show who's talking over WoW" Style="{StaticResource RowTitle}" />
                <TextBlock Text="The people in your voice room, on top of the game. Whoever speaks lights up. Needs WoW in Windowed (Fullscreen) mode - nothing is injected into the game." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="OverlayBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <TextBlock Text="POSITION" Style="{StaticResource Group}" Margin="0,16,0,6" />
            <DockPanel Margin="0,0,0,8">
              <Border DockPanel.Dock="Left" Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="OverlayLeft" Style="{StaticResource Segment}" Content="Left" GroupName="side" Checked="Overlay_Click" />
                  <RadioButton x:Name="OverlayRightBox" Style="{StaticResource Segment}" Content="Right" GroupName="side" Checked="Overlay_Click" />
                </StackPanel>
              </Border>
              <Slider x:Name="OverlayTopSlider" Minimum="0" Maximum="1" Margin="14,0,0,0" VerticalAlignment="Center" ValueChanged="OverlayTop_Changed" ToolTip="Height on the screen" />
            </DockPanel>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Also when WoW isn't in front" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Keep it on screen on the desktop too." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="OverlayAlwaysBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <TextBlock Text="While you're in a voice room, the overlay shows here as a preview so you can place it." Style="{StaticResource RowHint}" />
            <TextBlock Text="TOASTS" Style="{StaticResource Group}" Margin="0,18,0,6" />
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Show toasts over WoW" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Small cards for mentions and replies. None while you're in combat - they wait and arrive as one summary after the fight, and none for the channel you're looking at in the Hub." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="ToastsBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="When I'm @mentioned" Style="{StaticResource RowTitle}" />
                </StackPanel>
              <CheckBox Grid.Column="1" x:Name="ToastMentionBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="When someone replies to me" Style="{StaticResource RowTitle}" />
                </StackPanel>
              <CheckBox Grid.Column="1" x:Name="ToastReplyBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Reactions to my messages" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Off by default." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="ToastReactBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="New pinned messages" Style="{StaticResource RowTitle}" />
                <TextBlock Text="In channels you can see. Off by default." Style="{StaticResource RowHint}" /></StackPanel>
              <CheckBox Grid.Column="1" x:Name="ToastPinBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <Border Style="{StaticResource RowBox}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Hub update ready" Style="{StaticResource RowTitle}" />
                </StackPanel>
              <CheckBox Grid.Column="1" x:Name="ToastUpdateBox" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Overlay_Click"  />
            </Grid></Border>
            <DockPanel Margin="0,8,0,8">
              <TextBlock DockPanel.Dock="Left" Text="Corner" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,14,0" />
              <Border Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ToastTL" Style="{StaticResource Segment}" Content="Top left" GroupName="tcorner" Checked="Overlay_Click" />
                  <RadioButton x:Name="ToastTR" Style="{StaticResource Segment}" Content="Top right" GroupName="tcorner" Checked="Overlay_Click" />
                  <RadioButton x:Name="ToastBL" Style="{StaticResource Segment}" Content="Bottom left" GroupName="tcorner" Checked="Overlay_Click" />
                  <RadioButton x:Name="ToastBR" Style="{StaticResource Segment}" Content="Bottom right" GroupName="tcorner" Checked="Overlay_Click" />
                </StackPanel>
              </Border>
            </DockPanel>
          </StackPanel>

          <!-- ========== Notifications ========== -->
          <StackPanel x:Name="SecNotify" Visibility="Collapsed">
            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="NOTIFY ME ABOUT" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <Border Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NotifyAll" Style="{StaticResource Segment}" Content="All messages" GroupName="notify" Checked="Notify_Changed" />
                <RadioButton x:Name="NotifyMentions" Style="{StaticResource Segment}" Content="Only @mentions" GroupName="notify" Checked="Notify_Changed" />
                <RadioButton x:Name="NotifyNone" Style="{StaticResource Segment}" Content="Nothing" GroupName="notify" Checked="Notify_Changed" />
              </StackPanel>
            </Border>
            <TextBlock Text="A small note from the tray while you're elsewhere (e.g. in WoW). Write @Name to mention someone, @everyone for all." Style="{StaticResource RowHint}" />
          </StackPanel>

          <!-- ========== Guild Master ========== -->
          <StackPanel x:Name="SecGm" Visibility="Collapsed">
            <TextBlock Text="Guild Master" Style="{StaticResource SectionTitle}" />

            <TextBlock Text="INVITE SOMEONE" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="34" Width="124" FontSize="12.5" Content="Create invite" Margin="8,0,0,0" Click="Invite_Click" />
              <ComboBox x:Name="InviteRole" DockPanel.Dock="Right" Style="{StaticResource Dropdown}" Width="130" Margin="8,0,0,0" />
              <TextBox x:Name="InviteName" Style="{StaticResource Input}" Tag="Their name" MaxLength="24" />
            </DockPanel>
            <Border x:Name="InviteResult" Visibility="Collapsed" Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="12,10" Margin="0,0,0,8"
                    BorderBrush="{StaticResource AccentDark}" BorderThickness="1">
              <StackPanel>
                <TextBlock x:Name="InviteTitle" FontSize="12.5" FontWeight="SemiBold" />
                <DockPanel Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Copy" Margin="8,0,0,0" Click="CopyInvite_Click" />
                  <TextBox x:Name="InviteLink" Style="{StaticResource Input}" IsReadOnly="True" FontSize="12" />
                </DockPanel>
                <TextBlock Text="Send it privately (e.g. a Discord DM). Opening it in a browser explains what to do; the hub's Lodge tab takes the whole link."
                           Style="{StaticResource RowHint}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="GmStatus" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="2,0,0,8" />

            <TextBlock Text="MEMBERS" Style="{StaticResource Caption}" Margin="0,10,0,6" />
            <ItemsControl x:Name="MemberRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceHi}" CornerRadius="8" Padding="10,6" Margin="0,0,0,5">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;"
                              Foreground="{StaticResource Danger}" Tag="{Binding Name}" Click="RemoveMember_Click" ToolTip="Remove (their code stops working)" />
                      <ComboBox DockPanel.Dock="Right" Style="{StaticResource Dropdown}" Width="140" Margin="8,0,6,0" ItemsSource="{Binding Roles}"
                                SelectedItem="{Binding RoleItem, Mode=OneWay}" Tag="{Binding Name}" SelectionChanged="MemberRole_Changed" />
                      <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding OnlineText}" />
                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{Binding RoleBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="CHANNELS" Style="{StaticResource Caption}" Margin="0,18,0,6" />
            <ItemsControl x:Name="ChannelRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceHi}" CornerRadius="8" Padding="10,6" Margin="0,0,0,5">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;"
                              Foreground="{StaticResource Danger}" Tag="{Binding Id}" Click="RemoveChannel_Click" ToolTip="Remove channel" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Info}" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="13" Foreground="{StaticResource TextDim}" Width="22" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,6,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Add" Margin="8,0,0,0" Click="AddChannel_Click" />
              <TextBox x:Name="NewMax" DockPanel.Dock="Right" Style="{StaticResource Input}" Width="56" Tag="max" Margin="8,0,0,0" ToolTip="Voice rooms: how many people (empty = no limit)" />
              <ComboBox x:Name="NewMinRole" DockPanel.Dock="Right" Style="{StaticResource Dropdown}" Width="130" Margin="8,0,0,0" ToolTip="Lowest rank that can see it" />
              <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceHi}" CornerRadius="9" Padding="3" Margin="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="NewText" Style="{StaticResource Segment}" Content="#" GroupName="newtype" IsChecked="True" ToolTip="Text channel" />
                  <RadioButton x:Name="NewVoice" Style="{StaticResource Segment}" GroupName="newtype" ToolTip="Voice room">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" />
                  </RadioButton>
                </StackPanel>
              </Border>
              <TextBox x:Name="NewChannelName" Style="{StaticResource Input}" Tag="New channel name" MaxLength="24" />
            </DockPanel>
            <TextBlock Text="Ranks decide who sees a channel. Changes reach everyone right away." Style="{StaticResource RowHint}" Margin="0,8,0,0" />
          </StackPanel>

          <!-- ========== About ========== -->
          <StackPanel x:Name="SecAbout" Visibility="Collapsed">
            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Image Source="Assets/hub.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Elan's Addon Hub" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="AboutVersion" Style="{StaticResource RowHint}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Style="{StaticResource SecondaryButton}" Content="Open log folder" Click="LogFolder_Click" />
              <Button Style="{StaticResource SecondaryButton}" Content="GitHub page" Margin="8,0,0,0" Click="GitHub_Click" />
            </StackPanel>
            <TextBlock Style="{StaticResource RowHint}" Text="Pet data: Petopia Forever. NPC data: Questie. Hunter spells: WoW Forever Tools. Voice: NAudio and Concentus (Opus). World of Warcraft belongs to Blizzard Entertainment - this is a fan project." />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
