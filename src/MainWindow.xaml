<Window x:Class="ElansAddonHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lodge="clr-namespace:ElansAddonHub.Lodge"
        xmlns:local="clr-namespace:ElansAddonHub"
        Title="Elan's Addon Hub" Icon="Assets/hub.ico"
        Width="920" Height="690" MinWidth="740" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display">

  <!-- resizable from the edges (the 14 px shadow margin is the grab area) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="12" GlassFrameThickness="0" CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Border Margin="14" Background="{StaticResource Bg}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- header art, fading into the background -->
      <Border Grid.RowSpan="4" VerticalAlignment="Top" Height="290" CornerRadius="13,13,0,0" IsHitTestVisible="False">
        <Border.Background>
          <ImageBrush ImageSource="Assets/hero.jpg" Stretch="UniformToFill" AlignmentY="Top" />
        </Border.Background>
      </Border>
      <Border Grid.RowSpan="4" VerticalAlignment="Top" Height="292" CornerRadius="13,13,0,0" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B30F1113" Offset="0" />
            <GradientStop Color="#1A0F1113" Offset="0.22" />
            <GradientStop Color="#400F1113" Offset="0.5" />
            <GradientStop Color="#FF0F1113" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- title bar -->
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Image Source="Assets/hub.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Elan's Addon Hub" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextDim}" Margin="8,1,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
        </StackPanel>
      </Grid>

      <!-- tabs -->
      <DockPanel Grid.Row="1" Margin="20,0,16,8" LastChildFill="False">
        <RadioButton x:Name="TabAddons" DockPanel.Dock="Left" Style="{StaticResource Tab}" Content="Addons" GroupName="tabs" IsChecked="True" Checked="Tab_Checked" />
        <RadioButton x:Name="TabLodge" DockPanel.Dock="Left" Style="{StaticResource Tab}" GroupName="tabs" Checked="Tab_Checked">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Lodge" />
            <Ellipse x:Name="UnreadDot" Width="7" Height="7" Fill="{StaticResource Accent}" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
        </RadioButton>
        <!-- settings: a gear at the right end of the tab row -->
        <RadioButton x:Name="TabSettings" DockPanel.Dock="Right" Style="{StaticResource Tab}" GroupName="tabs" Checked="Tab_Checked"
                     Margin="0" ToolTip="Settings">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="2,1,2,0" />
        </RadioButton>
      </DockPanel>

      <!-- hub self-update banner -->
      <Border x:Name="HubBanner" Grid.Row="2" Visibility="Collapsed" Margin="16,0,16,10" Padding="14,10"
              Background="{StaticResource Surface}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
          <Button x:Name="HubUpdateButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Foreground="{StaticResource Accent}"
                  FontWeight="SemiBold" Content="Restart &amp; update" Click="HubUpdate_Click" />
          <TextBlock x:Name="HubBannerText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- addon cards -->
      <lodge:LodgeView x:Name="LodgePage" Grid.Row="3" Visibility="Collapsed" />
      <local:SettingsPage x:Name="SettingsPage" Grid.Row="3" Visibility="Collapsed" />
      <ScrollViewer x:Name="AddonsPage" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <ItemsControl x:Name="Cards" Margin="0,44,0,0" MaxWidth="660">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="16,0,12,12" Padding="18" Background="{StaticResource Card}" CornerRadius="12"
                      BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="10" Padding="9,3" Background="{Binding PillBg}">
                      <TextBlock Text="{Binding PillText}" Foreground="{Binding PillFg}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Width="42" Height="42" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top">
                      <Image Source="Assets/hub.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="12,1,8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"
                                 ToolTip="{Binding InstallPath}" ToolTipService.InitialShowDelay="300" />
                    </StackPanel>
                  </DockPanel>

                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="INSTALLED" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Installed}" FontSize="15" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="LATEST" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Latest}" FontSize="15" Margin="0,3,0,0" />
                    </StackPanel>
                  </Grid>

                  <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Content="{Binding ButtonText}"
                          IsEnabled="{Binding ButtonEnabled}" Tag="{Binding}" Click="Action_Click" />
                  <Button Style="{StaticResource GhostButton}" Content="This is a git copy - replace it with the release..." FontSize="11.5"
                          HorizontalAlignment="Left" Margin="-6,6,0,0" Visibility="{Binding ReplaceDevVisibility}" Tag="{Binding}" Click="ReplaceDev_Click" />
                  <ProgressBar Style="{StaticResource ThinProgress}" Margin="2,8,2,0" Maximum="1"
                               Value="{Binding Progress}" Visibility="{Binding BusyVisibility}" />
                  <TextBlock Text="{Binding Message}" Visibility="{Binding MessageVisibility}" FontSize="12"
                             Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="2,10,0,0" />

                  <TextBlock Text="{Binding ChangesTitle}" Style="{StaticResource Caption}" Margin="0,20,0,8" />
                  <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,7">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>
  </Border>
</Window>
