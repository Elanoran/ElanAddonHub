<Window x:Class="ElansAddonHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lodge="clr-namespace:ElansAddonHub.Lodge"
        xmlns:local="clr-namespace:ElansAddonHub"
        Title="{x:Static local:Brand.Name}" Icon="Assets/hub.ico"
        Width="920" Height="690" MinWidth="740" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display">

  <!-- resizable from the edges (the 14 px shadow margin is the grab area) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="12" GlassFrameThickness="0" CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Border Margin="14" Background="{StaticResource Bg}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- header art, fading into the background -->
      <Border Grid.RowSpan="4" Grid.ColumnSpan="2" CornerRadius="13" ClipToBounds="True" IsHitTestVisible="False">
        <Border.Background>
          <ImageBrush ImageSource="Assets/hero.jpg" Stretch="UniformToFill" AlignmentY="Top" />
        </Border.Background>
      </Border>
      <Border Grid.RowSpan="4" Grid.ColumnSpan="2" CornerRadius="13" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B30F1113" Offset="0" />
            <GradientStop Color="#330F1113" Offset="0.12" />
            <GradientStop Color="#590F1113" Offset="0.4" />
            <GradientStop Color="#B50F1113" Offset="0.7" />
            <GradientStop Color="#FF0F1113" Offset="0.97" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- title bar -->
      <Grid Grid.Row="0" Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
        </StackPanel>
      </Grid>

      <!-- navigation rail (Discord style): icon buttons with a pill on the edge, Settings pinned at the bottom -->
      <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Background="#B30C0E10" CornerRadius="13,0,0,13" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="False">
          <Grid DockPanel.Dock="Top" Height="52" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
            <Image x:Name="RailLogo" Source="Assets/hub.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" ToolTipService.Placement="Right"
                   MouseLeftButtonDown="Logo_Down" MouseLeftButtonUp="Logo_Click" />
          </Grid>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
            <RadioButton x:Name="TabSettings" Style="{StaticResource RailButton}" GroupName="tabs" Checked="Tab_Checked"
                         ToolTip="Settings  (Ctrl+,)" ToolTipService.Placement="Right" AutomationProperties.Name="Settings">
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="19" />
            </RadioButton>
            <TextBlock x:Name="RailVersion" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="9.5" Foreground="{StaticResource TextDim}" Opacity="0.6"
                       Cursor="Hand" Background="Transparent" ToolTipService.Placement="Right" MouseLeftButtonUp="RailVersion_Click" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,2,0,0">
            <Grid Margin="0,0,0,6">
              <RadioButton x:Name="TabAddons" Style="{StaticResource RailButton}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"
                           ToolTip="Addons  (Ctrl+1)" ToolTipService.Placement="Right" AutomationProperties.Name="Addons">
                <TextBlock Text="&#xEA86;" FontFamily="{StaticResource Icons}" FontSize="19" />
              </RadioButton>
              <Border x:Name="UpdateBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,7,0" MinWidth="18" Height="18" CornerRadius="9" Padding="4,0"
                      Background="{StaticResource Gold}" BorderBrush="{StaticResource Bg}" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="UpdateBadgeText" FontSize="10" FontWeight="Bold" Foreground="#111315" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
              </Border>
              <!-- unseen addon errors (Addon health): red, bottom right, next to the gold update count -->
              <Border x:Name="HealthBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,3" MinWidth="18" Height="18" CornerRadius="9" Padding="4,0"
                      Background="{StaticResource Danger}" BorderBrush="{StaticResource Bg}" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="HealthBadgeText" FontSize="10" FontWeight="Bold" Foreground="#111315" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
              </Border>
            </Grid>
            <Border Width="28" Height="2" CornerRadius="1" Background="{StaticResource Line}" Margin="0,0,0,6" />
            <Grid>
              <RadioButton x:Name="TabLodge" Style="{StaticResource RailButton}" GroupName="tabs" Checked="Tab_Checked"
                           ToolTip="Lodge  (Ctrl+2)" ToolTipService.Placement="Right" AutomationProperties.Name="Lodge">
                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="19" />
              </RadioButton>
              <Border x:Name="UnreadDot" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,9,0" Width="16" Height="16" CornerRadius="8"
                      Background="{StaticResource Danger}" BorderBrush="{StaticResource Bg}" BorderThickness="3" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
            <RadioButton x:Name="TabInventory" Style="{StaticResource RailButton}" GroupName="tabs" Checked="Tab_Checked"
                         ToolTip="Inventory - all your characters  (Ctrl+3)" ToolTipService.Placement="Right" AutomationProperties.Name="Inventory">
              <!-- backpack glyph (own vector art, takes the rail button's colour) -->
              <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    Data="M9.2,3.2 C9.2,1.9 14.8,1.9 14.8,3.2 L14.8,5 L13.5,5 L13.5,3.6 C13.5,3.3 10.5,3.3 10.5,3.6 L10.5,5 L9.2,5 Z M7.6,5.6 L16.4,5.6 C17.8,5.6 18.8,6.7 18.8,8 L18.8,19 C18.8,20.4 17.8,21.4 16.4,21.4 L7.6,21.4 C6.2,21.4 5.2,20.4 5.2,19 L5.2,8 C5.2,6.7 6.2,5.6 7.6,5.6 Z M7.2,8.4 L16.8,8.4 L16.8,10.6 L7.2,10.6 Z M7.2,14 L16.8,14 L16.8,19.2 L7.2,19.2 Z M4.4,12.6 L3.4,12.6 C2.9,12.6 2.6,13 2.6,13.4 L2.6,17.2 C2.6,17.6 2.9,18 3.4,18 L4.4,18 Z M19.6,12.6 L20.6,12.6 C21.1,12.6 21.4,13 21.4,13.4 L21.4,17.2 C21.4,17.6 21.1,18 20.6,18 L19.6,18 Z"
                    />
            </RadioButton>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- hub self-update banner -->
      <Border x:Name="HubBanner" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Margin="16,0,16,10" Padding="14,10"
              Background="{StaticResource Surface}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
          <Button x:Name="HubUpdateButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Foreground="{StaticResource Accent}"
                  FontWeight="SemiBold" Content="Restart &amp; update" Click="HubUpdate_Click" />
          <TextBlock x:Name="HubBannerText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- addon cards -->
      <lodge:LodgeView x:Name="LodgePage" Grid.Row="3" Grid.Column="1" Visibility="Collapsed" />
      <local:SettingsPage x:Name="SettingsPage" Grid.Row="3" Grid.Column="1" Visibility="Collapsed" />
      <local:InventoryPage x:Name="InventoryView" Grid.Row="3" Grid.Column="1" Visibility="Collapsed" />
      <ScrollViewer x:Name="AddonsPage" Grid.Row="3" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
       <StackPanel>
        <!-- one-click "check everything", right above the cards (same column as the cards) -->
        <Grid MaxWidth="660" Margin="0,6,0,6">
          <StackPanel x:Name="RefreshBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
            <Border x:Name="HealthChip" CornerRadius="10" Padding="9,2,9,3" Margin="0,0,10,0" Cursor="Hand" VerticalAlignment="Center" Background="Transparent"
                    BorderThickness="1" BorderBrush="{StaticResource Line}" MouseLeftButtonUp="HealthChip_Click" ToolTipService.InitialShowDelay="300" AutomationProperties.Name="Addon health">
              <TextBlock x:Name="HealthChipText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
            </Border>
            <TextBlock x:Name="CheckResult" FontSize="11.5" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel x:Name="CheckChip" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Background="Transparent">
              <TextBlock Text="&#xE121;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,1,3,0" />
              <TextBlock x:Name="CheckChipText" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CheckAllButton" Style="{StaticResource SecondaryButton}" Height="28" Width="30" Padding="0" Click="CheckAll_Click"
                    AutomationProperties.Name="Check for updates" ToolTip="Check for updates">
              <TextBlock x:Name="CheckSpin" Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform><RotateTransform x:Name="SpinRot" /></TextBlock.RenderTransform>
              </TextBlock>
            </Button>
          </StackPanel>
        </Grid>
        <ItemsControl x:Name="Cards" Margin="0,0,0,0" MaxWidth="660">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="16,0,12,10" Background="{StaticResource Card}" CornerRadius="12"
                      BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                  <!-- big artwork on the left, spanning the title and the stats -->
                  <Grid Margin="12,12,14,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="84" Height="84" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,14,0" Cursor="Hand"
                            Background="Transparent" Tag="{Binding}" MouseLeftButtonUp="Card_Toggle">
                      <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <!-- header: click anywhere on it to expand / collapse -->
                      <Border x:Name="Header" Background="Transparent" Padding="0,0,0,4" Cursor="Hand"
                              Tag="{Binding}" MouseLeftButtonUp="Card_Toggle" ToolTip="Show / hide details">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Chevron}" FontFamily="{StaticResource Icons}" FontSize="12"
                                     Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,2,0" />
                          <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource StatusPill}" Click="Action_Click" />
                          <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent"
                                  ToolTip="{x:Static local:Brand.SourceTip}" AutomationProperties.Name="{x:Static local:Brand.SourceTip}">
                            <Image Source="{Binding ChipArt}" Width="19" Height="19" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                          </Border>
                          <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallPath}" ToolTipService.InitialShowDelay="300" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                      <!-- versions + stats on the left, compact action on the right -->
                      <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding VersionLine}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                          <ItemsControl ItemsSource="{Binding Stats}" Visibility="{Binding StatsVisibility}" Margin="0,3,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Background="Transparent" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                                  <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,1,4,0" />
                                  <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <ProgressBar Style="{StaticResource ThinProgress}" Margin="14,0,14,10" Maximum="1"
                               Value="{Binding Progress}" Visibility="{Binding BusyVisibility}" />
                  <TextBlock Text="{Binding Message}" Visibility="{Binding MessageVisibility}" FontSize="12"
                             Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="110,-2,14,12" />

                  <!-- details -->
                  <StackPanel Visibility="{Binding ExpandedVisibility}" Margin="14,0,14,14">
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,12" />
                    <StackPanel Visibility="{Binding DevNoteVisibility}" Margin="0,0,0,12">
                      <TextBlock Text="{Binding DevNote}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                      <Button Style="{StaticResource GhostButton}" Content="Replace the git copy with the release..." FontSize="11.5"
                              HorizontalAlignment="Left" Margin="-8,4,0,0" Visibility="{Binding ReplaceDevVisibility}" Tag="{Binding}" Click="ReplaceDev_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding ChangesTitle}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Changes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="54" />
                              <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="-8,6,0,0">
                      <Button Style="{StaticResource GhostButton}" Content="All releases on GitHub" FontSize="11.5" HorizontalAlignment="Left"
                              Tag="{Binding ReleasesUrl}" Click="OpenLink_Click" />
                      <Button Style="{StaticResource GhostButton}" Content="{Binding RollbackText}" FontSize="11.5" Margin="6,0,0,0"
                              Visibility="{Binding RollbackVisibility}" Tag="{Binding}" Click="OurRollback_Click"
                              ToolTip="Put the version you had before back (the Outpost keeps the last 2). Your settings are not touched." />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- everything else in Interface\AddOns -->
        <StackPanel x:Name="OtherPanel" MaxWidth="660" Margin="0,10,0,0" Visibility="Collapsed">
          <DockPanel Margin="18,4,12,10" LastChildFill="False">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Style="{StaticResource Input}" Width="170" Tag="Search addons" TextChanged="Search_Changed" Margin="8,0,0,0" />
            <Button x:Name="UpdateAllButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,0" FontSize="12"
                    Content="Update all" Visibility="Collapsed" Click="UpdateAll_Click" Margin="8,0,0,0" AutomationProperties.Name="Update all addons" />
            <Button x:Name="LinkExactButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" FontSize="12"
                    Content="Link exact" Visibility="Collapsed" Click="LinkExact_Click" Margin="8,0,0,0" ToolTip="Link every addon whose folders match a WoWInterface file exactly" />
            <Button x:Name="CfOpenButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="28" Width="30" Padding="0" Margin="6,0,0,0"
                    Visibility="Collapsed" Click="OpenCf_Click" ToolTip="Open CurseForge" AutomationProperties.Name="Open CurseForge">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="13" />
            </Button>
            <Button x:Name="CfCheckButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="28" Width="30" Padding="0" Margin="6,0,0,0"
                    Visibility="Collapsed" Click="CheckCf_Click" AutomationProperties.Name="Check CurseForge now"
                    ToolTip="Check CurseForge now: lets the CurseForge app refresh its update info (started minimized if it isn't running, closed again afterwards)">
              <TextBlock x:Name="CfSpin" Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform><RotateTransform x:Name="CfSpinRot" /></TextBlock.RenderTransform>
              </TextBlock>
            </Button>
            <Border x:Name="CfChip" DockPanel.Dock="Right" Visibility="Collapsed" Background="Transparent" Padding="4,3" VerticalAlignment="Center" Margin="8,0,0,0"
                    ToolTipService.ShowDuration="30000">
              <StackPanel Orientation="Horizontal">
                <Image x:Name="CfChipIcon" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0" />
                <TextBlock x:Name="CfChipGlyph" Text="&#xE121;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,1,3,0" />
                <TextBlock x:Name="CfChipText" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="OtherTitle" Text="Other addons" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border x:Name="OtherInfo" Width="18" Height="18" CornerRadius="9" Margin="7,0,0,0" VerticalAlignment="Center" Background="Transparent" ToolTipService.ShowDuration="30000">
              <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </DockPanel>
          <ItemsControl x:Name="OtherCards" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="16,0,12,10" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <StackPanel>
                    <Border Background="Transparent" Padding="14,10,12,4" Cursor="Hand" CornerRadius="12,12,0,0"
                            Tag="{Binding}" MouseLeftButtonUp="OtherCard_Toggle" ToolTip="Show / hide details">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Chevron}" FontFamily="{StaticResource Icons}" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,2,0" />
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource StatusPill}" Visibility="{Binding PillVisibility}" Click="OtherAction_Click" Margin="6,0,0,0" />
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="2,3" Margin="0,0,6,0" Background="Transparent"
                                ToolTip="{Binding SourceTip}" AutomationProperties.Name="{Binding SourceTip}">
                          <Grid>
                            <Image Source="{Binding SourceImage}" Width="19" Height="19" Visibility="{Binding SourceImageVis}"
                                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                            <Path Data="{Binding SourceGeometry}" Fill="{Binding SourceGlyphBrush}" Width="18" Height="18" Stretch="Uniform"
                                  Visibility="{Binding SourceGeoVis}" SnapsToDevicePixels="False" />
                            <TextBlock Text="{Binding SourceChip}" Foreground="{Binding SourceFg}" FontSize="11.5" FontWeight="SemiBold" Margin="2,0" Visibility="{Binding SourceChipVis}" />
                          </Grid>
                        </Border>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource SurfaceHi}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubtitleTip}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding VersionLine}" Visibility="{Binding VersionVisibility}" FontSize="12" Margin="54,0,14,10" ToolTip="{Binding VersionLine}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{StaticResource ThinProgress}" Margin="12,0,12,8" Maximum="1" Value="{Binding Progress}" Visibility="{Binding BusyVisibility}" />
                    <StackPanel Visibility="{Binding SuggestVisibility}" Margin="52,-2,12,10">
                      <TextBlock Text="{Binding SuggestText}" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SuggestHint}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,1,0,4" />
                      <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Use this" Height="26" Padding="12,0" FontSize="11.5" Tag="{Binding}" Click="UseSuggestion_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Not this" FontSize="11.5" Tag="{Binding}" Click="RejectSuggestion_Click" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Visibility="{Binding MessageVisibility}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="52,-2,12,10" />

                    <StackPanel Visibility="{Binding ExpandedVisibility}" Margin="12,0,12,12">
                      <Border Height="1" Background="{StaticResource Line}" Margin="0,2,0,10" />
                      <TextBlock Text="{Binding VersionLine}" FontSize="12" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Notes}" Visibility="{Binding NotesVisibility}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding FolderList}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding DevNote}" Visibility="{Binding DevVisibility}" FontSize="12" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding LinkedTo}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,6" />
                      <StackPanel Visibility="{Binding ChoiceVisibility}" Margin="0,2,0,8">
                        <TextBlock Text="No download is marked for WoW Forever. Pick one by hand - Classic / Era builds were made for another client and may not work." FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource Dropdown}" ItemsSource="{Binding Choices}" Tag="{Binding}" SelectionChanged="Choice_Changed" />
                      </StackPanel>
                      <WrapPanel Margin="-8,0,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Open folder" FontSize="11.5" Tag="{Binding}" Click="OpenAddonFolder_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="{Binding WebsiteText}" FontSize="11.5" Visibility="{Binding WebsiteVisibility}" Tag="{Binding WebsiteUrl}" Click="OpenLink_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Open on CurseForge" FontSize="11.5" Visibility="{Binding CurseVisibility}" Tag="{Binding CurseUrl}" Click="OpenLink_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Open in CurseForge" FontSize="11.5" Visibility="{Binding CfVisibility}" Click="OpenCf_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Open on Wago" FontSize="11.5" Visibility="{Binding WagoVisibility}" Tag="{Binding WagoUrl}" Click="OpenLink_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Roll back" FontSize="11.5" Visibility="{Binding RollbackVisibility}" Tag="{Binding}" Click="Rollback_Click" ToolTip="Put the previous version back (the hub keeps the last 2)" />
                        <Button Style="{StaticResource GhostButton}" Content="Unlink source" FontSize="11.5" Visibility="{Binding UnlinkVisibility}" Tag="{Binding}" Click="Unlink_Click" />
                      </WrapPanel>
                      <DockPanel Visibility="{Binding LinkVisibility}" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Link" Height="30" Padding="14,0" FontSize="12" Margin="8,0,0,0" Tag="{Binding}" Click="LinkSource_Click" />
                        <TextBox Style="{StaticResource Input}" Tag="Paste a GitHub or WoWInterface link" FontSize="12"
                                 Text="{Binding LinkInput, UpdateSourceTrigger=PropertyChanged}" />
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
       </StackPanel>
      </ScrollViewer>

      <!-- first-run guide (code-built, see WelcomeGuide.cs) -->
      <Border x:Name="GuideHost" Grid.RowSpan="4" Grid.ColumnSpan="2" Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
