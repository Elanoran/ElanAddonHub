<UserControl x:Class="ElansAddonHub.AtlasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub">
  <UserControl.Resources>
    <!-- one row of every Atlas table (DESIGN 8, list row): 36 px tile (the item's icon, or its first letter in the quality colour, or the kind's glyph), title (the row's one semibold),
         a Secondary detail line, a Caption extra line, and on the right a figure and the source label as a quiet chip. Rows without a link are not hit-testable (no hover veil). -->
    <DataTemplate x:Key="AtlasRowTemplate">
      <ContentControl x:Name="row" Style="{StaticResource Side.Row}" Padding="8,4" MinHeight="48" Tag="{Binding Link}" MouseLeftButtonUp="Row_Click" Focusable="False">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface2}" Margin="0,0,12,0" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              <TextBlock x:Name="initial" Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding TileBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border CornerRadius="{StaticResource Radius.Control}" ClipToBounds="True">
                <Image x:Name="pic" Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.RowTitle}" Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="detail" Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="extra" Text="{Binding Extra}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
            <TextBlock x:Name="right" Text="{Binding Right}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
            <Border x:Name="chip" Style="{StaticResource Chip}" Padding="8,0" MinHeight="20" HorizontalAlignment="Right" Margin="0,2,0,0">
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </Grid>
      </ContentControl>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Clickable}" Value="False">
          <Setter TargetName="row" Property="IsHitTestVisible" Value="False" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowGlyph}" Value="True">
          <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
          <Setter TargetName="initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Detail}" Value="">
          <Setter TargetName="detail" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Extra}" Value="">
          <Setter TargetName="extra" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Right}" Value="">
          <Setter TargetName="right" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Label}" Value="">
          <Setter TargetName="chip" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a long table: virtualised list, plain items (no selection look) -->
    <Style x:Key="AtlasList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ItemTemplate" Value="{StaticResource AtlasRowTemplate}" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- page panel (DESIGN 4): the page sits on a scrim, not on the hero art -->
  <Border Background="{StaticResource Brush.Scrim}" CornerRadius="{StaticResource Radius.Card}" Margin="16,4,12,12" Padding="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- header: back / forward / start, the title of the page, the one search box -->
      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="16" Content="&#xE72B;" ToolTip="Back  (Alt+Left)" Click="Back_Click" AutomationProperties.Name="Back" />
          <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="16" Content="&#xE72A;" ToolTip="Forward  (Alt+Right)" Click="Forward_Click" AutomationProperties.Name="Forward" />
          <Button x:Name="HomeButton" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="16" Content="&#xE80F;" ToolTip="Atlas start page" Click="Home_Click" AutomationProperties.Name="Atlas start page" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="Atlas" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SubText" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource Input}" Width="260" Margin="12,0,0,0" VerticalAlignment="Center"
                 Tag="Search items, NPCs, zones, quests" AutomationProperties.Name="Search Atlas" TextChanged="Search_Changed" PreviewKeyDown="Search_KeyDown" GotKeyboardFocus="Search_Focus" />
      </Grid>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" local:Motion.EdgeFade="True" Padding="0,0,8,0">
          <StackPanel x:Name="Body" />
        </ScrollViewer>

        <!-- search results: an overlay under the search box (Surface3, hairline, elevation 2, radius 12); the 24 px margin holds the shadow -->
        <Border x:Name="ResultsPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="420" MaxHeight="440" Margin="0,-36,-24,0" Padding="0">
          <Border Margin="24" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
                  Effect="{StaticResource Elevation.2}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
              <StackPanel x:Name="ResultsStack" />
            </ScrollViewer>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
