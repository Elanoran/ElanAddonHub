<UserControl x:Class="ElansAddonHub.AtlasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElansAddonHub">
  <UserControl.Resources>
    <!-- one row of every Atlas table (DESIGN 8, list row): 36 px tile (the item's icon, or its first letter in the quality colour, or the kind's glyph), title (the row's one semibold),
         a Secondary detail line, a Caption extra line, and on the right a figure and the source label as a quiet chip. Rows without a link are not hit-testable (no hover veil). -->
    <DataTemplate x:Key="AtlasRowTemplate">
      <ContentControl x:Name="row" Style="{StaticResource Side.Row}" Padding="8,4" MinHeight="48" Tag="{Binding Link}" MouseLeftButtonUp="Row_Click" Focusable="False">
        <ContentControl.ToolTip><ToolTip Style="{StaticResource GameTip}" Opened="RowTip_Opened" /></ContentControl.ToolTip>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface2}" Margin="0,0,12,0" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{StaticResource Brush.Text.Tertiary}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              <TextBlock x:Name="initial" Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding TileBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border CornerRadius="{StaticResource Radius.Control}" ClipToBounds="True">
                <Image x:Name="pic" Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.RowTitle}" Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="detail" Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="extra" Text="{Binding Extra}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
            <TextBlock x:Name="right" Text="{Binding Right}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
            <Border x:Name="chip" Style="{StaticResource Chip}" Padding="8,0" MinHeight="20" HorizontalAlignment="Right" Margin="0,2,0,0">
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </Grid>
      </ContentControl>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Clickable}" Value="False">
          <Setter TargetName="row" Property="IsHitTestVisible" Value="False" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowGlyph}" Value="True">
          <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
          <Setter TargetName="initial" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Detail}" Value="">
          <Setter TargetName="detail" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Extra}" Value="">
          <Setter TargetName="extra" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Right}" Value="">
          <Setter TargetName="right" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Label}" Value="">
          <Setter TargetName="chip" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a long table: virtualised list, plain items (no selection look) -->
    <Style x:Key="AtlasList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ItemTemplate" Value="{StaticResource AtlasRowTemplate}" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- page panel (DESIGN 4): the page sits on a scrim, not on the hero art. Inside: the sub-navigation (216 px, icons only at 56 px when the window is narrow), a hairline, and the page
       (header with breadcrumb + body). The Ctrl+K palette is a layer over the whole panel. -->
  <Border Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Card}" Margin="16,4,12,12" Padding="16">
    <Grid x:Name="Shell">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavCol" Width="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- sub-navigation: Home, the groups of the registry, Pinned, Recent (built in AtlasPage.Nav.cs), on the faint menu fill (Brush.Section.Panel) that sets it
           apart from the page; each group carries its section colour (DESIGN 4, "Section colours") -->
      <Border x:Name="NavBackdrop" Grid.Column="0" Margin="-8,-8,-4,-8" Background="{StaticResource Brush.Section.Panel}" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
      <Grid x:Name="NavPanel" Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="NavScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel x:Name="NavStack" Margin="0,0,4,0" />
        </ScrollViewer>
        <StackPanel x:Name="NavFooter" Grid.Row="1" Margin="0,8,4,0" />
      </Grid>
      <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource Brush.Divider}" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header: back / forward / start, the breadcrumb (every crumb but the last is a link), the page's link (a quiet chip with Copy) and Pin. There is no title row under it: the page names itself
             (an entity page in its hero; a list, Home and Data sources in the last crumb). Search is the box in the window's title bar (Ctrl+K, MainWindow). -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="16" Content="&#xE72B;" ToolTip="Back  (Alt+Left)" Click="Back_Click" AutomationProperties.Name="Back" />
            <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="16" Content="&#xE72A;" ToolTip="Forward  (Alt+Right)" Click="Forward_Click" AutomationProperties.Name="Forward" />
            <Button x:Name="HomeButton" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="16" Content="&#xE80F;" ToolTip="Atlas start page" Click="Home_Click" AutomationProperties.Name="Atlas start page" />
          </StackPanel>
          <ContentControl x:Name="CrumbHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
          <!-- the Atlas link of the page (item:2589, item:2589?tab=sources, browse:items/weapons, talents:tree/hunter) as a quiet chip with a copy button; hidden on the start page -->
          <StackPanel x:Name="LinkRow" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
            <Border x:Name="LinkChip" Style="{StaticResource Chip}" Padding="8,0" MinHeight="20" VerticalAlignment="Center">
              <TextBlock x:Name="LinkText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
            </Border>
            <Button x:Name="CopyLinkButton" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" Content="&#xE8C8;" Margin="4,0,0,0" Click="CopyLink_Click" AutomationProperties.Name="Copy link" />
            <TextBlock x:Name="CopiedText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Success}" Text="Link copied" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
          <Button x:Name="PinButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="16" Content="&#xE718;" Margin="8,0,0,0" ToolTip="Pin this page" Click="Pin_Click" AutomationProperties.Name="Pin page" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="1">
          <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" local:Motion.EdgeFade="True" Padding="0,0,8,0">
            <StackPanel x:Name="Body" />
          </ScrollViewer>

          <!-- a hosted category (Talents, Professions, the world map): another page with its own scrolling; the page above scrolls only for the other pages -->
          <Grid x:Name="HostSlot" Visibility="Collapsed">
            <ContentControl x:Name="HostContent" Focusable="False" IsTabStop="False" />
          </Grid>

          <!-- new game data arrived while this page showed the older data: a calm offer to show it (AtlasPage.Updates.cs); it floats, so nothing below moves -->
          <local:DataUpdateNotice x:Name="UpdateNotice" />
        </Grid>
      </Grid>

      <!-- the Ctrl+K palette: dims the whole panel; a card with the search box, scope chips, results and a preview (AtlasPage.Palette.cs) -->
      <Grid x:Name="PaletteLayer" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="-16" Panel.ZIndex="20">
        <Border x:Name="PaletteDim" Background="{StaticResource Brush.Scrim.Strong}" Opacity="0.7" CornerRadius="{StaticResource Radius.Card}" MouseLeftButtonDown="PaletteDim_Down" />
        <Border x:Name="PaletteCard" MaxWidth="760" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="24,48,24,24" Background="{StaticResource Brush.Surface3}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
                CornerRadius="14" Effect="{StaticResource Elevation.2}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="PaletteBox" Style="{StaticResource Input}" Height="48" FontSize="15" Margin="16,16,16,0" Tag="Search items, creatures, zones, quests, or paste a link"
                     AutomationProperties.Name="Search the Atlas" TextChanged="PaletteBox_Changed" PreviewKeyDown="PaletteBox_KeyDown" />
            <Border Grid.Row="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="16,12,16,0">
              <StackPanel x:Name="PaletteScopes" Orientation="Horizontal" />
            </Border>
            <Grid x:Name="PaletteBody" Grid.Row="2" Height="360" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PalettePreviewCol" Width="300" />
              </Grid.ColumnDefinitions>
              <ScrollViewer x:Name="PaletteScroll" VerticalScrollBarVisibility="Auto" Padding="8,0,8,0" Focusable="False">
                <StackPanel x:Name="PaletteStack" />
              </ScrollViewer>
              <Border x:Name="PalettePreviewHost" Grid.Column="1" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1,0,0,0" Padding="16,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel x:Name="PalettePreview" /></ScrollViewer>
              </Border>
            </Grid>
            <TextBlock x:Name="PaletteHint" Grid.Row="3" Style="{StaticResource Text.Caption}" Margin="16,8,16,12" Text="Up and Down to move  ·  Enter to open  ·  Tab for the next kind  ·  Esc to close" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
