<Project Sdk="Microsoft.NET.Sdk">

  <!-- 3.1.0: .NET 10 (was .NET Framework 4.8, last one tagged outpost-net48-last). One framework-dependent single-file exe:
       it needs the .NET 10 Desktop Runtime once per PC (winget install Microsoft.DotNet.DesktopRuntime.10). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ElansAddonHub</AssemblyName>
    <RootNamespace>ElansAddonHub</RootNamespace>
    <ApplicationIcon>Assets\hub.ico</ApplicationIcon>
    <Version>3.3.1</Version>
    <!-- 64-bit: the world map builders need more than the 32-bit address space (WebView2Loader is picked per architecture) -->
    <Product>Elan's Outpost</Product>
    <Company>Elan</Company>
    <Description>Installs and updates Elan's WoW addons</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- 3.1.1: no .pdb of a referenced project (Elans.Shared) next to the exe: release.py takes the publish folder only with the one exe in it -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- 3.1.1: Tools/updatetest.ps1 only (dotnet publish -p:ElansUpdateTest=true): the build also trusts the key that script makes for its run
       (ReleaseSignature). release.py never sets it, so a shipped Outpost trusts only the two release keys. -->
  <PropertyGroup Condition="'$(ElansUpdateTest)' == 'true'">
    <DefineConstants>$(DefineConstants);ELANS_UPDATETEST</DefineConstants>
  </PropertyGroup>

  <!-- 3.2: Tools/devoutpost.ps1 only (dotnet build -p:ElansDevPipe=true): the developer's pipe for Tools/OutpostDevMcp (Services/DevPipe.cs). Such a build
       never updates itself and does not register elanshub:// links; release.py and the self-test never set it, and the self-test checks the type is absent. -->
  <PropertyGroup Condition="'$(ElansDevPipe)' == 'true'">
    <DefineConstants>$(DefineConstants);ELANS_DEVPIPE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\hub.ico" />
    <Resource Include="Assets\hub.png" />
    <Resource Include="Assets\logo-ehh.png" />
    <Resource Include="Assets\logo-hubaddon.png" />
    <Resource Include="Assets\logo-paladin.png" Condition="Exists('Assets\logo-paladin.png')" />
    <!-- painted art (ArtLibrary.cs): zone banners, category browse banners, talent spec backgrounds -->
    <Resource Include="Assets\Art\*.jpg" />
  </ItemGroup>

  <!-- the world map page (Atlas): Leaflet 1.9.4 (BSD-2-Clause) and three.js r149 (MIT), both with their licence files, and the 2D and 3D pages ride inside the exe; they are written to the data folder (atlas/worldmap/_page) and served from a private virtual host, never from the internet -->
  <ItemGroup>
    <EmbeddedResource Include="WorldMap\index.html" LogicalName="WorldMap.index.html" />
    <EmbeddedResource Include="WorldMap\icons.js" LogicalName="WorldMap.icons.js" />
    <EmbeddedResource Include="WorldMap\panel.js" LogicalName="WorldMap.panel.js" />
    <EmbeddedResource Include="WorldMap\trailprints.js" LogicalName="WorldMap.trailprints.js" />
    <EmbeddedResource Include="WorldMap\worldmap.js" LogicalName="WorldMap.worldmap.js" />
    <EmbeddedResource Include="WorldMap\worldmap.css" LogicalName="WorldMap.worldmap.css" />
    <EmbeddedResource Include="WorldMap\leaflet.js" LogicalName="WorldMap.leaflet.js" />
    <EmbeddedResource Include="WorldMap\leaflet.css" LogicalName="WorldMap.leaflet.css" />
    <EmbeddedResource Include="WorldMap\LICENSE-leaflet.txt" LogicalName="WorldMap.LICENSE-leaflet.txt" />
    <EmbeddedResource Include="WorldMap\view3d.html" LogicalName="WorldMap.view3d.html" />
    <EmbeddedResource Include="WorldMap\view3d.js" LogicalName="WorldMap.view3d.js" />
    <EmbeddedResource Include="WorldMap\three.min.js" LogicalName="WorldMap.three.min.js" />
    <EmbeddedResource Include="WorldMap\LICENSE-three.txt" LogicalName="WorldMap.LICENSE-three.txt" />
  </ItemGroup>

  <!-- the public version history for Settings > About > What's new (Changelog.cs): the same CHANGELOG.md release.py reads for the release notes, and the companion addon's -->
  <ItemGroup>
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="Changelog.outpost.md" />
    <EmbeddedResource Include="..\addon\ElansHub\CHANGELOG.txt" LogicalName="Changelog.companion.txt" Condition="Exists('..\addon\ElansHub\CHANGELOG.txt')" />
  </ItemGroup>

  <!-- the zone notes of the Atlas zone pages (ZoneLore.cs), written for the Outpost -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Data\zonelore.json" LogicalName="Data.zonelore.json" />
    <EmbeddedResource Include="Assets\Data\classlore.json" LogicalName="Data.classlore.json" />
    <EmbeddedResource Include="Assets\Data\talentbuilds.lua" LogicalName="Data.talentbuilds.lua" />
  </ItemGroup>

  <!-- voice: NAudio (mic/speakers) + Concentus (Opus codec, pure C#); single-file publish packs them into the exe -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <!-- 3.1.1: the signed formats (ES256, base64url, Cairn dataset / notice messages, release signature) - one definition with the Lodge and the Cairn; bundled into the single-file exe -->
  <ItemGroup>
    <ProjectReference Include="..\shared\Elans.Shared\Elans.Shared.csproj" />
  </ItemGroup>

  <!-- WebView2Loader.dll rides inside the exe (single-file): extracted to &lt;data&gt;/webview2/loader/&lt;arch&gt; on first use, see VideoViewer.ExtractLoader -->
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4258.31/runtimes/win-x64/native/WebView2Loader.dll" LogicalName="WebView2Loader.x64.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4258.31/runtimes/win-x86/native/WebView2Loader.dll" LogicalName="WebView2Loader.x86.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4258.31/runtimes/win-arm64/native/WebView2Loader.dll" LogicalName="WebView2Loader.arm64.dll" />
  </ItemGroup>

</Project>
