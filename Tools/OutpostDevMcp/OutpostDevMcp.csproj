<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outpost dev MCP server (3.2): lets a developer's assistant look at and steer the 3D world map of a running developer's Outpost
       (built with Tools/devoutpost.ps1). Talks MCP (JSON-RPC over stdin / stdout) and forwards each tool call to the Outpost's
       dev pipe (src/Services/DevPipe.cs). Not part of the Outpost build and never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>OutpostDevMcp</RootNamespace>
  </PropertyGroup>

</Project>
