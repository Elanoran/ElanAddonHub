# /etc/lodge/lodge.env - read by lodge.service
# Invite codes: one personal code per friend in /etc/lodge/codes, managed with
#   sudo lodge-admin add <name>   (the code is tied to that name; remove it to kick them)
# Optional shared code without a fixed name (guests can't take a friend's name). Empty = off.
LODGE_CODE=
# Only listen locally; the web server forwards /lodge to it
LODGE_URLS=http://127.0.0.1:5280
LODGE_DATA=/var/lib/lodge
# URL prefix: /lodge when served as https://yoursite/lodge, empty for a subdomain like https://lodge.yoursite
LODGE_PATHBASE=/lodge
LODGE_MAX_FILE_MB=25
LODGE_FILE_DAYS=30
LODGE_MAX_USERS=25
# Proxy running in Docker? Trust its network so the real visitor IP is used (localhost is always trusted)
#LODGE_TRUSTED_PROXIES=172.16.0.0/12

# ---- limits (defaults shown; the service clamps silly values)
# all uploads together / number of files kept / uploads running at once / uploads per person per 10 minutes
#LODGE_MAX_STORAGE_MB=2048
#LODGE_MAX_FILES=2000
#LODGE_MAX_CONCURRENT_UPLOADS=4
#LODGE_UPLOADS_PER_10MIN=30
# chat history per channel: how many messages are kept (2.9: default 2000, was 200) and how big the file may get (loading reads at most this much;
# when it is over, the oldest messages go until it is back under three quarters of it)
#LODGE_HISTORY_MAX=2000
#LODGE_HISTORY_MAX_KB=4096
# wrong-code bookkeeping: IPs tracked at once (beyond it, unknown IPs share one limit)
#LODGE_MAX_TRACKED_IPS=10000
# all HTTP requests per IP per minute (separate from the wrong-code lockout)
#LODGE_HTTP_PER_MINUTE=240
# legacy ?code= in URLs (hub 1.x). OFF by default since 2.8: such requests get 401 "use the header" (codes in URLs end up
# in proxy logs and browser history). Set to true only if somebody still runs hub 1.x.
#LODGE_ALLOW_QUERY_CODE=false
# uploads one person (guests: one address) may run at once, and how long one upload may take (seconds)
#LODGE_UPLOADS_PER_USER=2
#LODGE_UPLOAD_TIMEOUT_S=120
# a hub 2.8+ client pings every 20 s; silence for this long (seconds) closes the connection (the client reconnects)
#LODGE_IDLE_TIMEOUT_S=75
# edits, deletes and reactions are written to the history file after this many quiet seconds (and at shutdown)
#LODGE_HISTORY_FLUSH_S=5

# ---- backups (lodge-backup, daily via lodge-backup.timer; archives in /var/backups/lodge, root:root 0600 - they contain the invite codes)
# include the uploaded files/ folder (1 = yes, 0 = chat history, codes, profiles and pins only)
#LODGE_BACKUP_FILES=1
# how many archives to keep
#LODGE_BACKUP_KEEP=14
