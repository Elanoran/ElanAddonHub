# /etc/lodge/lodge.env - read by lodge.service
# Starting: the installer prints a one-time OWNER LINK (or: sudo lodge-admin claim-owner). Then invite people from the Outpost
# (Lodge sidebar, Invite) or with: sudo lodge-admin invite <name>
# Legacy: permanent codes in /var/lib/lodge/codes, `sudo lodge-admin add <name>` (still works, no longer recommended)
# One-time invite links (2.10): `sudo lodge-admin invite <name>` prints a link that works once and trades itself for a
# per-device token. To make lodge-admin print links with your address, set the public URL of the lodge (https://site/lodge):
#LODGE_PUBLIC_URL=https://example.org/lodge
# how long an invite lives unless the creator picks another time (hours, 1-720 = 30 days; default 168 = 7 days)
#LODGE_INVITE_HOURS=168
#LODGE_MAX_PENDING_INVITES=200
# device tokens per person (a new device beyond this must wait until one is signed out)
#LODGE_MAX_DEVICES_PER_PERSON=10
# Optional shared code without a fixed name (guests can't take a friend's name). Empty = off.
LODGE_CODE=
# Only listen locally; the web server forwards /lodge to it
LODGE_URLS=http://127.0.0.1:5280
LODGE_DATA=/var/lib/lodge
# URL prefix: /lodge when served as https://yoursite/lodge, empty for a subdomain like https://lodge.yoursite
LODGE_PATHBASE=/lodge
LODGE_MAX_FILE_MB=25
LODGE_FILE_DAYS=30
LODGE_MAX_USERS=25
# Proxy running in Docker? Trust its network so the real visitor IP is used (localhost is always trusted)
#LODGE_TRUSTED_PROXIES=172.16.0.0/12

# ---- limits (defaults shown; the service clamps silly values)
# all uploads together / number of files kept / uploads running at once / uploads per person per 10 minutes
#LODGE_MAX_STORAGE_MB=2048
#LODGE_MAX_FILES=2000
#LODGE_MAX_CONCURRENT_UPLOADS=4
#LODGE_UPLOADS_PER_10MIN=30
# chat history per channel: how many messages are kept (2.9: default 2000, was 200) and how big the file may get (loading reads at most this much;
# when it is over, the oldest messages go until it is back under three quarters of it)
#LODGE_HISTORY_MAX=2000
#LODGE_HISTORY_MAX_KB=4096
# wrong-code bookkeeping: IPs tracked at once (beyond it, unknown IPs share one limit)
#LODGE_MAX_TRACKED_IPS=10000
# all HTTP requests per IP per minute (separate from the wrong-code lockout)
#LODGE_HTTP_PER_MINUTE=240
# legacy ?code= in URLs (hub 1.x). OFF by default since 2.8: such requests get 401 "use the header" (codes in URLs end up
# in proxy logs and browser history). Set to true only if somebody still runs hub 1.x.
#LODGE_ALLOW_QUERY_CODE=false
# uploads one person (guests: one address) may run at once, and how long one upload may take (seconds)
#LODGE_UPLOADS_PER_USER=2
#LODGE_UPLOAD_TIMEOUT_S=120
# a hub 2.8+ client pings every 20 s; silence for this long (seconds) closes the connection (the client reconnects)
#LODGE_IDLE_TIMEOUT_S=75
# edits, deletes and reactions are written to the history file after this many quiet seconds (and at shutdown)
#LODGE_HISTORY_FLUSH_S=5

# ---- backups (lodge-backup, daily via lodge-backup.timer; archives in /var/backups/lodge, root:root 0600 - they contain the invite codes)
# include the uploaded files/ folder (1 = yes, 0 = chat history, codes, profiles and pins only)
#LODGE_BACKUP_FILES=1
# how many archives to keep
#LODGE_BACKUP_KEEP=14

# ---- shared files (server 2.14, "Files" page in the Outpost): named slots, the newest 3 versions of each kept on disk (data/slots/)
# Only officers and the owner upload / replace / roll back / delete; everybody (guests too) can save. Needs `sudo lodge-update` to arrive.
# 1 = on, 0 = off (the feature is then not advertised: the Outpost hides the Files page; existing files stay on disk)
#LODGE_FILES_ENABLED=1
# largest single file (MB) and the total for all kept versions of all slots together (MB)
#LODGE_FILES_MAX_MB=50
#LODGE_FILES_TOTAL_MB=500
# uploads per person per 10 minutes
#LODGE_FILES_UPLOADS_PER_10MIN=20

# ---- Atlas pool (server 2.15, "atlas" feature): members share what Elan's Toolkit observed (loot per mob, vendors, finds, ...); everybody gets the lodge's totals
# Stored in data/atlas.json (included in lodge-backup). Needs `sudo lodge-update` to arrive. Guests can read but not share; every member can switch sharing off in the Outpost.
# 1 = on, 0 = off (the feature is then not advertised: the Outpost shares and shows nothing from this lodge; the data stays on disk)
#LODGE_ATLAS_ENABLED=1

# ---- Armory (server 2.16, "armory" feature): members choose characters to share (gear, talents, professions, pets - never bags, bank or gold); everybody in the lodge can browse them
# Stored in data/armory.json (included in lodge-backup). Needs `sudo lodge-update` to arrive. Guests neither share nor browse; a member who leaves takes their characters along.
# 1 = on, 0 = off (the feature is then not advertised; the data stays on disk)
#LODGE_ARMORY_ENABLED=1

# ---- Hosted Classic baseline (server 2.17, "classic" feature): an officer or the owner shares the public cMaNGOS classic-db files with the lodge once; every member's Outpost fetches them from here
# Stored in data/datasets/ (about 15 MB, included in lodge-backup). Needs `sudo lodge-update` to arrive. Guests download from the public source instead. The server never opens the bundle.
# 1 = on, 0 = off (the feature is then not advertised; the stored bundle stays on disk)
#LODGE_CLASSIC_ENABLED=1
# largest bundle accepted (MB) and downloads per member per hour
#LODGE_CLASSIC_MAX_MB=40
#LODGE_CLASSIC_DOWNLOADS_PER_HOUR=6

# ---- Badges and the ladder (feature "badges"): fun milestones for what members share, and a monthly ladder. Worked out from data the lodge already holds; nothing new is collected from the game.
# Stored in data/badges.json (included in lodge-backup). Needs `sudo lodge-update` to arrive. Guests have no badges. Members can hide themselves from the ladder; the Guild Master has a switch in the Outpost too.
# 1 = on, 0 = off (the feature is then not advertised and the Guild Master can't turn it on; the data stays on disk)
#LODGE_BADGES_ENABLED=1
# ---- Realm status (server 2.20, "realms" feature): the lodge asks the Blizzard Game Data API whether the WoW Forever realms are up and tells every connected member (small dots at the top of the Outpost)
# Needs a Battle.net API client (https://develop.battle.net, see deploy/README.md). The feature is advertised ONLY when both the id and the secret are set. The secret stays in this file (keep it 600): it is never logged and never sent to a client.
#LODGE_BNET_CLIENT_ID=
#LODGE_BNET_CLIENT_SECRET=
# eu (default), us, kr or tw
#LODGE_BNET_REGION=eu
# seconds between polls (60 - 900, default 120); one poll for the whole lodge, however many members are connected
#LODGE_REALMS_POLL_SECONDS=120
# optional: replaces the namespaces that are probed (default: dynamic-<region>, dynamic-classic-<region>, dynamic-classic1x-<region>), comma separated
#LODGE_REALMS_NAMESPACES=
