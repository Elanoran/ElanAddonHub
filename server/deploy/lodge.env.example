# /etc/lodge/lodge.env - read by lodge.service
# Invite code friends type into the hub (install.sh generates one)
LODGE_CODE=change-me
# Only listen locally; the web server forwards /lodge to it
LODGE_URLS=http://127.0.0.1:5280
LODGE_DATA=/var/lib/lodge
# URL prefix: /lodge when served as https://yoursite/lodge, empty for a subdomain like https://lodge.yoursite
LODGE_PATHBASE=/lodge
LODGE_MAX_FILE_MB=25
LODGE_FILE_DAYS=30
LODGE_MAX_USERS=25
